[Unit]
Description=The Axiom administration backend
After=network.target

[Service]
Type=simple
User=theaxiom
Group=theaxiom
WorkingDirectory=/opt/theaxiom/app
EnvironmentFile=/etc/theaxiom/server.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/theaxiom/app/.venv/bin/python -m theaxiom.admin_api
StateDirectory=theaxiom
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
