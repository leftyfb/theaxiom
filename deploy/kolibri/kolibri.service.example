[Unit]
Description=Optional native Kolibri offline learning service
After=network.target
RequiresMountsFor=/var/lib/kolibri

[Service]
Type=simple
User=kolibri
Group=kolibri
Environment=KOLIBRI_HOME=/var/lib/kolibri
Environment=DJANGO_SETTINGS_MODULE=axiom_kolibri_settings
Environment=PYTHONPATH=/opt/theaxiom/app/deploy/kolibri
ExecStart=/opt/kolibri/venv/bin/kolibri start --foreground
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
UMask=0022

[Install]
WantedBy=multi-user.target
