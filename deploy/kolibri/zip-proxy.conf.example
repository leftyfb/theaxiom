# Include INSIDE a separate TLS server on the same host, port 8443 (example).
# Never serve packaged content from the Axiom/Kolibri trusted browser origin.
# Configure the same locally trusted certificate as Axiom in that server.
location / {
    proxy_pass http://127.0.0.1:8083;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Authorization "";
    proxy_set_header Cookie "";
    proxy_hide_header Set-Cookie;
    proxy_cache off;
}
