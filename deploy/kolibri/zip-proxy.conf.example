# Include INSIDE a separate TLS server on the same host, port 8443 (example).
# Never serve packaged content from the Axiom/Kolibri trusted browser origin.
# Configure the same locally trusted certificate as Axiom in that server.
location = /_publication_kolibri_alternate {
    internal;
    proxy_pass http://127.0.0.1:8080/internal/publication/kolibri-alternate;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Host $http_host;
    proxy_set_header X-Axiom-Original-URI $request_uri;
    proxy_set_header Authorization "";
    proxy_set_header Cookie "";
    proxy_cache off;
}
location / {
    auth_request /_publication_kolibri_alternate;
    add_header Cache-Control "no-store" always;
    proxy_pass http://127.0.0.1:8083;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Authorization "";
    proxy_set_header Cookie "";
    proxy_hide_header Set-Cookie;
    proxy_cache off;
}
