# Include inside Axiom's HTTP/HTTPS server only after installation is verified.
location = /_publication_kolibri {
    internal;
    proxy_pass http://127.0.0.1:8080/internal/publication/kolibri;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header Host $http_host;
    proxy_set_header X-Axiom-Original-URI $request_uri;
    proxy_set_header Authorization "";
    proxy_set_header Cookie "";
    proxy_cache off;
}
location = /kolibri { return 308 /kolibri/; }
location = /kolibri/axiom-navigation.css {
    alias /opt/theaxiom/app/deploy/kolibri/navigation.css;
    default_type text/css;
}
location ^~ /kolibri/ {
    auth_request /_publication_kolibri;
    add_header Cache-Control "no-store" always;
    add_header X-Content-Type-Options nosniff always;
    proxy_pass http://127.0.0.1:8082;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Authorization "";
    proxy_set_header Cookie "kolibri=$cookie_kolibri; kolibri_csrftoken=$cookie_kolibri_csrftoken";
    proxy_set_header Accept-Encoding "";
    proxy_cache off;
    # Only HTML is rewritten; JS bundles, APIs, captions and byte-range media
    # remain untouched. No hardcoded client host or protocol.
    sub_filter_once on;
    sub_filter '</head>' '<link rel="stylesheet" href="/kolibri/axiom-navigation.css"></head>';
    sub_filter '</body>' '<a class="axiom-library-return" href="/">Back to library</a></body>';
}
