[Unit]
Description=The Axiom metadata-only publisher update checks
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=theaxiom
Group=theaxiom
WorkingDirectory=/opt/theaxiom/app
EnvironmentFile=/etc/theaxiom/server.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/theaxiom/app/.venv/bin/python -m theaxiom.kiwix_update_scheduler
StateDirectory=theaxiom
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
TimeoutStartSec=15min

# Never run an archive downloader or change Kiwix/publication here.
