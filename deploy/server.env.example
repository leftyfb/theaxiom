THEAXIOM_BIND_HOST=127.0.0.1
THEAXIOM_BIND_PORT=8080
THEAXIOM_BEHIND_NGINX=1
# No public host allowlist required: Nginx accepts LAN and Tailscale names/IPs.
THEAXIOM_ADMIN_USER=admin
THEAXIOM_ADMIN_CREDENTIALS_FILE=/var/lib/theaxiom/admin-credential.json
THEAXIOM_STORAGE_SETTINGS=/var/lib/theaxiom/storage.json
