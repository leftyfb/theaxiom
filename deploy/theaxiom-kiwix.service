[Unit]
Description=The Axiom generic multi-book Kiwix reader (published archives only)
Wants=network-online.target remote-fs.target
After=network-online.target remote-fs.target

[Service]
Type=simple
User=theaxiom
Group=theaxiom
WorkingDirectory=/opt/theaxiom/app
EnvironmentFile=/etc/theaxiom/server.env
Environment=PYTHONDONTWRITEBYTECODE=1
RuntimeDirectory=theaxiom-kiwix
RuntimeDirectoryMode=0700
# Clear the previous reader generation BEFORE building a new manifest.
# The nginx auth gate stays closed until OPDS has acknowledged exact book IDs.
ExecStartPre=/usr/bin/rm -f /run/theaxiom-kiwix/manifest.sha256
ExecStartPre=/opt/theaxiom/app/.venv/bin/python -m theaxiom.zim_catalog
ExecStart=/usr/bin/kiwix-serve --address=127.0.0.1 --port=8082 --urlRootLocation=/zim/ --monitorLibrary --library /var/lib/theaxiom/kiwix-library.xml
ExecStartPost=/opt/theaxiom/app/.venv/bin/python -m theaxiom.zim_reader_probe
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/theaxiom /run/theaxiom-kiwix
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
