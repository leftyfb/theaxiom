    <div id="source-cards">
    {% for source in (catalog|default({})).sources|default([]) %}
      {% set pub = source.publication %}
      {% set publication_label = 'Publication status unavailable' if pub.error else 'Published · available in library' if pub.published else ((pub.publication_reason or 'Reader unavailable') if pub.ready_for_publication else 'Enabled · reader unavailable') if pub.enabled else 'Unpublished · ready to publish' if pub.serving else 'Verified · ready to publish' if pub.ready_for_publication else 'Unpublished · ' + pub.publication_reason if pub.publication_reason else 'Unpublished · reader not ready' %}
      <div class="source-row">
      <div class="source-order-controls" hidden>
        <span data-order-grip aria-hidden="true">⠿</span>
        <button type="button" data-order-move="-1" aria-label="Move {{ source.profile.title }} up">↑</button>
        <button type="button" data-order-move="1" aria-label="Move {{ source.profile.title }} down">↓</button>
      </div>
      <label class="group-select" hidden><input type="checkbox" data-group-select value="{{ source.source_id }}" aria-label="Select {{ source.profile.title }} for grouping"></label>
      <details class="source-card" data-source-id="{{ source.source_id }}" data-filter-title="{{ source.profile.title }}" data-filter-format="{{ source.configuration.format }}" data-filter-publication="{{ source.publication_filter|default('unknown') }}" data-filter-download="{{ source.download_filter|default('unknown') }}"{% for name in editable_fields %} data-catalog-{{ name|replace('_', '-') }}="{{ source.profile.get(name, source.configuration.get(name, '')) }}"{% endfor %}>
        <summary class="source-header">
          <span class="source-symbol">{% from 'source-icon.html.j2' import source_icon %}{{ source_icon(source.profile.title, source.profile.get('icon_png', ''), source.source_id) }}</span>
          <div>
            <h3>{{ source.profile.title }}</h3>
            <p class="source-subtitle">{{ source.configuration.format|upper }}{% if source.profile.description %} · {{ source.profile.description }}{% endif %}</p>

            {% if pub %}<span class="compact-publication" data-field="publication-summary">{{ "Published" if pub.published else (pub.publication_reason or "Reader unavailable") if pub.enabled and pub.ready_for_publication else "Reader unavailable" if pub.enabled else "" }}</span>{% endif %}
          </div>
          <span class="badge enabled" data-field="update-status" role="status"{% if not source.update_check or source.update_check.state != "update_available" %} hidden{% endif %}>Update available</span>
          <span class="badge{% if source.installed_verified %} enabled{% endif %}" data-field="status" role="status">{% if not source.adapter %}Not yet supported{% elif source.installed_verified %}{{ source.artifact.bytes | filesizeformat if source.artifact and source.artifact.bytes is number and source.artifact.bytes > 0 else 'Installed · size unavailable' }}{% elif source.adapter in ('pdf','epub') %}{{ 'Not installed or invalid' if source.artifact else 'Not downloaded' }}{% elif source.acquisition and not catalog.acquisition_stale %}{{ {'downloading':'Downloading','verifying':'Verifying','publishing':'Installing','failed':'Failed','retrying':'Retrying','interrupted':'Interrupted','not_started':'Not downloaded','unavailable':'Service unavailable'}.get(source.acquisition.state,'Waiting for status') }}{% elif catalog.acquisition_stale %}Status unavailable{% elif not source.artifact and not source.mutation_blocked %}Not downloaded{% else %}Waiting for status…{% endif %}</span>
          <span class="badge" data-batch-status role="status" hidden></span>
          <progress class="summary-progress" data-field="summary-progress" max="100" value="0" aria-label="Active download progress" hidden></progress>
        </summary>
        <div class="source-expanded">
            {% for kind in ["categories", "collections", "tags"] %}{% set memberships = [] %}{% for group in groups if group.kind == kind and source.source_id in group.source_ids %}{% set _ = memberships.append(group.name) %}{% endfor %}{% if memberships %}<p class="group-membership">{{ kind|capitalize }}: {{ memberships|sort|join(", ") }}</p>{% endif %}{% endfor %}
        <div class="source-live">
          <button class="button" type="button" data-batch-cancel hidden>Cancel queued download</button>
          <p class="source-note" data-batch-feedback role="status" hidden></p>
          <p data-field="metrics" hidden></p>
          <progress data-field="transfer" max="100" value="0" aria-label="Archive download progress" hidden></progress>
          <p data-field="verification-label" hidden>Checksum verification in progress — percentage unavailable.</p>
          <progress data-field="verification" aria-label="Checksum verification in progress" hidden></progress>
          <p class="source-note" data-field="rate" hidden></p>
          <p data-field="detail" class="source-note" hidden></p>
        </div>
        {% set document = source.adapter in ('pdf','epub') %}
        {% set url_managed = source.configuration.source_url|default('', true)|trim %}
        {% set discovery = source.discovery|default({}) %}
        <p class="source-note" data-field="discovery-status">
          {% if discovery %}
            {{ 'Automatic update checks enabled' if discovery.periodic else 'Automatic update checks disabled' }}
          {% endif %}
        </p>
        <p class="source-note" data-field="discovery-evidence" role="status" aria-live="polite"></p>
        {% if source.zim_download %}
        <p class="source-note" data-zim-replacement-status role="status" aria-live="polite"></p>
        {% endif %}
        <div class="source-actions" aria-label="Source actions">
          {# Legacy pinned-action placeholders cannot execute and must not
             masquerade as Download/Re-download/Update controls. #}
          {% if source.zim_download %}
          <button class="button" type="button" data-review-zim-update
                  {% if not source.update_check or source.update_check.state != "update_available" or not source.update_check.candidate_bytes or (source.replacement and source.replacement.state != "activated") %} hidden{% endif %}
                  data-update-sha256="{{ (source.update_check.candidate_sha256 or source.update_check.candidate_sha1 or source.update_check.candidate_md5) if source.update_check else '' }}"
                  data-update-bytes="{{ source.update_check.candidate_bytes if source.update_check else '' }}">
            Download update
          </button>
          {% endif %}
          {% if source.zim_download and discovery.get("method") != "manual" %}<button class="button" type="button" data-zim-update-check{% if not source.installed_verified %} hidden disabled{% endif %}>Check for updates</button>{% endif %}
          {% if document and url_managed and (discovery.get("method") == "head" or not discovery) %}
          <button class="button" type="button" data-document-update-check{% if not source.installed_verified %} hidden disabled{% endif %}>Check for updates</button>
          {% endif %}
