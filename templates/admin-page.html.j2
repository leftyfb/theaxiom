                older_candidate: 'Publisher lists an older edition',
                representation_changed: 'Publisher file changed · newer edition unverified',
                representation_unchanged: 'No change detected',
                unable_to_determine: ['pdf', 'epub'].includes(source?.adapter)
                  ? 'Couldn’t compare with the installed file' : 'Unable to check for updates'
              };
              const hasCheck = update && (update.checked_at || update.stale ||
                update.evidence !== 'no current check evidence');
              if (card.dataset.updateCheckPosting !== 'true') evidence.textContent = hasCheck ? (update.stale ? 'Last update check is stale' :
                update.state === 'update_available' ? '' : description[update.state] || '') :
                (source?.installed_verified && source?.discovery?.method && source.discovery.method !== 'manual' ? 'No update check recorded' : '');
            }
            const technical = card.querySelector('[data-field="update-evidence"]');
            if (technical && card.dataset.updateCheckPosting !== 'true') {
              technical.textContent = update ? [
                update.evidence,
                update.checked_at ? 'Last check ' + new Date(update.checked_at * 1000).toLocaleString() : '',
                update.last_successful_check_at ?
                  'Last successful check ' + new Date(update.last_successful_check_at * 1000).toLocaleString() : '',
                update.last_known_candidate_edition ? 'Last known candidate ' + update.last_known_candidate_edition : '',
                update.candidate_edition ? 'Candidate ' + update.candidate_edition : '',
                update.candidate_sha256 ? 'SHA-256 ' + update.candidate_sha256 : update.candidate_sha1 ? 'SHA-1 ' + update.candidate_sha1 : update.candidate_md5 ? 'MD5 ' + update.candidate_md5 : ''
              ].filter(Boolean).join(' · ') : '';
            }
            const hasUpdate = update?.state === "update_available";
            if (updateBadge) updateBadge.hidden = !hasUpdate;
            if (updateDetails) {
              updateDetails.hidden = !hasUpdate;
              const incoming = update?.candidate_bytes;
              const installed = source?.installed_verified === true ? source.artifact?.bytes : null;
              const estimate = Number.isSafeInteger(incoming) && incoming > 0 ?
                ' · Estimated transfer and staging: ' + size(incoming) +
                ' · Installed and candidate archives together: ' +
                (Number.isSafeInteger(installed) && installed > 0 && Number.isSafeInteger(installed + incoming) ?
                  size(installed + incoming) : 'unknown') : '';
              updateDetails.textContent = hasUpdate
                ? 'Installed edition: ' + (update.installed_edition || 'unknown') +
                  ' · Publisher edition: ' + (update.candidate_edition || 'unknown') +
                  estimate + ' · Candidate: ' + (update.candidate_url || 'unavailable') +
                  ' · The installed edition remains in service until you publish the verified update.'
                : '';
            }
            const review = card.querySelector('[data-review-zim-update]');
            if (review) {
              review.hidden = !hasUpdate || !Number.isSafeInteger(update?.candidate_bytes) ||
                (!!source?.replacement && source.replacement.state !== 'activated');
              if (!review.hidden) {
                review.dataset.updateSha256 = update.candidate_sha256 || update.candidate_sha1 || update.candidate_md5 || '';
                review.dataset.updateBytes = String(update.candidate_bytes);
              }
            }
            controls(card, source);
            if (source) {
              for (const field of editableFields) {
                const attribute = 'data-catalog-' + field.replaceAll('_', '-');
                card.setAttribute(attribute, source.profile?.[field] ?? source.configuration?.[field] ?? '');
              }
              for (const node of card.querySelectorAll('[data-source-config], [data-source-artifact]')) {
                const value = (node.dataset.sourceConfig ? source.configuration?.[node.dataset.sourceConfig] :
                  source.artifact?.[node.dataset.sourceArtifact]) ?? '';
                node.textContent = value;
                const label = node.previousElementSibling;
                label.hidden = node.hidden = value === '';
                if (node.dataset.sourceArtifact) label.textContent = value === '' ? '' : artifactLabels[node.dataset.sourceArtifact];
              }
              for (const node of card.querySelectorAll('[data-source-profile]')) {
                const name = node.dataset.sourceProfile;
                const installedEdition = name === 'edition' && source.installed_edition;
                node.textContent = installedEdition || source.profile?.[name] || '';
                if (name === 'edition') node.previousElementSibling.textContent = installedEdition ? 'Installed edition:' : 'Edition:';
                node.parentElement.hidden = !node.textContent;
              }
            }
            const publication = source?.publication_filter || 'unknown';
            const download = source?.download_filter || 'unknown';
            card.dataset.filterPublication = publication;
            card.dataset.filterDownload = download;
          });
          window.axiomSourceFilters?.setOrder(data.library_order || []);
          window.axiomSourceFilters?.apply(true);
          if (focusedCard && !focusedCard.hidden && document.activeElement === document.body) {
            const control = focused.disabled || focused.hidden ? focusedCard.querySelector('.source-header') : focused;
            control.focus({preventScroll: true});
          }
          if (anchor && !anchor.hidden) {
            const offset = anchor.getBoundingClientRect().top - anchorTop;
            if (offset) window.scrollBy(0, offset);
          }
          refreshFeedback.hidden = true;
        } catch (_) {
          refreshFeedback.hidden = false;
        } finally {
          window.clearTimeout(timer);
          if (!sessionExpired) window.setTimeout(refresh, 2000);
        }
      }
      refresh();
    })();
  </script>

  <script id="update-review-script">
    (() => {
      const byId = id => document.getElementById(id);
      const panel = byId('update-review');
      const list = byId('update-review-list');
      const all = byId('select-all-updates');
      const alternate = byId('alternate-update-action');
      const checkAll = byId('check-all-updates');
      const checkAgain = byId('check-updates-again');
      const reviewLink = byId('review-updates-link');
      const mobile = window.matchMedia('(max-width: 640px)');
      const sweepFeedback = byId('update-sweep-feedback');
      const batchFeedback = byId('update-batch-feedback');
      let choices = [];
      let revision;
      let rendered;
      let posting = false;
      let sweepState = 'idle';
      let pendingChecks = false;
      let startingSweep = false;
      let counts = {{ catalog.update_stages|default({'download': 0, 'publish': 0})|tojson }};
      let primaryOperation;
      let alternateOperation;
      let selectOnOpen = true;
      const acceptedDownloads = new Set();
      let reviewRequest = 0;
      const rejected = new Map();
      const byteSize = bytes => {
        if (!Number.isFinite(bytes)) return 'Unknown';
        const units = ['B', 'KiB', 'MiB', 'GiB', 'TiB'];
        let unit = 0;
        while (bytes >= 1024 && unit < units.length - 1) { bytes /= 1024; unit++; }
        return new Intl.NumberFormat(undefined, {maximumFractionDigits: 1}).format(bytes) + ' ' + units[unit];
      };

      async function request(path, body) {
        const response = await fetch(path, body ? {method:'POST', headers:{
          ...(window.axiomCsrfHeaders?.() || {}), 'Content-Type':'application/json'
        }, body:JSON.stringify(body)} : {cache:'no-store'});
        const result = await response.json().catch(() => ({}));
        if (response.status === 401) window.location.assign('/admin/login');
        if (!response.ok) throw new Error(result.error || 'Update status is unavailable');
        return result;
      }

      window.axiomShowUpdateAvailability = (count, stages) => {
        byId('update-availability').textContent = count === 1 ? 'An update is available' :
          count > 1 ? 'Updates are available' : '';
        if (stages) {
          counts = stages;
          selectionChanged();
        }
      };

      function actionLabel(operation, count) {
        const verb = operation === 'download-update' ? 'Download' : 'Publish';
        return verb + ' ' + count + (count === 1 ? ' update' : ' updates');
      }

      function selectionChanged() {
        const eligible = choices.filter(item => !item.control.disabled);
        const selected = eligible.filter(item => item.control.checked);
        const downloads = selected.filter(item => item.operation === 'download-update');
        const publications = selected.length - downloads.length;
        const bytes = downloads.reduce((sum, item) => sum + item.bytes, 0);
        all.checked = eligible.length > 0 && selected.length === eligible.length;
        all.indeterminate = selected.length > 0 && !all.checked;
        all.disabled = posting || !eligible.length;
        const downloadCount = panel.hidden || !rendered ? counts.download : downloads.length;
        const publishCount = panel.hidden || !rendered ? counts.publish : publications;
        primaryOperation = downloadCount ? 'download-update' : publishCount ? 'publish-update' : null;
        alternateOperation = downloadCount && publishCount ? 'publish-update' : null;
        const checking = startingSweep || sweepState === 'running';
        const awaitingSelection = !panel.hidden && eligible.length > 0 && !selected.length;
        checkAgain.hidden = !primaryOperation && !awaitingSelection;
        checkAgain.disabled = checking;
        checkAll.disabled = posting || checking || awaitingSelection;
        checkAll.textContent = checking ? 'Checking for updates…' : primaryOperation
          ? actionLabel(primaryOperation, downloadCount || publishCount) : awaitingSelection
            ? 'Select updates' : 'Check for all updates';
        const totalUpdates = counts.download + counts.publish;
        reviewLink.textContent = !mobile.matches && totalUpdates
          ? totalUpdates + (totalUpdates === 1 ? ' update available' : ' updates available')
          : 'Review updates';
        const menu = panel.hidden && !totalUpdates &&
          sweepState !== 'running' ? byId('mobile-admin-tools') : byId('update-notice');
        if (reviewLink.parentElement !== menu) menu.append(reviewLink);
        alternate.hidden = !alternateOperation;
        alternate.disabled = posting || checking;
        if (alternateOperation) alternate.textContent = actionLabel(alternateOperation, publishCount);
        byId('update-selection-size').textContent = downloads.length
          ? 'Selected download estimate and additional storage required: ' + byteSize(bytes)
          : '';
      }

      function renderReview(sources, queue) {
        const jobs = new Map();
        for (const job of queue) {
          if (['download-update', 'publish-update'].includes(job.operation) && !jobs.has(job.source_id)) {
            jobs.set(job.source_id, job);
          }
        }
        const rows = sources.flatMap(source => {
          const sid = source.source_id;
          const replacement = source.replacement || {};
          const update = source.update_check || {};
          const job = jobs.get(sid);
          const pending = job && ['running', 'queued'].includes(job.state);
          const verified = source.installed_verified && replacement.state === 'verified';
          const available = source.installed_verified && update.state === 'update_available' && update.candidate_bytes &&
            (!replacement.state || replacement.state === 'activated');
          const inconclusive = source.installed_verified && update.state === 'unable_to_determine' &&
            (update.checked_at || update.last_successful_check_at || source.discovery?.periodic);
          if (!(verified || available || job || rejected.has(sid) || inconclusive || update.state === 'representation_changed')) return [];
          const operation = pending ? null : verified ? 'publish-update' : available ? 'download-update' : null;
          return [{sid, title:source.profile.title, operation, job, replacement, problem:rejected.get(sid),
            digest: verified ? replacement.sha256 : (update.candidate_sha256 || update.candidate_sha1 || update.candidate_md5),
            installed: source.installed_edition || 'Unknown',
            edition: verified ? source.configuration.edition : update.candidate_edition,
            bytes: verified ? 0 : update.candidate_bytes,
            installedBytes: source.artifact?.bytes,
            inconclusive: inconclusive ? update.evidence || 'No comparison evidence recorded.' : '',
            documentChanged: update.state === 'representation_changed'}];
        });
        const signature = JSON.stringify(rows);
        if (signature === rendered && !selectOnOpen) return;
        rendered = signature;
        const selected = new Set(choices.filter(item => item.control.checked).map(item => item.sid + item.digest));
        const focused = document.activeElement?.dataset.updateSource;
        list.replaceChildren();
        choices = [];
        for (const row of rows) {
          const item = document.createElement('li');
          const label = document.createElement('label');
          if (row.operation && row.digest) {
            const control = document.createElement('input');
            control.type = 'checkbox';
            control.dataset.updateSource = row.sid;
            const downloaded = row.operation === 'publish-update' && acceptedDownloads.delete(row.sid);
            control.checked = selectOnOpen || selected.has(row.sid + row.digest) || downloaded;
            control.addEventListener('change', selectionChanged);
            label.append(control, ' ');
            choices.push({...row, control});
          }
          label.append(row.title);
          item.append(label);
          const detail = document.createElement('p');
          if (row.edition) {
            detail.textContent = 'Installed ' + row.installed + ' · Update ' + row.edition +
              ' · ' + (row.bytes ? byteSize(row.bytes) + ' download and additional storage'
                + (Number.isFinite(row.installedBytes) ? ' · ' + byteSize(row.installedBytes + row.bytes) +
                  ' with both editions retained' : '') : 'Verified on disk');
          } else if (row.inconclusive) {
            detail.textContent = 'Update status inconclusive. ' + row.inconclusive;
          } else if (row.documentChanged) {
            detail.textContent = 'Publisher metadata changed. Review this document on its source card.';
          }
          if (detail.textContent) item.append(detail);
          if (row.problem || row.job || row.replacement.error) {
            const status = document.createElement('p');
            const action = row.job?.operation === 'publish-update' ? 'Publication' : 'Download';
            status.textContent = row.problem || (row.job ? action + ' ' + row.job.state +
              (row.job.detail ? ' · ' + row.job.detail : '') : row.replacement.error);
            item.append(status);
          }
          list.append(item);
        }
        if (!rows.length) {
          const item = document.createElement('li');
          item.textContent = 'No updates to review.';
          list.append(item);
        }
        if (focused) choices.find(item => item.sid === focused)?.control.focus({preventScroll:true});
        selectOnOpen = false;
        selectionChanged();
      }

      async function refreshReview() {
        const seq = ++reviewRequest;
        try {
          const [catalog, queue] = await Promise.all([request('/api/sources'), request('/api/acquisition-batch')]);
          if (seq !== reviewRequest) return;
          revision = catalog.revision;
          window.axiomShowUpdateAvailability(catalog.available_updates, catalog.update_stages);
          renderReview(catalog.sources, queue.jobs);
        } catch (error) {
          if (seq === reviewRequest) batchFeedback.textContent = error.message;
        }
      }

      async function submit(operation) {
        if (posting) return;
        if (panel.hidden) {
          selectOnOpen = true;
          window.location.hash = 'update-review';
          return;
        }
        const selected = choices.filter(item => item.control.checked && item.operation === operation);
        if (!selected.length) {
          batchFeedback.textContent = 'Select the updates you want to ' +
            (operation === 'download-update' ? 'download.' : 'publish.');
          return;
        }
        const bytes = selected.reduce((sum, item) => sum + item.bytes, 0);
        const message = actionLabel(operation, selected.length) + '?' +
          (operation === 'download-update' ? ' Estimated download and additional storage: ' + byteSize(bytes) + '.'
            : ' Each source will keep its current publication setting.');
        if (!window.confirm(message)) return;
        posting = true;
        selectionChanged();
        try {
          const result = await request('/api/update-batch', {operation, revision,
            selection:Object.fromEntries(selected.map(item => [item.sid, item.digest]))});
          for (const item of selected) rejected.delete(item.sid);
          for (const [sid, message] of Object.entries(result.rejected)) rejected.set(sid, message);
          const queuedIds = Object.keys(result.queued);
          if (operation === 'download-update') queuedIds.forEach(sid => acceptedDownloads.add(sid));
          const queued = queuedIds.length;
          const failures = Object.keys(result.rejected).length;
          batchFeedback.textContent = queued + ' queued' + (failures ? ' · ' + failures + ' need attention' : '');
          await refreshReview();
        } catch (error) {
          batchFeedback.textContent = error.message;
        } finally {
          posting = false;
          selectionChanged();
        }
      }

      async function refreshSweep() {
        if (pendingChecks) return;
        pendingChecks = true;
        try {
          const result = await request('/api/update-sweep');
          if (result.state !== sweepState) {
            sweepState = result.state;
            const failures = result.checks.filter(item => item.state === 'unable_to_determine');
            sweepFeedback.textContent = {
              running:'Checking publisher metadata…', busy:'An update check is already running.',
              failed:'Could not check for updates.',
              completed:'Update check finished. ' + (failures.length === 1 ? 'Could not determine update status for 1 source.' :
                failures.length ? 'Could not determine update status for ' + failures.length + ' sources.' : '')
            }[sweepState] || '';
            const detail = byId('update-sweep-details');
            detail.hidden = !failures.length;
            const catalog = failures.length ? await request('/api/sources') : null;
            const sources = new Map((catalog?.sources || []).map(source => [source.source_id, source]));
            const items = failures.map(row => {
              const source = sources.get(row.source_id);
              const item = document.createElement('li');
              const title = document.createElement('strong');
              title.textContent = source?.profile?.title || row.source_id;
              const reason = document.createElement('p');
              reason.textContent = row.evidence || source?.update_check?.evidence ||
                'No comparison evidence was recorded for this check.';
              item.append(title, reason);
              return item;
            });
            byId('update-sweep-failures').replaceChildren(...items);
            if (sweepState === 'completed') {
              selectOnOpen = !panel.hidden;
              if (panel.hidden) {
                const catalog = await request('/api/sources');
                window.axiomShowUpdateAvailability(catalog.available_updates, catalog.update_stages);
              } else {
                await refreshReview();
              }
            }
          }
          selectionChanged();
        } catch (error) {
          if (sweepState === 'running' || startingSweep) sweepFeedback.textContent = error.message;
        } finally {
          pendingChecks = false;
        }
      }
      async function startSweep() {
        startingSweep = true;
        selectionChanged();
        try {
          await request('/api/update-sweep', {confirm:true});
          sweepState = 'running';
          sweepFeedback.textContent = 'Checking publisher metadata…';
          await refreshSweep();
        } catch (error) {
          sweepFeedback.textContent = error.message;
        } finally {
          startingSweep = false;
          selectionChanged();
        }
      }
      checkAll.addEventListener('click', () => primaryOperation ? submit(primaryOperation) : startSweep());
      checkAgain.addEventListener('click', startSweep);
      all.addEventListener('change', () => {
        choices.forEach(item => { item.control.checked = all.checked; });
        selectionChanged();
      });
      alternate.addEventListener('click', () => submit(alternateOperation));
      function showReview() {
        const review = window.location.hash === '#update-review';
        document.body.classList.toggle('reviewing-updates', review);
        panel.hidden = !review;
        if (review) {
          selectOnOpen = true;
          refreshReview();
        }
        selectionChanged();
      }
      reviewLink.addEventListener('click', () => { byId('mobile-admin-menu').open = false; });
      window.addEventListener('hashchange', showReview);
      mobile.addEventListener('change', selectionChanged);
      showReview();
      refreshSweep();
      window.setInterval(() => {
        if (document.hidden) return;
        if (!panel.hidden && !posting) refreshReview();
        refreshSweep();
      }, 4000);
    })();
  </script>
