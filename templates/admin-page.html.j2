          const existing = editorGroups.find(g => g.kind === 'tags' && g.name.toLowerCase() === name.toLowerCase());
          let group_id = existing?.group_id;
          if (!group_id) {
            const base = name.normalize('NFKD').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'').slice(0,50).replace(/-$/,'') || 'tag';
            const used = new Set(editorGroups.filter(g => g.kind === 'tags').map(g => g.group_id));
            group_id = base;
            for (let n=2; used.has(group_id); n++) group_id = base + '-' + n;
            const created = await groupPost({operation:'create',kind:'tags',group_id,name}, currentRevision);
            currentRevision = created.revision;
          }
          await groupPost({operation:'add-members',kind:'tags',group_id,source_ids:[source_id]}, currentRevision);
        }
      }
      async function change(operation, source_id, fields, editGroups = false) {
        if (revision === null) throw new Error('Catalog revision unavailable');
        const response = await fetch('/api/sources', {method:'POST', headers:{...((typeof window !== 'undefined' && window.axiomCsrfHeaders?.()) || {}),'Content-Type':'application/json'},
          body:JSON.stringify({operation, source_id, fields, revision})});
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'Catalog update failed');
        if (editGroups) {
          try {
            if (!Number.isInteger(result.revision)) throw new Error('Missing updated revision');
            await updateEditorGroups(source_id, result.revision);
          } catch (error) {
            window.alert('Source profile saved, but grouping changes may be incomplete. Reload and review memberships: ' + error.message);
          }
        }
        reloadSources();
      }
      document.getElementById('source-add').addEventListener('click', () => openForm('add'));
      cancelSave.addEventListener('click', () => { if (!formPosting) dialog.close(); });
      dialog.addEventListener('cancel', event => { if (formPosting) event.preventDefault(); });
      form.addEventListener('invalid', event => {
        if (advanced.contains(event.target)) advanced.open = true;
      }, true);
      form.addEventListener('submit', async event => {
        event.preventDefault();
        if (formPosting) return;
        if (iconDecode) { formFeedback.textContent = 'Wait for the icon preview before saving.'; return; }
        const source_id = form.dataset.operation === 'add' ? generateId() : input('source_id').value;
        const fields = Object.fromEntries(fieldsToEdit.map(field => [field.name, field.value]));
        if (iconValue || form.dataset.operation === 'edit') fields.icon_png = iconValue;
        const save = form.querySelector('[type="submit"]');
        formPosting = true;
        save.disabled = true;
        cancelSave.disabled = true;
        formFeedback.textContent = '';
        const file = uploadFile.files[0];
        const isDownload = form.dataset.operation === 'add' && format.value === 'epub' && fields.source_url;
        formBusyText.textContent = file ? 'Uploading and verifying ' + format.value.toUpperCase() + '…' :
          isDownload ? 'Downloading and verifying EPUB…' : 'Saving source…';
        formBusy.hidden = false;
        form.setAttribute('aria-busy', 'true');
        try {
          if (form.dataset.operation === 'add' && file) {
            if (!file.size || file.size > 16 * 1024 * 1024) throw new Error('Choose a PDF or EPUB up to 16 MiB');
            const metadata = Object.fromEntries(Object.entries(fields).filter(([k]) => ['title','description','author','publisher','edition','language','source_url','license','update_method','update_endpoint','update_periodic','icon_png'].includes(k)));
            const headers = {...window.axiomCsrfHeaders(), 'Content-Type':format.value === 'epub' ? 'application/epub+zip' : 'application/pdf', 'X-Document-Format':format.value, 'X-Source-ID':source_id,
              'X-Catalog-Revision':String(revision), 'X-PDF-Add':'1',
              'X-PDF-Metadata':encodeURIComponent(JSON.stringify(metadata))};
            if (automaticTitle) headers['X-PDF-Auto-Title'] = '1';
            const response = await acquisitionFetch('/api/pdf-upload', {method:'POST', headers, body:file});
            const result = await response.json().catch(() => ({}));
            if (!response.ok || !result.installed_verified) throw acquisitionError(response, result, 'Document upload was not confirmed');
            reloadSources();
          } else if (form.dataset.operation === 'add' && format.value === 'epub' && fields.source_url) {
            const metadata = Object.fromEntries(Object.entries(fields).filter(([k]) => ['title','description','author','publisher','edition','language','source_url','license','update_method','update_endpoint','update_periodic','icon_png'].includes(k)));
            const response = await acquisitionFetch('/api/action', {method:'POST', headers:{...((typeof window !== 'undefined' && window.axiomCsrfHeaders?.()) || {}),'Content-Type':'application/json'},
              body:JSON.stringify({source_id, action:'epub-add-download', revision, fields:metadata, auto_title:automaticTitle})});
            const result = await response.json().catch(() => ({}));
            if (!response.ok || !result.installed_verified) throw acquisitionError(response, result, 'EPUB download was not confirmed');
            reloadSources();
          } else { await change(form.dataset.operation, source_id, fields, form.dataset.operation === 'edit'); }
        }
        catch (error) { formFeedback.textContent = error.message; formFeedback.focus(); }
        finally {
          formPosting = false;
          save.disabled = false;
          cancelSave.disabled = false;
          formBusy.hidden = true;
          form.removeAttribute('aria-busy');
        }
      });
      document.querySelectorAll('[data-catalog-edit]').forEach(button => button.addEventListener('click', () => {
        openForm('edit', button.closest('.source-card'));
      }));
      document.querySelectorAll('[data-catalog-remove]').forEach(button => button.addEventListener('click', async () => {
        const source_id = button.dataset.catalogRemove;
        if (!window.confirm('Remove this source? It will be unpublished automatically. Installed files will not be deleted.')) return;
        try { await change('remove', source_id, {}); }
        catch (error) { feedback.textContent = error.message; }
      }));
      {% if catalog.sources | selectattr('adapter', 'in', ['pdf','epub']) | list %}
      async function acquirePDF(card, file = null, trigger = null) {
        const feedback = card.querySelector('[data-pdf-feedback]');
        const buttons = card.querySelectorAll('[data-pdf-download], [data-pdf-upload]');
        if (card.dataset.acquiring === 'true' || !Array.from(buttons).some(button => !button.disabled && !button.hidden)) return;
        const busy = card.querySelector('[data-pdf-busy]');
        const busyText = card.querySelector('[data-pdf-busy-text]');
        if (file && (!file.size || file.size > 16 * 1024 * 1024)) {
          feedback.textContent = 'Choose a document between 1 byte and 16 MiB.';
          return;
        }
        const hadFocus = document.activeElement === trigger;
        card.dataset.acquiring = 'true';
        buttons.forEach(button => button.disabled = true);
        feedback.textContent = '';
        busy.hidden = false;
        const formatLabel = card.dataset.filterFormat.toUpperCase();
        busyText.textContent = (file ? 'Uploading and verifying ' : 'Downloading and verifying ') + formatLabel + '…';
        const action = sourceAction(card, () => busy.hidden ? feedback.textContent : busyText.textContent);
        try {
          const response = file
            ? await acquisitionFetch('/api/pdf-upload', {method:'POST', headers:{...((typeof window !== 'undefined' && window.axiomCsrfHeaders?.()) || {}),'Content-Type':card.dataset.filterFormat === 'epub' ? 'application/epub+zip' : 'application/pdf',
                'X-Document-Format':card.dataset.filterFormat, 'X-Source-ID':card.dataset.sourceId, 'X-Catalog-Revision':String(revision)}, body:file})
            : await acquisitionFetch('/api/action', {method:'POST', headers:{...((typeof window !== 'undefined' && window.axiomCsrfHeaders?.()) || {}),'Content-Type':'application/json'},
                body:JSON.stringify({source_id:card.dataset.sourceId, action:card.dataset.filterFormat === 'epub' ? 'epub-download' : 'pdf-download', revision})});
          const result = await response.json().catch(() => ({}));
          if (!response.ok) throw acquisitionError(response, result, 'Document acquisition failed');
          if (!result.installed_verified) throw new Error('Document installation was not confirmed');
          if (file) {
            reloadSources();
            return;
          }
          revision = result.revision;
          feedback.textContent = formatLabel + ' downloaded and verified.';
          finishSourceAction(action);
        } catch (error) {
          feedback.textContent = error.message;
        } finally {
          card.dataset.acquiring = 'false';
          busy.hidden = true;
          buttons.forEach(button => button.disabled = card.dataset.acquisitionBlocked === 'true' || button.hidden);
          restoreActionFocus(card, trigger, hadFocus);
          showFilteredAction();
        }
      }
      document.querySelectorAll('[data-pdf-download]').forEach(button => button.addEventListener('click', () => {
        acquirePDF(button.closest('.source-card'), null, button);
      }));
      document.querySelectorAll('[data-pdf-upload]').forEach(button => button.addEventListener('click', () => {
        button.closest('.source-card').querySelector('[data-pdf-file]').click();
      }));
      document.querySelectorAll('[data-pdf-file]').forEach(input => input.addEventListener('change', () => {
        const file = input.files[0];
        input.value = '';
        if (file) acquirePDF(input.closest('.source-card'), file);
      }));
      {% endif %}
      document.querySelectorAll('[data-zim-download]').forEach(button => button.addEventListener('click', async () => {
        if (button.disabled) return;
        const hadFocus = document.activeElement === button;
        button.disabled = true;
        const card = button.closest('.source-card');
        const localFeedback = card.querySelector('[data-zim-feedback]');
        card.dataset.zimPosting = 'true';
        localFeedback.textContent = 'Starting download…';
        const action = sourceAction(card, () => localFeedback.textContent ||
          card.querySelector('[data-field="metrics"]:not([hidden])')?.textContent ||
          card.querySelector('[data-field="status"]').textContent);
        try {
          const response = await acquisitionFetch('/api/action', {method:'POST', headers:{...((typeof window !== 'undefined' && window.axiomCsrfHeaders?.()) || {}),'Content-Type':'application/json'},
            body:JSON.stringify({source_id:card.dataset.sourceId, action:'zim-download', revision})});
          const result = await response.json().catch(() => ({}));
          if (!response.ok || !result.accepted) {
            throw new Error(result.error || acquisitionError(response, result, 'ZIM acquisition failed').message);
          }
          localFeedback.textContent = 'Download accepted. Waiting for progress…';
          card.dataset.zimAccepted = 'true';
          finishSourceAction(action);
        } catch(error) {
          localFeedback.textContent = error.message;
        } finally {
          delete card.dataset.zimPosting;
          button.disabled = card.dataset.zimAccepted === 'true' || card.dataset.zimBlocked === 'true';
          restoreActionFocus(card, button, hadFocus);
          showFilteredAction();
        }
      }));
      document.querySelectorAll('[data-zim-update-check], [data-document-update-check]').forEach(button => button.addEventListener('click', async () => {
        if (button.disabled) return;
        const card = button.closest('.source-card');
        const feedback = card.querySelector('[data-field="discovery-evidence"]');
        const actionFeedback = card.querySelector('[data-zim-feedback], [data-pdf-feedback]');
        if (actionFeedback) actionFeedback.textContent = '';
        button.disabled = true;
        card.dataset.updateCheckPosting = 'true';
        feedback.textContent = 'Checking…';
        try {
          const response = await fetch('/api/update-check', {
            method: 'POST',
            headers: {...((typeof window !== 'undefined' && window.axiomCsrfHeaders?.()) || {}), 'Content-Type': 'application/json'},
            body: JSON.stringify({source_id: card.dataset.sourceId, revision})
          });
          const result = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(result.error || 'Update check failed');
          const badge = card.querySelector('[data-field="update-status"]');
          if (badge) badge.hidden = result.state !== 'update_available';
          feedback.textContent = {
            update_available: 'Update available',
            up_to_date: 'Up to date',
            no_newer_edition_listed: 'No newer edition found',
            older_candidate: 'Publisher lists an older edition',
            representation_changed: 'Publisher file changed · newer edition unverified',
            representation_unchanged: 'No change detected'
          }[result.state] || (button.hasAttribute('data-document-update-check')
            ? 'Couldn’t compare with the installed file' : 'Unable to check for updates');
          const details = card.querySelector('[data-field="update-evidence"]');
          if (details) details.textContent = result.evidence || '';
        } catch (error) {
          feedback.textContent = error.message || 'Publisher update check unavailable.';
        } finally {
          delete card.dataset.updateCheckPosting;
          button.disabled = false;
        }
      }));
      document.querySelectorAll('[data-delete-downloads]').forEach(button => button.addEventListener('click', async () => {
        if (button.disabled) return;
        const card = button.closest('.source-card');
        const feedback = card.querySelector('[data-delete-feedback]');
        const payload = {source_id: card.dataset.sourceId, action: 'delete-downloaded-files', revision};
        async function request(data) {
          const response = await acquisitionFetch('/api/action', {method: 'POST',
            headers: {...window.axiomCsrfHeaders(), 'Content-Type':'application/json'},
            body: JSON.stringify(data)});
          const result = await response.json().catch(() => ({}));
          if (!response.ok) throw acquisitionError(response, result, 'File deletion failed');
          return result;
        }
        card.dataset.deletePosting = 'true';
        button.disabled = true;
        feedback.textContent = '';
        try {
          const plan = await request(payload);
          const files = plan.files.map(file => file.filename + ' (' + previewSize(file.bytes) + ')');
          const message = (plan.published ? 'This source will be unpublished first.\n\n' : '') +
            'Permanently delete these downloaded files? The source profile will be kept.\n\n' + files.join('\n');
          if (!window.confirm(message)) return;
          await request({...payload, confirmation: plan.confirmation});
          feedback.textContent = 'Downloaded files deleted.';
        } catch (error) {
          feedback.textContent = error.message;
        } finally {
          delete card.dataset.deletePosting;
          button.disabled = false;
        }
      }));
      document.querySelectorAll('[data-delete-staged-update]').forEach(button => button.addEventListener('click', async () => {
        if (button.disabled || !button.dataset.digest) return;
        const card = button.closest('.source-card');
        const edition = button.dataset.edition;
        if (!window.confirm('Delete the staged update files' + (edition ? ' for ' + edition : '') +
            '? The installed edition will stay in service.')) return;
        const feedback = card.querySelector('[data-zim-feedback]');
        card.dataset.stagedDeletePosting = 'true';
        button.disabled = true;
        try {
          const response = await acquisitionFetch('/api/action', {method:'POST',
            headers:{...(window.axiomCsrfHeaders?.() || {}), 'Content-Type':'application/json'},
            body:JSON.stringify({action:'zim-replacement-delete-verified', source_id:card.dataset.sourceId,
              candidate_sha256:button.dataset.digest, revision, confirm:true})});
          const result = await response.json().catch(() => ({}));
          if (!response.ok) throw acquisitionError(response, result, 'Staged update deletion failed');
          if (Number.isInteger(result.revision)) revision = result.revision;
          feedback.textContent = 'Staged update files deleted.';
        } catch (error) {
          feedback.textContent = error.message;
        } finally {
          delete card.dataset.stagedDeletePosting;
        }
      }));
      document.querySelectorAll('[data-zim-replacement]').forEach(button => button.addEventListener('click', async () => {
        if (button.disabled) return;
        const card = button.closest('.source-card');
        const operation = button.dataset.zimReplacement;
        if (['activate','rollback'].includes(operation) &&
            !window.confirm(operation === 'activate' ? 'Switch to the verified update? The source will keep its current publication setting.' : 'Restore the previous verified archive?')) return;
        const feedback = card.querySelector('[data-zim-replacement-status]');
        card.dataset.zimReplacementPosting = 'true';
        card.querySelectorAll('[data-zim-replacement]').forEach(b => b.disabled = true);
        try {
          const response = await acquisitionFetch('/api/action', {method:'POST',
            headers:{...((typeof window !== 'undefined' && window.axiomCsrfHeaders?.()) || {}),'Content-Type':'application/json'},
            body:JSON.stringify({source_id:card.dataset.sourceId, action:'zim-replacement-' + operation, revision,
              ...(['activate','rollback'].includes(operation) ? {confirm_restart:true} : {})})});
          const result = await response.json().catch(() => ({}));
          if (!response.ok) throw acquisitionError(response, result, 'Replacement operation failed');
          feedback.textContent = 'Replacement ' + operation + ' accepted; refreshing status…';
        } catch(error) {
          feedback.textContent = error.message;
        } finally {
          delete card.dataset.zimReplacementPosting;
        }
      }));
      document.querySelectorAll('[data-zim-control]').forEach(button => button.addEventListener('click', async () => {
        if (button.disabled) return;
        const card = button.closest('.source-card');
        const operation = button.dataset.zimControl;
        if (operation === 'cancel' && !window.confirm('Cancel and permanently discard the partial download? Installed versions will be kept.')) return;
        if (operation === 'cancel-keep' && !window.confirm('Cancel this download but retain partial bytes for a possible resume?')) return;
        if (operation === 'restart' && !window.confirm('Restart this download from the beginning? Any retained partial must first be discarded explicitly.')) return;
        if (operation === 'revalidate' && !window.confirm('Recheck the complete retained ZIM using only saved local bytes? No network download will occur.')) return;
        const feedback = card.querySelector('[data-zim-feedback]');
        card.dataset.zimPosting = 'true';
        card.querySelectorAll('[data-zim-control],[data-zim-download]').forEach(b => b.disabled = true);
        try {
          const response = await acquisitionFetch('/api/action', {method:'POST', headers:{...((typeof window !== 'undefined' && window.axiomCsrfHeaders?.()) || {}),'Content-Type':'application/json'},
            body:JSON.stringify({source_id:card.dataset.sourceId, action:'zim-' + operation, revision,
              ...(operation === 'restart' ? {confirm_restart:true} : {})})});
          const result = await response.json().catch(() => ({}));
          if (!response.ok || !result.accepted) throw acquisitionError(response, result, 'ZIM control failed');
          feedback.textContent = operation === 'pause' ? 'Pausing download…' :
            operation === 'cancel' ? 'Cancelling and discarding partial…' :
            operation === 'cancel-keep' ? 'Cancelling and retaining partial…' :
            operation === 'restart' ? 'Restart requested…' :
            operation === 'retry' ? 'Retry requested…' :
            operation === 'revalidate' ? 'Rechecking retained file offline…' : 'Resuming from saved bytes…';
          card.dataset.zimAccepted = 'true';
        } catch(error) {
          feedback.textContent = error.message;
          delete card.dataset.zimAccepted;
        } finally {
          delete card.dataset.zimPosting;
        }
      }));
      document.querySelectorAll('[data-field="publication-toggle"]').forEach(button => button.addEventListener('click', async () => {
        if (button.disabled) return;
        const enabled = button.dataset.enabled !== 'true';
        const acknowledge = enabled && button.dataset.acknowledgeRights === 'true';
        if (acknowledge && !window.confirm("Publish this PDF to library users? Confirm that you have permission to make it available in this library.")) return;
        const card = button.closest('.source-card');
        const status = card.querySelector('[data-publication-feedback]');
        const hadFocus = document.activeElement === button;
        button.dataset.posting = 'true';
        button.disabled = true;
        status.textContent = enabled ? 'Publishing…' : 'Unpublishing…';
        const action = sourceAction(card, () => status.textContent);
        try {
          const payload = {source_id:card.dataset.sourceId, enabled, revision};
          if (acknowledge) payload.acknowledge_rights = true;
          const response = await fetch('/api/publication', {method:'POST', headers:{...window.axiomCsrfHeaders(),'Content-Type':'application/json'},
            body:JSON.stringify(payload)});
          if (!response.ok) throw new Error((await response.json()).error || 'Publication failed');
          revision = (await response.json()).revision;
          button.dataset.enabled = String(enabled);
          button.textContent = enabled ? 'Unpublish' : 'Publish';
          status.textContent = enabled ? 'Publication enabled.' : 'Source unpublished.';
          finishSourceAction(action);
        } catch (error) {
          status.textContent = error.message;
        } finally {
          delete button.dataset.posting;
          button.disabled = false;
          restoreActionFocus(card, button, hadFocus);
          showFilteredAction();
        }
      }));
    })();
  </script>

  <script id="source-filter-script">
    (() => {
      const fields = ['search','publication','download','format','categories','collections','tags'];
      const nodes = Object.fromEntries(fields.map(key => [key, document.getElementById('source-filter-' + key)]));
      const root = document.getElementById('source-cards');
      const cards = Array.from(root.querySelectorAll('.source-card'));
      const groups = {{ ((catalog|default({})).groups|default([]))|tojson }};
      const values = () => Object.fromEntries(fields.map(key => [key,nodes[key].value]));
      const mobile = matchMedia('(max-width: 640px)');
      const filterSheet = document.getElementById('mobile-filters-sheet');
      const filterApply = document.getElementById('mobile-filters-apply');
      let applied;
      const effectiveValues = () => applied ? {...applied, search: nodes.search.value} : values();
      const defaults = {};
      const layout = {{ ((catalog|default({})).library_layout|default({}))|tojson }};
      let order = {{ ((catalog|default({})).library_order|default([]))|tojson }};
      let saving = false;
      let drag = null;
      const rowOf = card => card.closest('.source-row');
      const published = card => card.dataset.filterPublication === 'published';
      const visiblePublished = () => cards.filter(card => published(card) && !card.hidden);
      const filterToggle = document.getElementById('source-filter-toggle');
      const filterPanel = document.getElementById('source-filters-panel');
      filterToggle.addEventListener('click', () => {
        if (mobile.matches) {
          applied = values();
          filterPanel.hidden = false;
          updatePreview();
          filterSheet.showModal();
          filterToggle.setAttribute('aria-expanded', 'true');
          return;
        }
        filterPanel.hidden = !filterPanel.hidden;
        filterToggle.setAttribute('aria-expanded', String(!filterPanel.hidden));
      });
      function rank(card) {
        return card.dataset.filterPublication === 'published' ? 0 : card.dataset.filterDownload === 'downloaded' ? 1 : 2;
      }
      function matchesFilters(card, v, query) {
        const data = card.dataset;
        return (!query || data.filterTitle.toLocaleLowerCase().includes(query)) &&
            (!v.publication || data.filterPublication === v.publication) &&
            (!v.download || data.filterDownload === v.download) &&
            (!v.format || data.filterFormat === v.format) &&
            ['categories','collections','tags'].every(kind => !v[kind] ||
              groups.some(g => g.kind === kind && g.group_id === v[kind] && g.source_ids.includes(data.sourceId)));
      }
      function updatePreview() {
        const draft = values();
        const count = cards.filter(card => matchesFilters(card, draft, draft.search.trim().toLocaleLowerCase())).length;
        filterApply.textContent = 'Show ' + count + (count === 1 ? ' source' : ' sources');
      }
      function apply(reorder = false) {
        const v = effectiveValues(), query = v.search.trim().toLocaleLowerCase();
        let visible = 0;
        for (const card of cards) {
          const matches = matchesFilters(card, v, query);
          card.hidden = !matches;
          card.closest('.source-row').hidden = !matches;
          if (matches) visible++;
        }
        if (reorder) {
          const positions = new Map(order.map((id, index) => [id, index]));
          cards.sort((a,b) => rank(a)-rank(b) ||
            (published(a) ? (positions.get(a.dataset.sourceId) ?? order.length) -
              (positions.get(b.dataset.sourceId) ?? order.length) : 0) ||
            a.dataset.filterTitle.localeCompare(b.dataset.filterTitle, undefined, {sensitivity:'base'}) ||
            a.dataset.sourceId.localeCompare(b.dataset.sourceId));
          let next = root.querySelector('.source-row');
          for (const card of cards) {
            const row = card.closest('.source-row');
            if (row === next) next = row.nextElementSibling;
            else root.insertBefore(row, next);
          }
        }
        const movable = visiblePublished();
        let divider = movable.length > 0;
        for (const card of cards) {
          const row = rowOf(card);
          const index = movable.indexOf(card);
          row.querySelector('.source-order-controls').hidden = index < 0;
          row.querySelector('[data-order-move="-1"]').disabled = saving || index <= 0;
          row.querySelector('[data-order-move="1"]').disabled = saving || index >= movable.length - 1;
          const separates = divider && !card.hidden && !published(card);
          row.classList.toggle('publication-divider', separates);
          if (separates) divider = false;
        }
        const count = document.getElementById('source-filter-count');
        count.textContent = visible + ' of ' + cards.length + ' sources';
        const active = fields.filter(key => key !== 'search' && v[key] !== (defaults[key] || '')).length;
        const indicator = document.getElementById('source-filter-active');
        indicator.hidden = !active;
        indicator.textContent = String(active);
        document.getElementById('source-filter-empty').hidden = visible !== 0 || cards.length === 0;
        if (applied) updatePreview();
        document.dispatchEvent(new Event('axiom-source-filters-changed'));
      }
      const storageKey = 'theaxiom-source-filters';
      try {
        const saved = JSON.parse(sessionStorage.getItem(storageKey) || '{}');
        for (const key of fields) if (typeof saved[key] === 'string') {
          nodes[key].value = saved[key];
        }
      } catch (_) { /* Filtering still works without storage. */ }
      function save() {
        try { sessionStorage.setItem(storageKey, JSON.stringify(effectiveValues())); } catch (_) {}
      }
      fields.forEach(key => nodes[key].addEventListener(key === 'search' ? 'input' : 'change', () => {
        if (applied && key !== 'search') { updatePreview(); return; }
        save(); apply();
      }));
