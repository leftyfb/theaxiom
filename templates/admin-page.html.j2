<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% set page = admin_page|default("sources") %}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png">
<link rel="shortcut icon" href="/favicon.ico" sizes="any">
<meta name="theaxiom-csrf" content="{{ session_csrf_token|default('') }}">
<meta name="application-name" content="The Axiom">
<title>{{ page|capitalize }} · Administration · The Axiom</title>
  <style>
    :root { font-family: ui-sans-serif, system-ui, sans-serif; color:#17332b; background:#eef4f0; --green:#176b4d; --dark:#123c32; --line:#d4e4db; --muted:#587067; --paper:#fff; --accent:#e2f2e9; }
    * { box-sizing: border-box; }
    body { margin: 0; min-width: 280px; }
    a { color: var(--green); }
    a:focus-visible, button:focus-visible { outline: 3px solid #f1b84b; outline-offset: 3px; }
    .skip { position: fixed; left: 1rem; top: -5rem; z-index: 20; padding: .75rem 1rem; color: #fff; background: var(--dark); border-radius: .45rem; }
    .skip:focus { top: 1rem; }
    .site-header { position: sticky; top: 0; z-index: 10; display: flex; align-items: center; gap: .75rem; padding: .75rem 1rem; background: rgba(255,255,255,.97); border-bottom: 1px solid var(--line); }
    .brand { margin-right: auto; color: var(--dark); font-size: 1.05rem; font-weight: 800; text-decoration: none; }
    main { width: min(100% - 2rem, 70rem); margin: 0 auto; padding: 1.5rem 0 3rem; }
    h1 { margin: 0 0 1.5rem; font-size: clamp(1.6rem, 5vw, 2.4rem); }
    .admin-table td.actions { display: flex; flex-wrap: wrap; gap: .4rem; }
    .button { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: .5rem .85rem; border: 1px solid #aac5b7; border-radius: .6rem; background: #fff; color: var(--green); font: inherit; font-weight: 700; cursor: pointer; text-decoration: none; }
    .badge { display: inline-block; padding: .15rem .5rem; border-radius: .35rem; font-size: .75rem; font-weight: 700; }
    .badge.enabled { color: #176b4d; background: #e2f2e9; }
    .badge.disabled { color: #c0392b; background: #fceaea; }
    .empty { padding: 1.5rem; text-align: center; color: var(--muted); }
    @media print { .site-header { display: none; } }
    .settings-panel { background: var(--paper); border: 1px solid var(--line); border-radius: .8rem; padding: 1.25rem; margin: 1rem 0 2rem; }
    .settings-panel fieldset { border: 0; margin: 0; padding: 0; }
    .settings-panel label { display: block; font-weight: 650; margin: .8rem 0 .35rem; }
    .settings-panel input, .settings-panel select { font: inherit; width: min(100%, 40rem); padding: .65rem; border: 1px solid #aac5b7; border-radius: .4rem; background: #fff; color: var(--dark); }
    .settings-actions { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1rem; }
    .storage-status { display: grid; grid-template-columns: minmax(9rem, 1fr) 2fr; gap: .5rem 1rem; }
    .storage-status dt { font-weight: 650; }
    .storage-status dd { margin: 0; overflow-wrap: anywhere; }
    @media (max-width: 500px) { .storage-status { grid-template-columns: 1fr; } .storage-status dd { margin-bottom: .5rem; } }
    .source-card { background: var(--paper); border: 1px solid var(--line); border-radius: .8rem; padding: 1.25rem; margin: 1rem 0; }
    .source-header { display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; }
    .source-header h3 { margin: 0; overflow-wrap: anywhere; }
    .source-header > div { flex: 1; min-width: 0; }
    .source-symbol { background: var(--accent); border-radius: .6rem; padding: .65rem; font-weight: 800; }
    .source-subtitle, .source-note { color: var(--muted); margin: .35rem 0; }
    .source-actions { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .75rem; }
    .button:disabled { opacity: .55; cursor: not-allowed; }
    .source-card progress { width: 100%; accent-color: var(--green); height: .9rem; }
    .source-card { padding: 0; margin: .65rem 0; }
    .source-row { position:relative; margin:.65rem 0; }
    .source-row > .source-card { margin:0; }
    .source-row > .group-select { position:absolute; z-index:1; left:.7rem; top:.75rem; width:2rem; min-height:36px; justify-content:center; }
    .source-row:has(> .group-select:not([hidden])) > .source-card > summary { padding-left:3.25rem; }
    .source-row[hidden] { display:none !important; }
    .source-card > summary { padding: .65rem .85rem; list-style:none; flex-wrap:nowrap; }
    .source-card > summary .source-symbol { width:2.4rem; text-align:center; padding:.5rem .15rem; flex:none; }
    .source-card > summary .source-subtitle { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; margin:.15rem 0; }
    .source-card > summary .compact-publication { display:block; }
    .source-card > summary .badge { max-width:11rem; text-align:right; }
    .source-card > summary .summary-progress { display:block; max-width:12rem; height:.45rem; margin-top:.25rem; }
    @media(max-width:550px) {
      .source-card > summary { flex-wrap:wrap; gap:.4rem; align-items:center; }
      .source-card > summary .source-symbol { width:2rem; }
      /* Reserve a full first row for the icon and title, even during transfers. */
      .source-card > summary > div { flex:1 1 calc(100% - 2.5rem); min-width:0; }
      .source-card > summary .badge { margin-left:2.4rem; max-width:calc(100% - 4rem); }
      .source-card > summary .summary-progress { flex:1 1 100%; max-width:none; margin:.2rem 0 0 2.4rem; }
      .source-card > summary::after { margin-left:auto; }
    }
    .source-card > summary::-webkit-details-marker { display: none; }
    .source-card > summary::after { content: '▾'; color: var(--green); margin-left: .25rem; }
    .source-card[open] > summary::after { content: '▴'; }
    .source-expanded { padding: .8rem 1rem 1rem; border-top: 1px solid var(--line); }
    .source-card > summary .source-subtitle { font-weight: 400; font-size: .9rem; }
    .source-card > summary h3 { font-size: 1.05rem; }
    .source-card > summary .source-symbol { flex-shrink: 0; }
    .source-card > summary .badge { flex-shrink: 0; }
    .compact-publication { font-size: .8rem; color: var(--muted); }
    .source-card details { margin-top: 1rem; border-top: 1px solid var(--line); padding-top: .6rem; }
    .source-card summary { cursor: pointer; font-weight: 650; min-height: 44px; color: var(--green); }
    .source-card summary:focus-visible { outline: 3px solid #f1b84b; }
    .source-card [hidden] { display: none !important; }
    .source-live:not(:has(> :not([hidden]))) { display: none; }
    .source-live { margin-top: .4rem; }
    .source-expanded .source-actions { margin-top: .45rem; }
    .source-expanded .source-actions .button { padding: .35rem .65rem; }
    .source-actions .danger-action { color: #a12820; border-color: #d7aaa5; }
    .source-expanded .source-note:empty, #source-form-feedback:empty, [data-pdf-feedback]:empty { display: none; }
    .source-metadata { display:flex; flex-wrap:wrap; gap:.3rem 1rem; margin:.6rem 0; font-size:.9rem; }
    .source-metadata div { display:flex; gap:.35rem; }
    .source-metadata dt { font-weight:650; }
    .source-metadata dd { margin:0; overflow-wrap:anywhere; }
    .source-technical { margin-top:.6rem; font-size:.9rem; }
    .source-technical summary { cursor:pointer; color:var(--green); font-weight:650; }
    .source-technical .storage-status { gap:.25rem .6rem; margin:.5rem 0; }
    .busy-indicator { display:flex; align-items:center; gap:.6rem; margin:.6rem 0; }
    .busy-indicator[hidden] { display:none; }
    .busy-spinner { display:inline-block; flex:none; width:1rem; height:1rem; border:2px solid currentColor; border-right-color:transparent; border-radius:50%; animation: source-spin .8s linear infinite; }
    @keyframes source-spin { to { transform:rotate(360deg); } }
    @media (prefers-reduced-motion: reduce) { .busy-spinner { animation:none; } }
    .source-live p { margin: .4rem 0; }
    .source-details { overflow-wrap: anywhere; }
    .admin-nav { display:flex; flex-wrap:wrap; gap:.5rem; margin-bottom:1.5rem; }
    .admin-nav a[aria-current="page"] { background:var(--dark); color:white; }
    .source-filters { background:var(--paper); border:1px solid var(--line); border-radius:.8rem; padding:1rem; margin:1rem 0; }
    .source-filters > summary, .group-panel > summary, #source-editor-groups > summary, .membership-section > summary, #source-advanced > summary { display:list-item; list-style-position:inside; }
    .source-filters summary { cursor:pointer; font-weight:700; color:var(--green); }
    #catalog-feedback:empty { margin:0; padding:0; }
    .source-selection-bar { display:flex; align-items:center; gap:.75rem; padding:.35rem .8rem; margin:.35rem 0; color:var(--muted); flex-wrap:wrap; }
    .source-selection-bar label { display:flex; align-items:center; gap:.45rem; cursor:pointer; font-size:.9rem; }
    .source-selection-bar input { width:1.2rem; height:1.2rem; margin:0; accent-color:var(--green); }
    .source-filter-toggle { margin-left:auto; display:inline-flex; align-items:center; justify-content:center; gap:.35rem; min-height:44px; }
    .source-filter-toggle[aria-expanded="true"] { background:var(--dark); color:white; }
    .source-filter-toggle svg { width:1.2rem; height:1.2rem; flex:none; }
    .source-search-row { display:flex; align-items:center; gap:.5rem; flex-wrap:wrap; }
    .source-search-row input { margin-left:auto; width:min(100%,20rem); min-height:44px; padding:.55rem .7rem; font:inherit; border:1px solid #aac5b7; border-radius:.4rem; background:white; color:var(--dark); }
    .source-list-toolbar { display:flex; align-items:center; gap:.75rem; flex-wrap:wrap; margin:.75rem 0; }
    .source-filters .editor-grid { grid-template-columns:repeat(auto-fit,minmax(145px,1fr)); margin:.5rem 0; }
    .source-card[hidden] { display:none !important; }
    .group-panel { background:var(--paper); border:1px solid var(--line); border-radius:.8rem; padding:1rem; margin:1rem 0; }
    .group-panel summary { cursor:pointer; font-weight:700; color:var(--green); }
    .group-membership { font-size:.8rem; color:var(--muted); overflow-wrap:anywhere; }
    .group-select { display:flex; align-items:center; gap:.35rem; font-size:.8rem; color:var(--muted); }
    .group-select[hidden], [hidden] { display:none !important; }
    .group-select input { width:1.2rem; height:1.2rem; accent-color:var(--green); }
    #source-dialog, #source-guide { width: min(42rem, calc(100% - 2rem)); max-height: calc(100% - 2rem); overflow: auto; border: 1px solid var(--line); border-radius: .85rem; padding: clamp(1rem, 4vw, 1.75rem); color: var(--dark); background: var(--paper); }
    #source-dialog::backdrop, #source-guide::backdrop { background: rgba(18,60,50,.55); }
    #source-dialog h3 { margin: 0; font-size: 1.4rem; }
    .editor-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1rem; margin: 1rem 0; }
    .editor-wide { grid-column: 1 / -1; }
    .editor-grid > div { min-width: 0; }
    .editor-grid label { display: block; font-weight: 650; margin-bottom: .35rem; }
    .editor-grid input, .editor-grid select, .editor-grid textarea { display: block; width: 100%; min-width: 0; min-height: 44px; padding: .65rem; font: inherit; border: 1px solid #aac5b7; border-radius: .4rem; color: var(--dark); background: white; }
    .editor-grid textarea { min-height: 5rem; resize: vertical; }
    .editor-grid small { display: block; margin-top: .3rem; color: var(--muted); }
    #source-dialog :focus-visible { outline: 3px solid #f1b84b; outline-offset: 2px; }
    #source-editor-groups { border:0; margin:1rem 0; padding:0; min-width:0; }
    #source-editor-groups > summary { cursor:pointer; font-weight:700; color:var(--green); padding:.6rem 0; border-top:1px solid var(--line); }
    .membership-section { border:1px solid var(--line); border-radius:.5rem; padding:.65rem; margin:.5rem 0; }
    .membership-section summary { cursor:pointer; font-weight:650; color:var(--green); }
    .membership-options { display:grid; grid-template-columns:repeat(auto-fit,minmax(145px,1fr)); gap:.35rem; max-height:12rem; overflow:auto; margin-top:.5rem; }
    .membership-option { display:flex; align-items:center; gap:.45rem; padding:.3rem; overflow-wrap:anywhere; }
    .membership-option input { flex:none; width:1.1rem; height:1.1rem; accent-color:var(--green); }
    #editor-new-tag { width:100%; min-height:44px; padding:.6rem; font:inherit; border:1px solid #aac5b7; border-radius:.4rem; }
    #source-advanced { border-top: 1px solid var(--line); padding-top: .8rem; }
    #source-advanced summary { cursor: pointer; color: var(--green); font-weight: 650; padding: .5rem 0; }
    .editor-actions { display: flex; justify-content: flex-end; flex-wrap: wrap; gap: .5rem; margin-top: 1rem; }
    .editor-save { background: var(--green); color: white; }
    #source-form-feedback { color: #a12820; overflow-wrap: anywhere; }
    #source-help { border-top: 1px solid var(--line); margin-top: 1rem; padding-top: .75rem; font-size: .9rem; }
    @media (max-width: 550px) { .editor-grid { grid-template-columns: minmax(0,1fr); } }
  </style>
</head>
<body>
  <a class="skip" href="#main-content">Skip to administration</a>
  <header class="site-header">
    <a class="brand" href="/">← The Axiom</a>
    <span class="brand">Admin</span>
    <button id="admin-logout" class="button" type="button"{% if not session_csrf_token %} hidden{% endif %}>Sign out</button>
  </header>
  <main id="main-content">
    <nav class="admin-nav" aria-label="Administration"><a class="button" href="/admin/sources"{% if page == "sources" %} aria-current="page"{% endif %}>Sources</a><a class="button" href="/admin/groupings"{% if page == "groupings" %} aria-current="page"{% endif %}>Groupings</a><a class="button" href="/admin/settings"{% if page == "settings" %} aria-current="page"{% endif %}>Settings</a></nav>
    {% if page == "settings" %}
    <h1>Settings</h1>
    <section class="settings-panel" id="storage-settings" aria-labelledby="storage-title">
      <h2 id="storage-title">Storage preferences</h2>
      <p>Choose an existing directory on the server. For network or removable storage, require the expected mount so a missing drive cannot redirect downloads to the operating system disk.</p>
      <form id="storage-form">
        <fieldset id="storage-fields" disabled>
          <label for="storage-root">Storage root</label>
          <input id="storage-root" type="text" placeholder="/path/to/library" autocomplete="off" required>
          <label for="storage-mode">Storage type</label>
          <select id="storage-mode"><option value="local">Local directory (no required mount)</option><option value="mounted">Require a specific mounted filesystem</option></select>
          <div id="mount-fields" hidden>
            <label for="storage-mount">Expected mount target</label>
            <input id="storage-mount" type="text" placeholder="/path/to/mount" autocomplete="off">
            <label for="storage-source">Expected mount source</label>
            <input id="storage-source" type="text" placeholder="server:/export or device source" autocomplete="off">
          </div>
          <label for="minimum-free">Minimum available bytes (optional; 0 uses content size)</label>
          <input id="minimum-free" type="number" min="0" max="9007199254740991" step="1" value="0">
          <div class="settings-actions">
            <button class="button" type="submit">Save and validate</button>
            <button class="button" type="button" id="storage-refresh">Reload saved settings</button>
          </div>
        </fieldset>
      </form>
      <p id="storage-feedback" role="status" aria-live="polite">Loading storage preferences…</p>
      <h3>Saved storage status</h3>
      <dl id="storage-status" class="storage-status" aria-live="polite">
        <dt>Readiness</dt><dd id="status-ready">Not checked</dd>
        <dt>Configured root</dt><dd id="status-root">—</dd>
        <dt>Detected mount</dt><dd id="status-mount">—</dd>
        <dt>Filesystem / source</dt><dd id="status-source">—</dd>
        <dt>Total capacity</dt><dd id="status-total">—</dd>
        <dt>Available capacity</dt><dd id="status-free">—</dd>
        <dt>Write readiness (advisory)</dt><dd id="status-write">—</dd>
        <dt>Staging directory</dt><dd id="status-staging">—</dd>
        <dt>Verified library directory</dt><dd id="status-library">—</dd>
      </dl>
      <p>Readiness is advisory. Saving settings does not move or create content. Acquisitions remain disabled until safe download and recovery support is implemented.</p>
    </section>
    {% if password_change_enabled %}
    <section class="settings-panel" id="admin-password" aria-labelledby="password-title">
      <h2 id="password-title">Change administrator password</h2>
      <p>Choose a unique password of 8–256 printable non-space ASCII characters. Changing it immediately invalidates the old password. On this HTTP development site, credentials are not encrypted in transit.</p>
      <form id="password-form">
        <fieldset id="password-fields">
          <label for="current-password">Current password</label>
          <input id="current-password" type="password" autocomplete="current-password" required maxlength="256">
          <label for="new-password">New password</label>
          <input id="new-password" type="password" autocomplete="new-password" required minlength="8" maxlength="256">
          <label for="confirm-password">Confirm new password</label>
          <input id="confirm-password" type="password" autocomplete="new-password" required minlength="8" maxlength="256">
          <div class="settings-actions"><button class="button" type="submit">Change password</button></div>
        </fieldset>
      </form>
      <p id="password-feedback" role="status" aria-live="polite"></p>
    </section>
    {% endif %}
    {% elif page == "groupings" %}
    <h1>Manage groupings</h1>
    <p>Categories classify subjects, collections curate resources, and tags describe sources. Assign memberships from Sources. Deleting a grouping never deletes sources or installed content.</p>
    <section class="group-panel" aria-label="Grouping management">
      <label for="manage-kind">Grouping type</label>
      <select id="manage-kind"><option value="categories">Categories</option><option value="tags">Tags</option><option value="collections">Collections</option></select>
      <label for="manage-search">Search groupings</label><input id="manage-search" type="search">
      <label for="manage-new">New grouping name</label><input id="manage-new" maxlength="100">
      <button class="button" id="manage-create" type="button">Add grouping</button>
      <button class="button" id="manage-defaults" type="button">Add missing starter categories and tags</button>
      <p id="manage-feedback" role="status" aria-live="polite"></p>
      <div id="manage-list"></div>
    </section>
    <script>
    (() => {
      const groups = {{ catalog.groups|default([])|tojson }};
      const revision = {{ catalog.revision|tojson }};
      const kind = document.getElementById('manage-kind');
      const search = document.getElementById('manage-search');
      const name = document.getElementById('manage-new');
      const list = document.getElementById('manage-list');
      const feedback = document.getElementById('manage-feedback');
      let busy = false;
      try { kind.value = sessionStorage.getItem('axiom-group-kind') || 'categories'; } catch (_) {}
      if (!kind.value) kind.value = 'categories';
      async function mutate(payload) {
        if (busy) return;
        busy = true;
        document.querySelectorAll('.group-panel button,.group-panel input,.group-panel select').forEach(e => e.disabled = true);
        try {
          const response = await fetch('/api/groups',{method:'POST',headers:{...((typeof window !== 'undefined' && window.axiomCsrfHeaders?.()) || {}),'Content-Type':'application/json'},body:JSON.stringify({...payload,revision})});
          const result = await response.json();
          if (!response.ok) throw new Error(result.error || 'Grouping update failed');
          try { sessionStorage.setItem('axiom-group-kind',kind.value); } catch (_) {}
          location.reload();
        } catch (error) {
          feedback.textContent = error.message;
          busy = false;
          document.querySelectorAll('.group-panel button,.group-panel input,.group-panel select').forEach(e => e.disabled = false);
        }
      }
      function render() {
        list.replaceChildren();
        const matches = groups.filter(g => g.kind === kind.value && g.name.toLowerCase().includes(search.value.toLowerCase())).sort((a,b)=>a.name.localeCompare(b.name));
        if (!matches.length) list.textContent = 'No matching groupings.';
        for (const group of matches) {
          const row = document.createElement('div');
          row.className = 'source-actions';
          const label = document.createElement('label');
          const field = document.createElement('input');
          field.value = group.name; field.maxLength = 100;
          field.setAttribute('aria-label','Name of ' + group.name);
          label.append(field);
          const count = document.createElement('span');
          count.textContent = group.source_ids.length + ' sources';
          const rename = document.createElement('button');
          rename.className = 'button'; rename.type = 'button'; rename.textContent = 'Rename';
          rename.onclick = () => mutate({operation:'rename',kind:group.kind,group_id:group.group_id,name:field.value.trim()});
          const remove = document.createElement('button');
          remove.className = 'button'; remove.type = 'button'; remove.textContent = 'Delete';
          remove.onclick = () => {
            if (window.confirm('Delete ' + group.name + ' and its ' + group.source_ids.length + ' source assignments? Sources and files will remain.'))
              mutate({operation:'delete',kind:group.kind,group_id:group.group_id});
          };
          row.append(label,count,rename,remove); list.append(row);
        }
      }
      document.getElementById('manage-create').onclick = () => {
        const value = name.value.trim();
        if (!value) { feedback.textContent = 'Enter a name.'; return; }
        const base = value.normalize('NFKD').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'').slice(0,50).replace(/-$/,'') || 'group';
        const used = new Set(groups.filter(g => g.kind === kind.value).map(g => g.group_id));
        let id = base;
        for (let n=2;used.has(id);n++) id = base+'-'+n;
        mutate({operation:'create',kind:kind.value,group_id:id,name:value});
      };
      document.getElementById('manage-defaults').onclick = () => {
        if (window.confirm('Add missing starter categories and tags? Existing groups and memberships are preserved. Previously deleted defaults may be restored.'))
          mutate({operation:'merge-defaults',kind:'categories',group_id:'defaults'});
      };
      kind.addEventListener('change',render); search.addEventListener('input',render); render();
    })();
    </script>
    {% else %}
    <h1>Manage offline sources</h1>
    <div class="source-search-row">
      <button class="button" type="button" id="source-add">Add Source</button>
      <button class="button" type="button" id="source-guide-open">Content source guide</button>
      <input id="source-filter-search" type="search" aria-label="Search source names" placeholder="Search sources…" maxlength="512">
    </div>
    <p id="catalog-feedback" role="status" aria-live="polite"></p>
    {% set groups = (catalog|default({})).groups|default([]) %}
    <dialog id="source-dialog" aria-labelledby="source-dialog-title">
      <form id="source-form">
        <h3 id="source-dialog-title">Add source metadata</h3>
        <p class="source-note">Choose content to add to your offline library. Choose a PDF or EPUB to install it now, or save a URL-based profile for later acquisition. Publication is separate. <a href="#source-help" id="source-guide-link">Content source help</a></p>
        <input id="catalog-id" name="source_id" type="hidden">
        <p id="catalog-id-display" class="source-note" hidden></p>
        <div class="editor-grid">
          <div class="editor-wide" id="source-upload-row"><label for="source-upload-file">Upload PDF or EPUB (optional)</label><input id="source-upload-file" type="file" accept=".pdf,.epub,application/pdf,application/epub+zip"><small>Choose a PDF or EPUB to populate its name and format automatically.</small></div>
          <div class="editor-wide"><label for="catalog-title">Source name</label><input id="catalog-title" name="title" required maxlength="512"></div>
