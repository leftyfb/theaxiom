      const labels = {queued: 'Queued', downloading: 'Downloading', verifying: 'Verifying checksum',
        publishing: 'Promoting / verifying final file', completed: 'Acquisition completed',
        retrying: 'Waiting to retry', failed: 'Failed', interrupted: 'Interrupted',
        paused: 'Paused', pausing: 'Pausing', cancelling: 'Cancelling', cancelled: 'Cancelled',
        not_started: 'Not downloaded', unavailable: 'Service not installed', unknown: 'Status unknown'};

      function checksumSample(job) {
        if (job?.state !== 'verifying' ||
            !Number.isFinite(job.checksum_bytes) || job.checksum_bytes < 0 ||
            !Number.isFinite(job.expected_bytes) || job.expected_bytes <= 0 ||
            job.checksum_bytes > job.expected_bytes) return null;
