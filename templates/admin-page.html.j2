        progress.hidden = !valid;
        progress.value = valid ? 100 * job.downloaded_bytes / job.expected_bytes : 0;
        const compact = field('summary-progress');
        compact.hidden = !valid;
        compact.value = progress.value;
        put('metrics', valid ? (stale ? 'Last observed download: ' : 'Download: ') +
          progress.value.toFixed(2) + '% · ' + size(job.downloaded_bytes) + ' / ' + size(job.expected_bytes) :
          !stale && job?.active && Number.isFinite(job.downloaded_bytes) ? size(job.downloaded_bytes) + ' downloaded' : '');
        const checking = !stale && (job?.state === 'verifying' || job?.state === 'publishing');
        const verify = field('verification');
        verify.hidden = !checking;
        const sample = checking && checksumSample(job);
        if (sample) {
