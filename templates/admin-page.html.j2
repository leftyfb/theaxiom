  <script id="mobile-sources-script">
    (() => {
      const media = matchMedia('(max-width: 640px)');
      const byId = id => document.getElementById(id);
      const menu = byId('mobile-admin-menu');
      const search = byId('source-filter-search');
      const searchToggle = byId('mobile-search-toggle');
      const searchSlot = byId('mobile-source-search');
      const filters = byId('mobile-filters-sheet');
      const actions = byId('mobile-actions-sheet');
      const done = byId('mobile-selection-done');
      const add = byId('source-add');
      const selection = byId('source-select-mode');
      const toolbar = menu.closest('nav');
      new ResizeObserver(() => {
        document.querySelector('.sources-admin').style.setProperty(
          '--sources-toolbar-height', toolbar.getBoundingClientRect().height + 'px');
      }).observe(toolbar);
      const moves = [
        ['source-guide-open', byId('mobile-admin-tools')],
        ['source-select-mode', byId('mobile-admin-tools')], ['source-add', byId('mobile-add-control')],
        ['source-filter-toggle', byId('mobile-filter-control')], ['source-filter-search', searchSlot],
        ['group-count', byId('mobile-selection')], ['select-all-label', byId('mobile-selection')],
        ['selection-file-open', actions, true], ['bulk-selection', actions, true],
        ['group-panel', actions, true], ['source-filters-panel', filters, true],
      ].map(([id, target, mobileOnly = false]) => {
        const node = byId(id);
        const slot = document.createComment(id);
        node.before(slot);
        return {node, target, slot, mobileOnly};
      });
      function setSearch(open) {
        searchSlot.hidden = !open;
        searchToggle.setAttribute('aria-expanded', String(open));
      }
      function layout() {
        if (!media.matches) {
          if (filters.open) filters.close();
          if (actions.open) actions.close();
        }
        for (const {node, target, slot, mobileOnly} of moves) {
          if (!mobileOnly || media.matches) target.append(node);
          else slot.after(node);
        }
        (media.matches ? byId('mobile-source-count') : byId('desktop-source-count'))
          .append(byId('source-filter-count'));
        byId('mobile-selection').append(byId('mobile-actions-open'), done);
        add.textContent = '+';
        add.setAttribute('aria-label', 'Add Source');
        setSearch(!!search.value || !searchSlot.hidden);
        if (media.matches) {
          byId('mobile-actions-open').removeAttribute('aria-expanded');
          filters.append(byId('mobile-filters-apply'));
          setSearch(!!search.value);
          byId('source-filters-panel').hidden = true;
          byId('source-filter-toggle').setAttribute('aria-expanded', 'false');
        } else {
          byId('mobile-actions-open').setAttribute('aria-expanded',
            String(document.body.classList.contains('selection-actions-open')));
        }
      }
      searchToggle.addEventListener('click', () => {
        setSearch(searchSlot.hidden);
        if (!searchSlot.hidden) search.focus();
      });
      done.addEventListener('click', () => {
        selection.click();
        menu.querySelector('summary').focus({preventScroll:true});
      });
      const reorder = byId('mobile-reorder');
      reorder.addEventListener('click', () => {
        const active = document.body.classList.toggle('reordering');
        reorder.textContent = active ? 'Finish reordering' : 'Reorder published sources';
        reorder.setAttribute('aria-pressed', String(active));
      });
      byId('mobile-actions-open').addEventListener('click', () => {
        if (media.matches) actions.showModal();
        else {
          const opened = document.body.classList.toggle('selection-actions-open');
          byId('mobile-actions-open').setAttribute('aria-expanded', String(opened));
        }
      });
      media.addEventListener('change', layout);
      layout();
    })();
  </script>
  <script id="acquisition-monitor-script">
    (() => {
