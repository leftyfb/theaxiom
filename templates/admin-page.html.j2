<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% set page = admin_page|default("sources") %}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
<title>{{ page|capitalize }} · Administration · The Axiom</title>
  <style>
    :root { font-family: ui-sans-serif, system-ui, sans-serif; color:#17332b; background:#eef4f0; --green:#176b4d; --dark:#123c32; --line:#d4e4db; --muted:#587067; --paper:#fff; --accent:#e2f2e9; }
    * { box-sizing: border-box; }
    body { margin: 0; min-width: 280px; }
    a { color: var(--green); }
    a:focus-visible, button:focus-visible { outline: 3px solid #f1b84b; outline-offset: 3px; }
    .skip { position: fixed; left: 1rem; top: -5rem; z-index: 20; padding: .75rem 1rem; color: #fff; background: var(--dark); border-radius: .45rem; }
    .skip:focus { top: 1rem; }
    .site-header { position: sticky; top: 0; z-index: 10; display: flex; align-items: center; gap: .75rem; padding: .75rem 1rem; background: rgba(255,255,255,.97); border-bottom: 1px solid var(--line); }
    .brand { margin-right: auto; color: var(--dark); font-size: 1.05rem; font-weight: 800; text-decoration: none; }
    main { width: min(100% - 2rem, 70rem); margin: 0 auto; padding: 1.5rem 0 3rem; }
    h1 { margin: 0 0 1.5rem; font-size: clamp(1.6rem, 5vw, 2.4rem); }
    .admin-table td.actions { display: flex; flex-wrap: wrap; gap: .4rem; }
    .button { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: .5rem .85rem; border: 1px solid #aac5b7; border-radius: .6rem; background: #fff; color: var(--green); font: inherit; font-weight: 700; cursor: pointer; text-decoration: none; }
    .badge { display: inline-block; padding: .15rem .5rem; border-radius: .35rem; font-size: .75rem; font-weight: 700; }
    .badge.enabled { color: #176b4d; background: #e2f2e9; }
    .badge.disabled { color: #c0392b; background: #fceaea; }
    .empty { padding: 1.5rem; text-align: center; color: var(--muted); }
    @media print { .site-header { display: none; } }
    .settings-panel { background: var(--paper); border: 1px solid var(--line); border-radius: .8rem; padding: 1.25rem; margin: 1rem 0 2rem; }
    .settings-panel fieldset { border: 0; margin: 0; padding: 0; }
    .settings-panel label { display: block; font-weight: 650; margin: .8rem 0 .35rem; }
    .settings-panel input, .settings-panel select { font: inherit; width: min(100%, 40rem); padding: .65rem; border: 1px solid #aac5b7; border-radius: .4rem; background: #fff; color: var(--dark); }
    .settings-actions { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1rem; }
    .storage-status { display: grid; grid-template-columns: minmax(9rem, 1fr) 2fr; gap: .5rem 1rem; }
    .storage-status dt { font-weight: 650; }
    .storage-status dd { margin: 0; overflow-wrap: anywhere; }
    @media (max-width: 500px) { .storage-status { grid-template-columns: 1fr; } .storage-status dd { margin-bottom: .5rem; } }
    .source-card { background: var(--paper); border: 1px solid var(--line); border-radius: .8rem; padding: 1.25rem; margin: 1rem 0; }
    .source-header { display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; }
    .source-header h3 { margin: 0; overflow-wrap: anywhere; }
    .source-header > div { flex: 1; min-width: 0; }
    .source-symbol { background: var(--accent); border-radius: .6rem; padding: .65rem; font-weight: 800; }
    .source-subtitle, .source-note { color: var(--muted); margin: .35rem 0; }
    .source-actions { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .75rem; }
    .button:disabled { opacity: .55; cursor: not-allowed; }
    .source-card progress { width: 100%; accent-color: var(--green); height: .9rem; }
    .source-card { padding: 0; margin: .65rem 0; }
    .source-card > summary { padding: .8rem 1rem; list-style: none; }
    .source-card > summary::-webkit-details-marker { display: none; }
    .source-card > summary::after { content: '▾'; color: var(--green); margin-left: .25rem; }
    .source-card[open] > summary::after { content: '▴'; }
    .source-expanded { padding: .8rem 1rem 1rem; border-top: 1px solid var(--line); }
    .source-card > summary .source-subtitle { font-weight: 400; font-size: .9rem; }
    .source-card > summary h3 { font-size: 1.05rem; }
    .source-card > summary .source-symbol { flex-shrink: 0; }
    .source-card > summary .badge { flex-shrink: 0; }
    .compact-publication { font-size: .8rem; color: var(--muted); }
    .source-card details { margin-top: 1rem; border-top: 1px solid var(--line); padding-top: .6rem; }
    .source-card summary { cursor: pointer; font-weight: 650; min-height: 44px; color: var(--green); }
    .source-card summary:focus-visible { outline: 3px solid #f1b84b; }
    .source-card [hidden] { display: none !important; }
    .source-live { margin-top: 1rem; }
    .source-live p { margin: .4rem 0; }
    .source-details { overflow-wrap: anywhere; }
    .admin-nav { display:flex; flex-wrap:wrap; gap:.5rem; margin-bottom:1.5rem; }
    .admin-nav a[aria-current="page"] { background:var(--dark); color:white; }
    .source-filters { background:var(--paper); border:1px solid var(--line); border-radius:.8rem; padding:1rem; margin:1rem 0; }
    .source-filters .editor-grid { grid-template-columns:repeat(auto-fit,minmax(145px,1fr)); margin:.5rem 0; }
    .source-card[hidden] { display:none !important; }
    .group-panel { background:var(--paper); border:1px solid var(--line); border-radius:.8rem; padding:1rem; margin:1rem 0; }
    .group-panel summary { cursor:pointer; font-weight:700; color:var(--green); }
    .group-membership { font-size:.8rem; color:var(--muted); overflow-wrap:anywhere; }
    .group-select { display:flex; align-items:center; gap:.35rem; font-size:.8rem; color:var(--muted); }
    .group-select[hidden], [hidden] { display:none !important; }
    .group-select input { width:1.2rem; height:1.2rem; accent-color:var(--green); }
    #source-dialog, #source-guide { width: min(42rem, calc(100% - 2rem)); max-height: calc(100% - 2rem); overflow: auto; border: 1px solid var(--line); border-radius: .85rem; padding: clamp(1rem, 4vw, 1.75rem); color: var(--dark); background: var(--paper); }
    #source-dialog::backdrop, #source-guide::backdrop { background: rgba(18,60,50,.55); }
    #source-dialog h3 { margin: 0; font-size: 1.4rem; }
    .editor-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1rem; margin: 1rem 0; }
    .editor-wide { grid-column: 1 / -1; }
    .editor-grid > div { min-width: 0; }
    .editor-grid label { display: block; font-weight: 650; margin-bottom: .35rem; }
    .editor-grid input, .editor-grid select, .editor-grid textarea { display: block; width: 100%; min-width: 0; min-height: 44px; padding: .65rem; font: inherit; border: 1px solid #aac5b7; border-radius: .4rem; color: var(--dark); background: white; }
    .editor-grid textarea { min-height: 5rem; resize: vertical; }
    .editor-grid small { display: block; margin-top: .3rem; color: var(--muted); }
    #source-dialog :focus-visible { outline: 3px solid #f1b84b; outline-offset: 2px; }
    #source-advanced { border-top: 1px solid var(--line); padding-top: .8rem; }
    #source-advanced summary { cursor: pointer; color: var(--green); font-weight: 650; padding: .5rem 0; }
    .editor-actions { display: flex; justify-content: flex-end; flex-wrap: wrap; gap: .5rem; margin-top: 1rem; }
    .editor-save { background: var(--green); color: white; }
    #source-form-feedback { color: #a12820; overflow-wrap: anywhere; }
    #source-help { border-top: 1px solid var(--line); margin-top: 1rem; padding-top: .75rem; font-size: .9rem; }
    @media (max-width: 550px) { .editor-grid { grid-template-columns: minmax(0,1fr); } }
  </style>
</head>
<body>
  <a class="skip" href="#main-content">Skip to administration</a>
  <header class="site-header">
    <a class="brand" href="/">← The Axiom</a>
    <span class="brand">Admin</span>
  </header>
  <main id="main-content">
    <nav class="admin-nav" aria-label="Administration"><a class="button" href="/admin/sources"{% if page == "sources" %} aria-current="page"{% endif %}>Sources</a><a class="button" href="/admin/settings"{% if page == "settings" %} aria-current="page"{% endif %}>Settings</a></nav>
    {% if page == "settings" %}
    <h1>Settings</h1>
    <section class="settings-panel" id="storage-settings" aria-labelledby="storage-title">
      <h2 id="storage-title">Storage preferences</h2>
      <p>Choose an existing directory on the server. For network or removable storage, require the expected mount so a missing drive cannot redirect downloads to the operating system disk.</p>
      <form id="storage-form">
        <fieldset id="storage-fields" disabled>
          <label for="storage-root">Storage root</label>
          <input id="storage-root" type="text" placeholder="/path/to/library" autocomplete="off" required>
          <label for="storage-mode">Storage type</label>
          <select id="storage-mode"><option value="local">Local directory (no required mount)</option><option value="mounted">Require a specific mounted filesystem</option></select>
          <div id="mount-fields" hidden>
            <label for="storage-mount">Expected mount target</label>
            <input id="storage-mount" type="text" placeholder="/path/to/mount" autocomplete="off">
            <label for="storage-source">Expected mount source</label>
            <input id="storage-source" type="text" placeholder="server:/export or device source" autocomplete="off">
          </div>
          <label for="minimum-free">Minimum available bytes (optional; 0 uses content size)</label>
          <input id="minimum-free" type="number" min="0" max="9007199254740991" step="1" value="0">
          <div class="settings-actions">
            <button class="button" type="submit">Save and validate</button>
            <button class="button" type="button" id="storage-refresh">Reload saved settings</button>
          </div>
        </fieldset>
      </form>
      <p id="storage-feedback" role="status" aria-live="polite">Loading storage preferences…</p>
      <h3>Saved storage status</h3>
      <dl id="storage-status" class="storage-status" aria-live="polite">
        <dt>Readiness</dt><dd id="status-ready">Not checked</dd>
        <dt>Configured root</dt><dd id="status-root">—</dd>
        <dt>Detected mount</dt><dd id="status-mount">—</dd>
        <dt>Filesystem / source</dt><dd id="status-source">—</dd>
        <dt>Total capacity</dt><dd id="status-total">—</dd>
        <dt>Available capacity</dt><dd id="status-free">—</dd>
        <dt>Write readiness (advisory)</dt><dd id="status-write">—</dd>
        <dt>Staging directory</dt><dd id="status-staging">—</dd>
        <dt>Verified library directory</dt><dd id="status-library">—</dd>
      </dl>
      <p>Readiness is advisory. Saving settings does not move or create content. Acquisitions remain disabled until safe download and recovery support is implemented.</p>
    </section>
    {% if password_change_enabled %}
    <section class="settings-panel" id="admin-password" aria-labelledby="password-title">
      <h2 id="password-title">Change administrator password</h2>
      <p>Choose a unique password of 8–256 printable non-space ASCII characters. Changing it immediately invalidates the old password. On this HTTP development site, credentials are not encrypted in transit.</p>
      <form id="password-form">
        <fieldset id="password-fields">
          <label for="current-password">Current password</label>
          <input id="current-password" type="password" autocomplete="current-password" required maxlength="256">
          <label for="new-password">New password</label>
          <input id="new-password" type="password" autocomplete="new-password" required minlength="8" maxlength="256">
          <label for="confirm-password">Confirm new password</label>
          <input id="confirm-password" type="password" autocomplete="new-password" required minlength="8" maxlength="256">
          <div class="settings-actions"><button class="button" type="submit">Change password</button></div>
        </fieldset>
      </form>
      <p id="password-feedback" role="status" aria-live="polite"></p>
    </section>
    {% endif %}
    {% else %}
    <h1>Manage offline sources</h1>
    <h2 id="sources">Content sources</h2>
    <p class="source-note">Acquisition controls are disabled until safe download and recovery support is ready.</p>
    <button class="button" type="button" id="source-add">Add Source</button>
    <button class="button" type="button" id="source-select-mode" aria-pressed="false">Select</button>
    <button class="button" type="button" id="source-guide-open">Content source guide</button>
    <p id="catalog-feedback" role="status" aria-live="polite">Candidate source metadata is not trusted or fetched.</p>
    <details class="group-panel" id="group-panel">
      <summary>Organize sources · Categories, collections &amp; tags</summary>
      <p class="source-note">Categories classify subjects, collections curate resources, and tags describe anything you choose. Select source cards below to assign a group to one or several sources.</p>
      {% set groups = (catalog|default({})).groups|default([]) %}
      <div class="editor-grid">
        <div><label for="group-kind">Grouping type</label><select id="group-kind"><option value="categories">Categories</option><option value="collections">Collections</option><option value="tags">Tags</option></select></div>
        <div><label for="group-existing">Existing group</label><select id="group-existing"><option value="">Choose a group</option>{% for group in groups|sort(attribute="name") %}<option data-kind="{{ group.kind }}" value="{{ group.group_id }}">{{ group.name }}</option>{% endfor %}</select></div>
        <div class="editor-wide"><label for="group-name">New group name / rename</label><input id="group-name" maxlength="100" autocomplete="off"></div>
      </div>
      <div class="source-actions">
        <button class="button" type="button" id="group-defaults">Add predefined categories</button>
        <button class="button" type="button" id="group-create">Create group</button>
        <button class="button" type="button" id="group-rename">Rename</button>
        <button class="button" type="button" id="group-delete">Delete group</button>
      </div>
      <div id="bulk-selection" hidden>
      <div class="source-actions">
        <button class="button" type="button" id="group-select-all">Select visible sources</button>
        <button class="button" type="button" id="group-clear">Clear selection</button>
      </div>
      <div class="source-actions" id="bulk-actions" hidden>
        <button class="button" type="button" id="bulk-publish">Publish selected</button>
        <button class="button" type="button" id="bulk-unpublish">Unpublish selected</button>
        <button class="button" type="button" id="bulk-remove">Remove selected sources</button>
        <button class="button" type="button" id="group-assign">Add selected to group</button>
        <button class="button" type="button" id="group-unassign">Remove selected from group</button>
        <button class="button" type="button" id="group-create-assign">Create tag &amp; assign</button>
      </div>
      <p id="group-count" class="source-note" aria-live="polite">0 selected</p>
      </div>
      <p id="group-feedback" role="status" aria-live="polite"></p>
    </details>
    <dialog id="source-dialog" aria-labelledby="source-dialog-title">
      <form id="source-form">
        <h3 id="source-dialog-title">Add source metadata</h3>
        <p class="source-note">Choose content to add to your offline library. Choose a PDF to install it now, or save a URL-based profile for later acquisition. Publication is separate. <a href="#source-help" id="source-guide-link">Content source help</a></p>
        <input id="catalog-id" name="source_id" type="hidden">
        <p id="catalog-id-display" class="source-note" hidden></p>
        <div class="editor-grid">
          <div class="editor-wide" id="source-upload-row"><label for="source-upload-file">Upload PDF (optional)</label><input id="source-upload-file" type="file" accept=".pdf,application/pdf"><small>Choose a PDF to populate its name and format automatically.</small></div>
          <div class="editor-wide"><label for="catalog-title">Source name</label><input id="catalog-title" name="title" required maxlength="512"></div>
          <div class="editor-wide"><label for="catalog-url">Source URL</label><input id="catalog-url" name="source_url" type="url" maxlength="512">
            <small>Direct HTTP(S) download URL, if available.</small></div>
          <div><label for="catalog-format">Content format</label><select id="catalog-format" name="format"><option value="unspecified">Auto / not yet specified</option><option value="zim">Kiwix / ZIM</option><option value="pdf">PDF</option></select></div>
          <div class="editor-wide"><label for="catalog-description">Description (optional)</label><textarea id="catalog-description" name="description" maxlength="512"></textarea></div>
        </div>
        <details id="source-advanced">
          <summary>Advanced Details</summary>
          <p class="source-note">Optional publisher-supplied metadata. These values alone do not establish verification or enable acquisition.</p>
          <div class="editor-grid">
            <div><label for="catalog-publisher">Publisher</label><input id="catalog-publisher" name="publisher" maxlength="512"></div>
            <div><label for="catalog-edition">Edition / release</label><input id="catalog-edition" name="edition" maxlength="512"></div>
            <div><label for="catalog-language">Language</label><input id="catalog-language" name="language" maxlength="512"></div>
            <div><label for="catalog-size">Expected size in bytes (candidate metadata)</label><input id="catalog-size" name="expected_size_bytes" inputmode="numeric" pattern="[1-9][0-9]{0,19}" maxlength="20"></div>
            <div class="editor-wide"><label for="catalog-sha256">Expected SHA-256 (candidate metadata)</label><input id="catalog-sha256" name="sha256" pattern="[a-fA-F0-9]{64}" maxlength="64"></div>
            <div class="editor-wide"><label for="catalog-provenance">Provenance / source of metadata</label><textarea id="catalog-provenance" name="provenance" maxlength="512"></textarea></div>
            <div class="editor-wide"><label for="catalog-license">License / rights note</label><input id="catalog-license" name="license" maxlength="512"></div>
          </div>
        </details>
        <p id="source-form-feedback" role="alert" tabindex="-1"></p>
        <div class="editor-actions"><button class="button" type="button" id="source-cancel">Cancel</button><button class="button editor-save" type="submit">Save source</button></div>
        <p class="source-note">For the full offline guide, use Content source guide on the Sources page.</p>
      </form>
    </dialog>
    <dialog id="source-guide" aria-labelledby="source-help-title">
      <section id="source-help" class="source-note" aria-labelledby="source-help-title">
  <h3 id="source-help-title">Adding offline content sources</h3>
  <p>This guide is stored with The Axiom and remains available without internet access. Finding and downloading new content generally requires connectivity.</p>
  <h4>1. Find content</h4>
  <p>For Kiwix archives, browse the <a href="https://library.kiwix.org/">Kiwix library</a> or <a href="https://download.kiwix.org/zim/">official ZIM download directory</a>. Choose your language, edition and archive size. Copy the direct .zim download link rather than the catalog or article page. For PDF documents, use the original publisher, for example <a href="https://www.ready.gov/">Ready.gov</a>, and look for a direct HTTPS PDF link. Check permission to store and distribute the material offline.</p>
  <h4>2. Add a source profile</h4>
  <p>Choose Add Source and select a local PDF to populate its title from its filename and install it in one operation. Alternatively, enter a recognizable name and optionally a direct artifact URL, confirm or select the format, optionally describe the collection, and Save source. A stable ID is generated automatically and retained when editing. A normal website URL is not a downloadable archive. Unsupported formats can be recorded but cannot be acquired or read.</p>
  <h4>3. Review advanced details</h4>
  <p>Publisher, edition and language describe the content. Expected size and SHA-256 are the exact byte count and fingerprint of the intended file. Provenance records where the information came from; license records the permission to use it. Use trustworthy publisher metadata where available. A checksum calculated from a downloaded file can identify those bytes later, but does not independently prove their origin. Saving metadata does not verify it.</p>
  <h4>4. Acquire and verify</h4>
  <p><strong>ZIM:</strong> The existing verified Wikipedia archive is supported. New ZIM profiles currently require a matching trusted acquisition manifest; arbitrary remote downloads are not yet enabled.</p>
  <p><strong>PDF:</strong> Use Download from URL for a configured HTTPS PDF link (up to three independently validated HTTPS redirects; query strings and private addresses remain unsupported), or Upload PDF to choose a file from your computer. Both support up to 16 MiB, compute missing size and SHA-256, and record provenance. A URL is optional for uploads. When publishing a PDF without a documented license, confirm you have permission to make it available to library users. Local or explicitly configured NFS storage is supported; the expected mount target and export must match.</p>
  <h4>5. Publish and read offline</h4>
  <p>After matching content is verified and its reader is ready, use Publish on the source card. Open the published collection from The Axiom homepage, even without internet connectivity. PDFs use the browser PDF viewer; PDF full-text search is not yet supported.</p>
  <h4>6. Edit or remove</h4>
  <p>Edit display details without changing the stable ID. Unpublish before changing the artifact identity. Removing a published profile automatically unpublishes it and does not delete installed files. Changing the URL, size or checksum does not transfer verification to a different artifact. Active or unresolved acquisitions may block editing.</p>
</section>
      <form method="dialog"><button class="button">Close guide</button></form>
    </dialog>
    <section class="source-filters" aria-label="Filter and sort sources">
      <div class="editor-grid">
        <div class="editor-wide"><label for="source-filter-search">Search source names</label><input id="source-filter-search" type="search" placeholder="Search sources…" maxlength="512"></div>
        <div><label for="source-filter-publication">Publication</label><select id="source-filter-publication"><option value="">All</option><option value="published">Published</option><option value="unpublished">Unpublished</option><option value="unknown">Unknown</option></select></div>
        <div><label for="source-filter-download">Download</label><select id="source-filter-download"><option value="">All</option><option value="downloaded">Downloaded</option><option value="not-downloaded">Not downloaded</option><option value="unknown">Unknown / unverified</option></select></div>
        <div><label for="source-filter-format">Format</label><select id="source-filter-format"><option value="">All formats</option>{% for source_format in (catalog|default({})).sources|default([])|map(attribute="configuration.format")|unique|sort %}<option value="{{ source_format }}">{{ source_format|upper }}</option>{% endfor %}</select></div>
        {% for kind,label in [("categories","Category"),("collections","Collection"),("tags","Tag")] %}
        <div><label for="source-filter-{{ kind }}">{{ label }}</label><select id="source-filter-{{ kind }}"><option value="">All</option>{% for group in groups|selectattr("kind","equalto",kind)|sort(attribute="name") %}<option value="{{ group.group_id }}">{{ group.name }}</option>{% endfor %}</select></div>
        {% endfor %}
        <div><label for="source-filter-sort">Sort by</label><select id="source-filter-sort"><option value="status">Published, downloaded, then rest</option><option value="alpha">Name A–Z</option></select></div>
      </div>
      <div class="source-actions"><button class="button" type="button" id="source-filter-reset">Clear filters</button><button class="button" type="button" id="source-filter-reorder">Refresh order</button></div>
      <p id="source-filter-count" class="source-note" role="status"></p>
    </section>
    <p id="source-filter-empty" class="empty" hidden>No sources match the selected filters.</p>
    <div id="source-cards">
    {% for source in (catalog|default({})).sources|default([]) %}
      {% set pub = source.publication %}
      {% set publication_label = 'Publication status unavailable' if pub.error else 'Published · available in library' if pub.published else 'Enabled · reader unavailable' if pub.enabled else 'Unpublished · ready to publish' if pub.serving else 'Unpublished · ' + pub.publication_reason if pub.publication_reason else 'Unpublished · reader not ready' %}
      <details class="source-card" data-source-id="{{ source.source_id }}" data-filter-title="{{ source.profile.title }}" data-filter-format="{{ source.configuration.format }}" data-filter-publication="{{ source.publication_filter|default('unknown') }}" data-filter-download="{{ source.download_filter|default('unknown') }}"{% for name in editable_fields %} data-catalog-{{ name|replace('_', '-') }}="{{ source.profile.get(name, source.configuration.get(name, '')) }}"{% endfor %}>
        <summary class="source-header">
          <label class="group-select" hidden><input type="checkbox" data-group-select value="{{ source.source_id }}" aria-label="Select {{ source.profile.title }} for grouping">Select</label>
          <div>
            <h3>{{ source.profile.title }}</h3>
            <p class="source-subtitle">{{ source.configuration.format }}{% if source.profile.description %} · {{ source.profile.description }}{% endif %}</p>
            {% for kind in ["categories", "collections", "tags"] %}{% set memberships = [] %}{% for group in groups if group.kind == kind and source.source_id in group.source_ids %}{% set _ = memberships.append(group.name) %}{% endfor %}{% if memberships %}<p class="group-membership">{{ kind|capitalize }}: {{ memberships|sort|join(", ") }}</p>{% endif %}{% endfor %}
            {% if pub %}<span class="compact-publication" data-field="publication-summary">{{ publication_label }}</span>{% endif %}
          </div>
          <span class="badge" data-field="status" role="status">{% if source.adapter == 'pdf' %}{% if source.installed_verified and source.artifact %}{{ source.artifact.bytes | filesizeformat(true) }}{% else %}PDF not installed or invalid{% endif %}{% elif source.installed_verified and source.artifact %}{{ source.artifact.bytes | filesizeformat(true) }}{% elif not source.artifact and not source.mutation_blocked %}Not downloaded{% elif catalog.acquisition_stale %}Status unavailable{% elif not source.artifact %}Acquisition unresolved{% else %}Waiting for status…{% endif %}</span>
        </summary>
        <div class="source-expanded">
        <div class="source-live">
          <p data-field="metrics" hidden></p>
          <progress data-field="transfer" max="100" value="0" aria-label="Archive download progress" hidden></progress>
          <p data-field="verification-label" hidden>Checksum verification in progress — percentage unavailable.</p>
          <progress data-field="verification" aria-label="Checksum verification in progress" hidden></progress>
          <p class="source-note" data-field="rate" hidden></p>
          <p data-field="detail" class="source-note" hidden></p>
        </div>
        {% if source.actions %}
        <div class="source-actions" aria-label="Acquisition controls">
          {% for action in source.actions %}
          <button class="button" type="button" data-action="{{ action }}" disabled>{{ action_labels[action] }}</button>
          {% endfor %}
        </div>
        {% endif %}
        {% if source.adapter == 'pdf' and not pub.enabled %}
        <div class="source-actions" aria-label="PDF acquisition">
          {% if source.pdf_download and not pub.enabled %}<button class="button" type="button" data-pdf-download>Download from URL</button>{% endif %}
          <button class="button" type="button" data-pdf-upload>Upload PDF</button>
          <input type="file" accept=".pdf,application/pdf" data-pdf-file hidden aria-label="Choose PDF file">
          <span data-pdf-feedback role="status"></span>
        </div>
        {% endif %}
        {% if pub %}
        <div class="source-actions" aria-label="Publication controls">
          <button class="button" type="button" data-field="publication-toggle" data-enabled="{{ 'true' if pub.enabled else 'false' }}" data-acknowledge-rights="{{ 'true' if pub.requires_rights_acknowledgement else 'false' }}"{% if not pub.enabled and ((not pub.serving and not pub.requires_rights_acknowledgement) or source.mutation_blocked) %} disabled{% endif %}>{{ 'Unpublish' if pub.enabled else 'Publish' }}</button>
          <a class="button" data-field="publication-browse" href="{{ pub.entry_path }}"{% if not pub.published %} hidden{% endif %}>Browse</a>
          <span data-field="publication-status" role="status">{{ publication_label }}</span>
        </div>
        {% endif %}
        <div class="source-actions" aria-label="Profile controls">
          <button class="button" type="button" data-catalog-edit="{{ source.source_id }}"{% if source.mutation_blocked or pub.error %} disabled{% endif %}>Edit</button>
          <button class="button" type="button" data-catalog-remove="{{ source.source_id }}"{% if source.mutation_blocked or pub.error %} disabled{% endif %}>Remove</button>
          <span class="source-note" data-field="mutation-note">{% if pub.enabled %}Unpublish before changing artifact configuration.{% elif source.mutation_blocked %}Acquisition active or unresolved; changes are blocked.{% endif %}</span>
        </div>
        <section aria-label="Source details">
          <h4>Source details</h4>
          <p class="source-note" data-field="acquisition-reason">{{ source.acquisition_reason }}</p>
          <dl class="storage-status source-details">
            {% for name in ('publisher', 'edition', 'language') %}
            <dt>{{ name|capitalize }}</dt><dd>{{ source.profile.get(name) or '—' }}</dd>
            {% endfor %}
            <dt>Candidate URL</dt><dd>{{ source.configuration.source_url or '—' }}</dd>
            <dt>Candidate size (bytes)</dt><dd>{{ source.configuration.expected_size_bytes or '—' }}</dd>
            <dt>Candidate SHA-256</dt><dd>{{ source.configuration.sha256 or '—' }}</dd>
            <dt>Candidate provenance</dt><dd>{{ source.configuration.provenance or '—' }}</dd>
            <dt>Candidate license</dt><dd>{{ source.configuration.license or '—' }}</dd>
            {% if source.artifact and source.adapter != 'pdf' %}
            <dt>Pinned archive filename</dt><dd>{{ source.artifact.filename }}</dd>
            <dt>Pinned archive size (bytes)</dt><dd>{{ source.artifact.bytes }}</dd>
            <dt>Pinned archive SHA-256</dt><dd>{{ source.artifact.sha256 }}</dd>
            {% endif %}
            <dt>Installed verification</dt><dd data-field="verified">{{ ('PDF pin verified' if source.adapter == 'pdf' else 'Confirmed by acquisition service') if pub and pub.verified else 'Not confirmed' }}</dd>
            <dt>Last sample</dt><dd data-field="sample">—</dd>
          </dl>
        </section>
        </div>
      </details>
    {% else %}
      <p class="empty">No managed sources configured.</p>
    {% endfor %}
    </div>
    {% endif %}
  </main>
  {% if page == "sources" %}
  <script id="source-catalog-script">
    (() => {
      const feedback = document.getElementById('catalog-feedback');
      const revision = {{ (catalog|default({})).revision|default(none)|tojson }};
      const stateKey = 'theaxiom-source-view';
      try {
        const saved = JSON.parse(sessionStorage.getItem(stateKey) || 'null');
        sessionStorage.removeItem(stateKey);
        if (saved) {
          document.querySelectorAll('.source-card').forEach(card => {
            card.open = saved.open.includes(card.dataset.sourceId);
          });
          document.querySelectorAll("[data-group-select]").forEach(item => { item.checked = (saved.selected || []).includes(item.value); });
          document.getElementById("group-panel").open = !!saved.groupsOpen;
          document.getElementById("source-select-mode").setAttribute("aria-pressed", String(!!saved.selecting));
          requestAnimationFrame(() => window.scrollTo(0, saved.scroll));
        }
      } catch (_) { /* Storage may be disabled. */ }
      function reloadSources() {
        try {
          sessionStorage.setItem(stateKey, JSON.stringify({
            open: Array.from(document.querySelectorAll('.source-card[open]'), card => card.dataset.sourceId),
            scroll: window.scrollY,
            selected: Array.from(document.querySelectorAll("[data-group-select]:checked"), item => item.value),
            groupsOpen: document.getElementById("group-panel").open,
            selecting: document.getElementById("source-select-mode").getAttribute("aria-pressed") === "true",
            filters: window.axiomSourceFilters?.values()
          }));
        } catch (_) { /* Reload remains available without session storage. */ }
        window.location.reload();
      }

      const groupKind = document.getElementById('group-kind');
      const groupExisting = document.getElementById('group-existing');
      const groupName = document.getElementById('group-name');
      const groupFeedback = document.getElementById('group-feedback');
      const groupChecks = Array.from(document.querySelectorAll('[data-group-select]'));
      const groupButtons = Array.from(document.querySelectorAll('#group-panel button'));
      const selectMode = document.getElementById('source-select-mode');
      let selecting = selectMode.getAttribute('aria-pressed') === 'true';
      let bulkBusy = false;
      const selectedIds = () => selecting ? groupChecks.filter(item => item.checked).map(item => item.value) : [];
      function selectionMode() {
        selectMode.textContent = selecting ? 'Cancel selection' : 'Select';
        selectMode.setAttribute('aria-pressed', String(selecting));
        groupChecks.forEach(item => {
          item.closest('.group-select').hidden = !selecting;
          if (!selecting) item.checked = false;
        });
        document.getElementById('bulk-selection').hidden = !selecting;
        if (selecting) document.getElementById('group-panel').open = true;
        groupControls();
      }
      selectMode.addEventListener('click', () => {
        if (bulkBusy) return;
        selecting = !selecting;
        selectionMode();
      });
      function groupControls() {
        const kind = groupKind.value, ids = selectedIds();
        document.getElementById('bulk-actions').hidden = !ids.length;
        for (const id of ['bulk-publish','bulk-unpublish','bulk-remove']) document.getElementById(id).disabled = bulkBusy || !ids.length;
        for (const option of groupExisting.options) {
          option.hidden = !!option.dataset.kind && option.dataset.kind !== kind;
          option.disabled = option.hidden;
        }
        if (groupExisting.selectedOptions[0]?.disabled) groupExisting.value = '';
        document.getElementById('group-count').textContent = ids.length + ' selected (' + groupChecks.filter(item => item.checked && item.closest('.source-card').hidden).length + ' hidden by filters)';
        document.getElementById('group-defaults').hidden = kind !== 'categories' ||
          Array.from(groupExisting.options).some(option => option.dataset.kind === 'categories');
        document.getElementById('group-create-assign').hidden = kind !== 'tags';
        for (const action of ['rename','delete','assign','unassign']) {
          document.getElementById('group-' + action).disabled = !groupExisting.value ||
            (['assign','unassign'].includes(action) && !ids.length);
        }
        document.getElementById('group-create-assign').disabled = !ids.length;
      }
      groupChecks.forEach(item => {
        item.addEventListener('click', event => event.stopPropagation());
        item.addEventListener('change', groupControls);
      });
      groupKind.addEventListener('change', () => { groupExisting.value = ''; groupControls(); });
      groupExisting.addEventListener('change', groupControls);
      document.getElementById('group-select-all').addEventListener('click', () => {
        groupChecks.forEach(item => { if (!item.closest('.source-card').hidden) item.checked = true; });
        groupControls();
      });
      document.getElementById('group-clear').addEventListener('click', () => {
        groupChecks.forEach(item => { item.checked = false; });
        groupControls();
      });
      function groupId() {
        const base = groupName.value.normalize('NFKD').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0,50).replace(/-$/,'') || 'group';
        const used = new Set(Array.from(groupExisting.options).filter(o => o.dataset.kind === groupKind.value).map(o => o.value));
        let id = base;
        for (let n = 2; used.has(id); n++) id = base + '-' + n;
        return id;
      }
      async function groupPost(payload, currentRevision) {
        const response = await fetch('/api/groups', {method:'POST', headers:{'Content-Type':'application/json'},
          body:JSON.stringify({...payload, revision:currentRevision})});
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'Group change failed');
        return result;
      }
      async function groupChange(operation) {
        const kind = groupKind.value, ids = selectedIds(), name = groupName.value.trim();
        let payload = {operation, kind, group_id:groupExisting.value};
        if (operation === 'create' || operation === 'create-assign') {
          if (!name) { groupFeedback.textContent = 'Enter a group name.'; return; }
          payload = {operation:'create', kind, group_id:groupId(), name};
        } else if (operation === 'initialize-categories') payload = {operation, kind:'categories', group_id:'defaults'};
        else if (operation === 'rename') {
          if (!name) { groupFeedback.textContent = 'Enter a new name.'; return; }
          payload.name = name;
        } else if (operation === 'delete') {
          if (!window.confirm('Delete this group? Sources and installed files will be retained.')) return;
        } else payload.source_ids = ids;
        groupButtons.forEach(button => { button.disabled = true; });
        try {
          const result = await groupPost(payload, revision);
          if (operation === 'create-assign') {
            try {
              await groupPost({operation:'add-members',kind,group_id:payload.group_id,source_ids:ids}, result.revision);
            } catch (error) {
              window.alert('Tag created, but assignment failed. Reload and select the tag to retry: ' + error.message);
            }
          }
          reloadSources();
        } catch (error) { groupFeedback.textContent = error.message; }
        finally { groupButtons.forEach(button => { button.disabled = false; }); groupControls(); }
      }
      for (const [id, operation] of Object.entries({
        defaults:'initialize-categories',create:'create',rename:'rename',delete:'delete',
        assign:'add-members',unassign:'remove-members','create-assign':'create-assign'
      })) document.getElementById('group-' + id).addEventListener('click', () => groupChange(operation));
      document.addEventListener("axiom-source-filters-changed", groupControls);
      selectionMode();
      async function bulkLifecycle(action) {
        if (bulkBusy) return;
        const ids = selectedIds();
        if (!ids.length) return;
        const verb = action === 'remove' ? 'Remove' : action === 'publish' ? 'Publish' : 'Unpublish';
        const suffix = action === 'remove' ? ' Catalog entries will be removed and unpublished; installed files will not be deleted.' : action === 'publish' ? ' Only eligible sources with existing rights approval can be published.' : ' Installed files will be retained.';
        if (!window.confirm(verb + ' ' + ids.length + ' selected sources?' + suffix)) return;
        bulkBusy = true;
        selectMode.disabled = true;
        groupChecks.forEach(item => item.disabled = true);
        groupButtons.forEach(button => button.disabled = true);
        let currentRevision = revision;
        const results = [];
        try {
          for (const source_id of ids) {
            const card = groupChecks.find(item => item.value === source_id).closest('.source-card');
            const title = card.dataset.filterTitle || source_id;
            try {
              const removing = action === 'remove';
              const payload = removing ? {operation:'remove', source_id, fields:{}, revision:currentRevision}
                : {source_id, enabled:action === 'publish', revision:currentRevision};
              const response = await fetch(removing ? '/api/sources' : '/api/publication', {
                method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(payload)});
              const result = await response.json();
              if (!response.ok) {
                results.push(title + ': ' + (result.error || 'HTTP ' + response.status));
                if (response.status === 409 && /revision changed/i.test(result.error || '')) {
                  results.push('Stopped: catalog changed; reload before acting on remaining sources.');
                  break;
                }
                continue;
              }
              if (removing) {
                if (!Number.isInteger(result.revision)) throw new Error('Missing updated catalog revision');
                currentRevision = result.revision;
              }
              results.push(title + ': success');
            } catch (error) {
              results.push(title + ': outcome uncertain — ' + error.message);
              results.push('Stopped; reload to verify remaining sources.');
              break;
            }
          }
          window.alert(results.join('\n'));
          reloadSources();
        } finally {
          bulkBusy = false;
          selectMode.disabled = false;
          groupChecks.forEach(item => item.disabled = false);
          groupButtons.forEach(button => button.disabled = false);
          groupControls();
        }
      }
      for (const action of ['publish','unpublish','remove'])
        document.getElementById('bulk-' + action).addEventListener('click', () => bulkLifecycle(action));
      const dialog = document.getElementById('source-dialog');
      const form = document.getElementById('source-form');
      const guide = document.getElementById('source-guide');
      document.getElementById('source-guide-open').addEventListener('click', () => guide.showModal());
      document.getElementById('source-guide-link').addEventListener('click', event => {
        event.preventDefault();
        guide.showModal();
      });
      const input = name => form.elements.namedItem(name);
      const formFeedback = document.getElementById('source-form-feedback');
      const fieldsToEdit = Array.from(form.querySelectorAll('[name]:not([name="source_id"])'));
      const advanced = document.getElementById('source-advanced');
      const format = input('format');
      const idDisplay = document.getElementById('catalog-id-display');
      let manualFormat = false;
      const uploadFile = document.getElementById("source-upload-file");
      let automaticTitle = false;
      input("title").addEventListener("input", () => { automaticTitle = false; });
      uploadFile.addEventListener("change", () => {
        const file = uploadFile.files[0];
        if (!file) return;
        const title = file.name.replace(/\.pdf$/i, "").replace(/[_-]+/g, " ").replace(/\s+/g, " ").trim();
        if (!input("title").value.trim() || automaticTitle) {
          input("title").value = title.slice(0, 512) || "Untitled PDF";
          automaticTitle = true;
        }
        format.value = "pdf";
        manualFormat = true;
      });
      function detectFormat() {
        if (manualFormat) return;
        try {
          const path = new URL(input('source_url').value).pathname.toLowerCase();
          format.value = path.endsWith('.zim') ? 'zim' : path.endsWith('.pdf') ? 'pdf' : 'unspecified';
        } catch (_) { format.value = 'unspecified'; }
      }
      input('source_url').addEventListener('input', detectFormat);
      format.addEventListener('change', () => { manualFormat = true; });
      function generateId() {
        const base = input('title').value.normalize('NFKD').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 50).replace(/-$/,'') || 'source';
        const used = new Set(Array.from(document.querySelectorAll('.source-card'), card => card.dataset.sourceId));
        let id = base;
        for (let n = 2; used.has(id); n++) id = base + '-' + n;
        return id;
      }
      function openForm(operation, card = null) {
        form.reset();
        automaticTitle = false;
        document.getElementById('source-upload-row').hidden = !!card;
        uploadFile.disabled = !!card;
        formFeedback.textContent = '';
        advanced.open = false;
        format.querySelectorAll('[data-legacy-format]').forEach(option => option.remove());
        manualFormat = !!card;
        idDisplay.hidden = !card;
        idDisplay.textContent = card ? 'Stable ID: ' + card.dataset.sourceId : '';
        document.getElementById('source-dialog-title').textContent = card ? 'Edit source profile' : 'Add source profile';
        form.dataset.operation = operation;
        if (card) {
          input('source_id').value = card.dataset.sourceId;
          for (const field of fieldsToEdit) {
            const value = card.getAttribute('data-catalog-' + field.name.replaceAll('_', '-')) || '';
            if (field === format && value && !Array.from(format.options).some(option => option.value === value)) {
              const option = new Option(value + ' (existing format)', value);
              option.dataset.legacyFormat = 'true';
              format.add(option);
            }
            field.value = value;
          }
        }
        dialog.showModal();
        input('title').focus();
      }
      async function change(operation, source_id, fields) {
        if (revision === null) throw new Error('Catalog revision unavailable');
        const response = await fetch('/api/sources', {method:'POST', headers:{'Content-Type':'application/json'},
          body:JSON.stringify({operation, source_id, fields, revision})});
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'Catalog update failed');
        reloadSources();
      }
      document.getElementById('source-add').addEventListener('click', () => openForm('add'));
      document.getElementById('source-cancel').addEventListener('click', () => dialog.close());
      form.addEventListener('invalid', event => {
        if (advanced.contains(event.target)) advanced.open = true;
      }, true);
      form.addEventListener('submit', async event => {
        event.preventDefault();
        const source_id = form.dataset.operation === 'add' ? generateId() : input('source_id').value;
        const fields = Object.fromEntries(fieldsToEdit.map(field => [field.name, field.value]));
        const save = form.querySelector('[type="submit"]');
        save.disabled = true;
        try {
          const file = uploadFile.files[0];
          if (form.dataset.operation === 'add' && file) {
            if (!file.size || file.size > 16 * 1024 * 1024) throw new Error('Choose a PDF up to 16 MiB');
            const metadata = Object.fromEntries(Object.entries(fields).filter(([k]) => ['title','description','publisher','edition','language','source_url','license'].includes(k)));
            const headers = {'Content-Type':'application/pdf', 'X-Source-ID':source_id,
              'X-Catalog-Revision':String(revision), 'X-PDF-Add':'1',
              'X-PDF-Metadata':encodeURIComponent(JSON.stringify(metadata))};
            if (automaticTitle) headers['X-PDF-Auto-Title'] = '1';
            const response = await fetch('/api/pdf-upload', {method:'POST', headers, body:file});
            const result = await response.json().catch(() => ({}));
            if (!response.ok || !result.installed_verified) throw new Error(result.error || 'PDF upload failed (HTTP ' + response.status + ')');
            reloadSources();
          } else { await change(form.dataset.operation, source_id, fields); }
        }
        catch (error) { formFeedback.textContent = error.message; formFeedback.focus(); }
        finally { save.disabled = false; }
      });
      document.querySelectorAll('[data-catalog-edit]').forEach(button => button.addEventListener('click', () => {
        openForm('edit', button.closest('.source-card'));
      }));
      document.querySelectorAll('[data-catalog-remove]').forEach(button => button.addEventListener('click', async () => {
        const source_id = button.dataset.catalogRemove;
        if (!window.confirm('Remove this source? It will be unpublished automatically. Installed files will not be deleted.')) return;
        try { await change('remove', source_id, {}); }
        catch (error) { feedback.textContent = error.message; }
      }));
      {% if catalog.sources | selectattr('adapter', 'equalto', 'pdf') | list %}
      async function acquirePDF(card, file = null) {
        const feedback = card.querySelector('[data-pdf-feedback]');
        const buttons = card.querySelectorAll('[data-pdf-download], [data-pdf-upload]');
        if (file && (!file.size || file.size > 16 * 1024 * 1024)) {
          feedback.textContent = 'Choose a PDF file between 1 byte and 16 MiB.';
          return;
        }
        buttons.forEach(button => button.disabled = true);
        feedback.textContent = file ? 'Uploading and verifying PDF…' : 'Downloading and verifying PDF…';
        try {
          const response = file
            ? await fetch('/api/pdf-upload', {method:'POST', headers:{'Content-Type':'application/pdf',
                'X-Source-ID':card.dataset.sourceId, 'X-Catalog-Revision':String(revision)}, body:file})
            : await fetch('/api/action', {method:'POST', headers:{'Content-Type':'application/json'},
                body:JSON.stringify({source_id:card.dataset.sourceId, action:'pdf-download', revision})});
          const result = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(result.error || 'PDF acquisition failed (HTTP ' + response.status + ')');
          if (!result.installed_verified) throw new Error('PDF installation was not confirmed');
          reloadSources();
        } catch (error) {
          feedback.textContent = error.message;
        } finally {
          buttons.forEach(button => button.disabled = false);
        }
      }
      document.querySelectorAll('[data-pdf-download]').forEach(button => button.addEventListener('click', () => {
        acquirePDF(button.closest('.source-card'));
      }));
      document.querySelectorAll('[data-pdf-upload]').forEach(button => button.addEventListener('click', () => {
        button.closest('.source-card').querySelector('[data-pdf-file]').click();
      }));
      document.querySelectorAll('[data-pdf-file]').forEach(input => input.addEventListener('change', () => {
        const file = input.files[0];
        input.value = '';
        if (file) acquirePDF(input.closest('.source-card'), file);
      }));
      {% endif %}
      document.querySelectorAll('[data-field="publication-toggle"]').forEach(button => button.addEventListener('click', async () => {
        const enabled = button.dataset.enabled !== 'true';
        const acknowledge = enabled && button.dataset.acknowledgeRights === 'true';
        if (acknowledge && !window.confirm("Publish this PDF to library users? Confirm that you have permission to make it available in this library.")) return;
        button.dataset.posting = 'true';
        button.disabled = true;
        try {
          const payload = {source_id:button.closest('.source-card').dataset.sourceId, enabled, revision};
          if (acknowledge) payload.acknowledge_rights = true;
          const response = await fetch('/api/publication', {method:'POST', headers:{'Content-Type':'application/json'},
            body:JSON.stringify(payload)});
          if (!response.ok) throw new Error((await response.json()).error || 'Publication failed');
          reloadSources();
        } catch (error) {
          window.alert(error.message);
          delete button.dataset.posting;
        }
      }));
    })();
  </script>

  <script id="source-filter-script">
    (() => {
      const fields = ['search','publication','download','format','categories','collections','tags','sort'];
      const nodes = Object.fromEntries(fields.map(key => [key, document.getElementById('source-filter-' + key)]));
      const root = document.getElementById('source-cards');
      const cards = Array.from(root.querySelectorAll('.source-card'));
      const groups = {{ ((catalog|default({})).groups|default([]))|tojson }};
      const values = () => Object.fromEntries(fields.map(key => [key,nodes[key].value]));
      const defaults = {sort:'status'};
      function rank(card) {
        return card.dataset.filterPublication === 'published' ? 0 : card.dataset.filterDownload === 'downloaded' ? 1 : 2;
      }
      function apply(reorder = false) {
        const v = values(), query = v.search.trim().toLocaleLowerCase();
        let visible = 0;
        for (const card of cards) {
          const data = card.dataset;
          const matches = (!query || data.filterTitle.toLocaleLowerCase().includes(query)) &&
            (!v.publication || data.filterPublication === v.publication) &&
            (!v.download || data.filterDownload === v.download) &&
            (!v.format || data.filterFormat === v.format) &&
            ['categories','collections','tags'].every(kind => !v[kind] ||
              groups.some(g => g.kind === kind && g.group_id === v[kind] && g.source_ids.includes(data.sourceId)));
          card.hidden = !matches;
          if (matches) visible++;
        }
        if (reorder) {
          cards.sort((a,b) => (v.sort === 'alpha' ? 0 : rank(a)-rank(b)) ||
            a.dataset.filterTitle.localeCompare(b.dataset.filterTitle, undefined, {sensitivity:'base'}) ||
            a.dataset.sourceId.localeCompare(b.dataset.sourceId));
          for (const card of cards) root.appendChild(card);
        }
        const count = document.getElementById('source-filter-count');
        count.textContent = visible + ' of ' + cards.length + ' sources';
        document.getElementById('source-filter-empty').hidden = visible !== 0 || cards.length === 0;
        document.dispatchEvent(new Event('axiom-source-filters-changed'));
      }
      const storageKey = 'theaxiom-source-filters';
      try {
        const saved = JSON.parse(sessionStorage.getItem(storageKey) || '{}');
        for (const key of fields) if (typeof saved[key] === 'string') {
          nodes[key].value = saved[key];
          if (key === 'sort' && !nodes[key].value) nodes[key].value = 'status';
        }
      } catch (_) { /* Filtering still works without storage. */ }
      function save() {
        try { sessionStorage.setItem(storageKey, JSON.stringify(values())); } catch (_) {}
      }
      fields.forEach(key => nodes[key].addEventListener(key === 'search' ? 'input' : 'change', () => {
        save(); apply(key === 'sort');
      }));
      document.getElementById('source-filter-reset').addEventListener('click', () => {
        fields.forEach(key => { nodes[key].value = defaults[key] || ''; });
        save(); apply(true);
      });
      document.getElementById('source-filter-reorder').addEventListener('click', () => apply(true));
      window.axiomSourceFilters = {values, apply};
      apply(true);
    })();
  </script>
  <script id="acquisition-monitor-script">
    (() => {
      const cards = Array.from(document.querySelectorAll('.source-card[data-source-id]'));
      if (!cards.length) return;
      const revision = {{ (catalog|default({})).revision|default(none)|tojson }};
      const labels = {downloading: 'Downloading', verifying: 'Verifying checksum',
        publishing: 'Promoting / verifying final file', completed: 'Acquisition completed',
        retrying: 'Waiting to retry', failed: 'Failed', interrupted: 'Interrupted',
        not_started: 'Not downloaded', unavailable: 'Service not installed', unknown: 'Status unknown'};
      const gib = bytes => (bytes / 1073741824).toFixed(2) + ' GiB';
      function size(bytes) {
        if (!Number.isFinite(bytes) || bytes < 0) return 'Installed';
        const units = ['B', 'KiB', 'MiB', 'GiB', 'TiB'];
        let i = 0;
        while (bytes >= 1024 && i < units.length - 1) { bytes /= 1024; i++; }
        return bytes.toFixed(i ? 1 : 0) + ' ' + units[i];
      }
      function render(card, job, stale, unavailable = false) {
        const field = name => card.querySelector('[data-field="' + name + '"]');
        const put = (name, value) => {
          const node = field(name);
          node.textContent = value;
          node.hidden = !value;
        };
        const verified = !stale && job?.state === 'completed' && job.verified === true && job.active === false;
        const status = unavailable ? 'Status unavailable' : stale ? 'Stale sample — status unknown' :
          !job ? 'Waiting for status' : verified ? size(job.expected_bytes) : (labels[job.state] || 'Status unknown');
        put('status', status);
        field('status').className = 'badge' + (!stale && job?.state === 'completed' && job.verified === true ?
          ' enabled' : !stale && job?.state === 'failed' ? ' disabled' : '');
        const progress = field('transfer');
        const valid = Number.isFinite(job?.downloaded_bytes) && job.downloaded_bytes >= 0 &&
          Number.isFinite(job.expected_bytes) && job.expected_bytes > 0 && job.downloaded_bytes <= job.expected_bytes;
        progress.hidden = !valid;
        progress.value = valid ? 100 * job.downloaded_bytes / job.expected_bytes : 0;
        put('metrics', valid ? (stale ? 'Last observed download: ' : 'Download: ') +
          progress.value.toFixed(2) + '% · ' + gib(job.downloaded_bytes) + ' / ' + gib(job.expected_bytes) : '');
        const checking = !stale && (job?.state === 'verifying' || job?.state === 'publishing');
        const verify = field('verification');
        verify.hidden = !checking;
        const measured = checking && job.state === 'verifying' &&
          Number.isFinite(job.checksum_bytes) && job.checksum_bytes >= 0 &&
          Number.isFinite(job.expected_bytes) && job.expected_bytes > 0 &&
          job.checksum_bytes <= job.expected_bytes;
        const pass = measured && Number.isInteger(job.checksum_pass) &&
          Number.isInteger(job.checksum_passes) && job.checksum_pass > 0 &&
          job.checksum_pass <= job.checksum_passes ?
          ' pass ' + job.checksum_pass + ' of ' + job.checksum_passes : '';
        if (measured) {
          verify.max = 100;
          verify.value = 100 * job.checksum_bytes / job.expected_bytes;
        } else {
          verify.removeAttribute('value');
        }
        put('verification-label', checking ? (measured ?
          'Checksum' + pass + ' verification in progress — ' + verify.value.toFixed(1) +
          '% read (estimated; digest not yet confirmed).' :
          'Checksum / publishing in progress — percentage unavailable.') : '');
        const rate = !stale && job?.state === 'downloading' && job.speed_bytes_per_second > 0 ?
          (job.speed_bytes_per_second / 1048576).toFixed(2) + ' MiB/s' +
          (Number.isFinite(job.eta_seconds) ? ' · ' + Math.ceil(job.eta_seconds / 60) + ' min remaining (transfer only)' : '') : '';
        put('rate', rate);
        put('detail', job?.detail || '');
        put('verified', verified ? 'Confirmed by acquisition service' : 'Not confirmed');
        put('sample', Number.isFinite(job?.sampled_at) ? new Date(job.sampled_at * 1000).toLocaleString() : '—');
      }
      function controls(card, source) {
        const field = name => card.querySelector('[data-field="' + name + '"]');
        const pub = source?.publication;
        const blocked = source?.mutation_blocked !== false || !!pub?.error;
        card.querySelector('[data-catalog-edit]').disabled = blocked;
        card.querySelector('[data-catalog-remove]').disabled = blocked;
        field('mutation-note').textContent = pub?.enabled ? 'Unpublish before changing artifact configuration.' :
          blocked ? 'Acquisition or publication status unresolved; changes are blocked.' : '';
        const toggle = field('publication-toggle');
        if (!toggle || toggle.dataset.posting === 'true') return;
        toggle.dataset.enabled = String(!!pub?.enabled);
        toggle.textContent = pub?.enabled ? 'Unpublish' : 'Publish';
        toggle.dataset.acknowledgeRights = String(!!pub?.requires_rights_acknowledgement);
        toggle.disabled = !pub?.enabled && (blocked || !(pub?.serving || pub?.requires_rights_acknowledgement));
        field('publication-browse').hidden = !pub?.published;
        field('publication-summary').textContent = field('publication-status').textContent =
          !pub || pub.error ? 'Publication status unavailable' : pub.published ? 'Published · available in library' :
          pub.enabled ? 'Enabled · reader unavailable' : pub.serving ? 'Unpublished · ready to publish' : pub.publication_reason ? 'Unpublished · ' + pub.publication_reason : 'Unpublished · reader not ready';
      }
      async function refresh() {
        const controller = new AbortController();
        const timer = window.setTimeout(() => controller.abort(), 5000);
        try {
          const response = await fetch('/api/sources', {cache: 'no-store', signal: controller.signal});
          if (!response.ok) throw new Error('Status unavailable');
          const data = await response.json();
          if (data.revision !== revision) {
            document.getElementById('catalog-feedback').textContent = 'Source profiles changed. Reload to see the latest catalog.';
            throw new Error('Catalog revision changed');
          }
          const sources = new Map(data.sources.map(source => [source.source_id, source]));
          cards.forEach(card => {
            const source = sources.get(card.dataset.sourceId);
            if (source?.adapter === 'pdf') {
              card.querySelector('[data-field="status"]').textContent = source.installed_verified ? size(source.artifact?.bytes) : 'PDF not installed or invalid';
              card.querySelector('[data-field="verified"]').textContent = source.installed_verified ? 'PDF pin verified' : 'Not confirmed';
            } else if (source?.artifact) render(card, source.acquisition, data.acquisition_stale !== false);
            else card.querySelector('[data-field="status"]').textContent = data.acquisition_stale ? 'Status unavailable' :
              source?.mutation_blocked !== false ? 'Acquisition unresolved' : 'Not downloaded';
            controls(card, source);
            card.dataset.filterPublication = source?.publication_filter || "unknown";
            card.dataset.filterDownload = source?.download_filter || "unknown";
          });
          window.axiomSourceFilters?.apply(false);
        } catch (_) {
          cards.forEach(card => {
            if (card.querySelector('[data-action="download"]')) render(card, null, true, true);
            else card.querySelector('[data-field="status"]').textContent = 'Status unavailable';
            controls(card, null);
            card.dataset.filterPublication = "unknown";
            card.dataset.filterDownload = "unknown";
          });
          window.axiomSourceFilters?.apply(false);
        } finally {
          window.clearTimeout(timer);
          window.setTimeout(refresh, 2000);
        }
      }
      refresh();
    })();
  </script>

  {% else %}
  <script id="storage-settings-script">
    (() => {
      const byId = (id) => document.getElementById(id);
      const form = byId('storage-form');
      const fields = byId('storage-fields');
      const feedback = byId('storage-feedback');
      const root = byId('storage-root');
      const mode = byId('storage-mode');
      const mount = byId('storage-mount');
      const source = byId('storage-source');
      const minimum = byId('minimum-free');
      const errors = {
        storage_not_configured: 'Choose and save a storage root first.',
        required_mount_missing_or_replaced: 'The expected filesystem is missing or has been replaced.',
        read_only_filesystem: 'The filesystem is read-only.',
        nested_or_replaced_mount: 'A managed directory is on an unexpected mount.',
        storage_root_missing: 'The storage root does not exist.',
        symlink_not_allowed: 'Symbolic links are not allowed in managed paths.',
        storage_path_not_directory: 'A storage path is not a directory.',
        storage_not_writable: 'The application cannot write to the selected directory.',
        insufficient_capacity: 'Not enough free space for the configured minimum or selected content.',
        mount_changed_during_inspection: 'The mount changed during validation. Check again.',
        storage_io_error: 'Storage is unavailable or could not be inspected.'
      };
      function syncMode() {
        const required = mode.value === 'mounted';
        byId('mount-fields').hidden = !required;
        mount.disabled = source.disabled = !required;
        mount.required = source.required = required;
      }
      function size(bytes) {
        if (typeof bytes !== 'number' || !Number.isFinite(bytes)) return '—';
        const units = ['B', 'KiB', 'MiB', 'GiB', 'TiB', 'PiB', 'EiB'];
        let value = bytes, unit = 0;
        while (value >= 1024 && unit < units.length - 1) { value /= 1024; unit++; }
        return value.toFixed(unit ? 2 : 0) + ' ' + units[unit];
      }
      function renderStatus(status) {
        const put = (id, value) => { byId(id).textContent = value || '—'; };
        put('status-ready', status.ready === true ? 'Ready (advisory)' :
          (status.error ? 'Not ready: ' + (errors[status.error] || status.error) : 'Not checked'));
        put('status-root', status.root);
        put('status-mount', status.mount?.target);
        put('status-source', status.mount ? status.mount.type + ' · ' + status.mount.source : '');
        put('status-total', size(status.total_bytes));
        put('status-free', size(status.free_bytes));
        put('status-write', status.ready === true && status.write_ready === true ? 'Writable (advisory)' : 'Not verified');
        put('status-staging', status.paths?.staging);
        put('status-library', status.paths?.library);
      }
      async function json(url, options) {
        const response = await fetch(url, {...options, cache: 'no-store'});
        const body = await response.json();
        if (!response.ok) throw new Error(body.error || 'Request failed (' + response.status + ')');
        return body;
      }
      async function statusCheck() {
        renderStatus({});
        try {
          const status = await json('/api/storage-status');
          renderStatus(status);
          return status.ready === true;
        } catch (error) {
          renderStatus({error: error.message});
          return false;
        }
      }
      function populate(settings) {
        root.value = settings.storage_root;
        mode.value = settings.storage_mount ? 'mounted' : 'local';
        mount.value = settings.storage_mount;
        source.value = settings.storage_source;
        minimum.value = String(settings.minimum_free_bytes);
        syncMode();
      }
      async function load() {
        fields.disabled = true;
        feedback.textContent = 'Loading saved preferences…';
        try {
          populate(await json('/api/storage-settings'));
          const ready = await statusCheck();
          feedback.textContent = ready ? 'Saved preferences loaded.' : 'Saved preferences loaded; storage is not ready.';
        } catch (error) {
          renderStatus({error: error.message});
          feedback.textContent = 'Could not load saved preferences: ' + error.message + '. Enter a new configuration and save explicitly to replace it.';
        } finally {
          fields.disabled = false;
        }
      }
      mode.addEventListener('change', syncMode);
      byId('storage-refresh').addEventListener('click', load);
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const bytes = Number(minimum.value || '0');
        if (!Number.isSafeInteger(bytes) || bytes < 0) {
          feedback.textContent = 'Minimum available bytes must be a non-negative whole number within the supported range.';
          return;
        }
        const settings = {storage_root: root.value.trim(),
          storage_mount: mode.value === 'mounted' ? mount.value.trim() : '',
          storage_source: mode.value === 'mounted' ? source.value.trim() : '',
          minimum_free_bytes: bytes, directories: ['staging', 'library']};
        fields.disabled = true;
        feedback.textContent = 'Saving preferences…';
        try {
          populate(await json('/api/storage-settings', {method: 'POST',
            headers: {'Content-Type': 'application/json'}, body: JSON.stringify(settings)}));
          const ready = await statusCheck();
          feedback.textContent = ready ? 'Preferences saved. Storage is ready (advisory).' :
            'Preferences saved, but storage is not ready. See the status below.';
        } catch (error) {
          feedback.textContent = 'Save failed: ' + error.message + '. Previously saved preferences were not confirmed changed.';
        } finally {
          fields.disabled = false;
        }
      });
      load();
    })();
  </script>
  {% if password_change_enabled %}
  <script id="admin-password-script">
    (() => {
      const byId = id => document.getElementById(id);
      const form = byId('password-form');
      const feedback = byId('password-feedback');
      const fields = byId('password-fields');
      form.addEventListener('submit', async event => {
        event.preventDefault();
        const current = byId('current-password'), next = byId('new-password'), confirm = byId('confirm-password');
        if (next.value !== confirm.value) {
          feedback.textContent = 'New passwords do not match.';
          return;
        }
        fields.disabled = true;
        feedback.textContent = 'Changing password…';
        try {
          const response = await fetch('/api/admin/password', {
            method: 'POST', headers: {'Content-Type': 'application/json'},
            cache: 'no-store', body: JSON.stringify({current_password: current.value,
              new_password: next.value, confirm_password: confirm.value})
          });
          const result = await response.json();
          if (!response.ok || result.changed !== true) throw new Error(result.error || 'Password change failed');
          feedback.textContent = 'Password changed. Reload the admin page and sign in with the new password. If your browser keeps the old credentials, close its session or use a private window.';
        } catch (error) {
          feedback.textContent = 'Could not confirm password change: ' + error.message;
        } finally {
          current.value = next.value = confirm.value = '';
          fields.disabled = false;
        }
      });
    })();
  </script>
  {% endif %}
  {% endif %}
</body>
</html>