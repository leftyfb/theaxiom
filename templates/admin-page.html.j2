          const verification = replacementState === 'verifying' ?
            ' · ' + (sample ? checksumLabel(sample) : 'Checksum percentage unavailable.') : '';
          const replacementLabels = {
            prepared: 'Update ready to download', downloading: 'Downloading update', retrying: 'Waiting to retry update',
            verifying: 'Verifying update', cancelling: 'Cancelling update download',
            verified: 'Update verified and ready to publish', activated: 'Update activated',
            rolled_back: 'Previous edition restored. Update files retained.', failed: 'Update download failed',
            cancelled: 'Update download cancelled', interrupted: 'Update download interrupted',
