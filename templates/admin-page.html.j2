<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% set page = admin_page|default("sources") %}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png">
<link rel="shortcut icon" href="/favicon.ico" sizes="any">
<meta name="theaxiom-csrf" content="{{ session_csrf_token|default('') }}">
<meta name="application-name" content="The Axiom">
<title>{{ page|capitalize }} · Administration · The Axiom</title>
  <style>
    :root { font-family: ui-sans-serif, system-ui, sans-serif; color:#17332b; background:#eef4f0; --green:#176b4d; --dark:#123c32; --line:#d4e4db; --muted:#587067; --paper:#fff; --accent:#e2f2e9; }
    * { box-sizing: border-box; }
    body { margin: 0; min-width: 280px; }
    a { color: var(--green); }
    a:focus-visible, button:focus-visible { outline: 3px solid #f1b84b; outline-offset: 3px; }
    .skip { position: fixed; left: 1rem; top: -5rem; z-index: 20; padding: .75rem 1rem; color: #fff; background: var(--dark); border-radius: .45rem; }
    .skip:focus { top: 1rem; }
    .site-header { position: sticky; top: 0; z-index: 10; display: flex; align-items: center; gap: .75rem; padding: .75rem 1rem; background: rgba(255,255,255,.97); border-bottom: 1px solid var(--line); }
    .brand { margin-right: auto; color: var(--dark); font-size: 1.05rem; font-weight: 800; text-decoration: none; }
    main { width: min(100% - 2rem, 70rem); margin: 0 auto; padding: 1.5rem 0 3rem; }
    h1 { margin: 0 0 1.5rem; font-size: clamp(1.6rem, 5vw, 2.4rem); }
    .admin-table td.actions { display: flex; flex-wrap: wrap; gap: .4rem; }
    .button { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: .5rem .85rem; border: 1px solid #aac5b7; border-radius: .6rem; background: #fff; color: var(--green); font: inherit; font-weight: 700; cursor: pointer; text-decoration: none; }
    .badge { display: inline-block; padding: .15rem .5rem; border-radius: .35rem; font-size: .75rem; font-weight: 700; }
    .badge.enabled { color: #176b4d; background: #e2f2e9; }
    .badge.disabled { color: #c0392b; background: #fceaea; }
    .empty { padding: 1.5rem; text-align: center; color: var(--muted); }
    @media print { .site-header { display: none; } }
    body.reviewing-updates #regular-sources, body.reviewing-updates #source-overview { display:none; }
    body.reviewing-updates :is(#mobile-search-toggle, #mobile-filter-control, #mobile-add-control, #mobile-reorder) { display:none; }
    #update-availability:empty, #update-sweep-feedback:empty, #source-update-summary,
    #update-notice:has(> #update-availability:only-child:empty) { display:none; }
    #update-notice { align-items:center; margin-block:.5rem; }
    #update-review:target { scroll-margin-top: 4rem; }
    #update-review-list { padding-inline-start: 1.4rem; }
    #update-review-list li { margin-block: .65rem; }
    #update-review-list p { margin: .25rem 0; }
    .settings-panel { background: var(--paper); border: 1px solid var(--line); border-radius: .8rem; padding: 1.25rem; margin: 1rem 0 2rem; }
    .settings-panel fieldset { border: 0; margin: 0; padding: 0; }
    .settings-panel label { display: block; font-weight: 650; margin: .8rem 0 .35rem; }
    .settings-panel input, .settings-panel select { font: inherit; width: min(100%, 40rem); padding: .65rem; border: 1px solid #aac5b7; border-radius: .4rem; background: #fff; color: var(--dark); }
    .settings-actions { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1rem; }
    .storage-status { display: grid; grid-template-columns: minmax(9rem, 1fr) 2fr; gap: .5rem 1rem; }
    .storage-status dt { font-weight: 650; }
    .storage-status dd { margin: 0; overflow-wrap: anywhere; }
    @media (max-width: 500px) { .storage-status { grid-template-columns: 1fr; } .storage-status dd { margin-bottom: .5rem; } }
    .source-card { background: var(--paper); border: 1px solid var(--line); border-radius: .8rem; padding: 1.25rem; margin: 1rem 0; }
    .source-header { display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; }
    .source-header h3 { margin: 0; overflow-wrap: anywhere; }
    .source-header > div { flex: 1; min-width: 0; }
    .source-symbol img { width: 2rem; height: 2rem; object-fit: contain; vertical-align: middle; }
    .source-symbol { background: var(--accent); border-radius: .6rem; padding: .65rem; font-weight: 800; }
    .source-subtitle, .source-note { color: var(--muted); margin: .35rem 0; }
    [data-zim-replacement-status]:empty { display:none; }
    [data-zim-replacement="activate"] { background:var(--dark); color:white; }
    .source-actions { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .75rem; }
    .button:disabled { opacity: .55; cursor: not-allowed; }
    .source-card progress { width: 100%; accent-color: var(--green); height: .9rem; }
    .source-card { padding: 0; margin: .65rem 0; }
    .source-row { position:relative; margin:.65rem 0; }
    .source-row > .source-card { margin:0; }
    .source-row > .group-select { position:absolute; z-index:1; left:.7rem; top:.75rem; width:2rem; min-height:36px; justify-content:center; }
    .source-row:has(> .group-select:not([hidden])) > .source-card > summary { padding-left:3.25rem; }
    .source-order-controls:not([hidden]) { display:flex; align-items:center; gap:.35rem; margin-block:.25rem; }
    .source-row:has(> .source-order-controls:not([hidden])) > .group-select { top:3.25rem; }
    [data-order-grip] { touch-action:none; cursor:grab; padding:.4rem .65rem; font-size:1.2rem; }
    .source-row.order-drop-target > .source-card { outline:2px solid var(--green); }
    .source-row.publication-divider { border-top:1px solid var(--line); padding-top:.65rem; margin-top:1rem; }
    .source-row[hidden] { display:none !important; }
    .source-card > summary { padding: .65rem .85rem; list-style:none; flex-wrap:nowrap; }
    .source-card > summary .source-symbol { width:2.4rem; text-align:center; padding:.5rem .15rem; flex:none; }
    .source-card > summary .source-subtitle { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; margin:.15rem 0; }
    .source-card > summary .compact-publication { display:block; }
    .source-card > summary .badge { max-width:11rem; text-align:right; }
    .source-card > summary .summary-progress { display:block; max-width:12rem; height:.45rem; margin-top:.25rem; }
    @media(max-width:550px) {
      .source-card > summary { flex-wrap:wrap; gap:.4rem; align-items:center; }
      .source-card > summary .source-symbol { width:2rem; }
      /* Reserve a full first row for the icon and title, even during transfers. */
      .source-card > summary > div { flex:1 1 calc(100% - 2.5rem); min-width:0; }
      .source-card > summary .badge { margin-left:2.4rem; max-width:calc(100% - 4rem); }
      .source-card > summary .summary-progress { flex:1 1 100%; max-width:none; margin:.2rem 0 0 2.4rem; }
      .source-card > summary::after { margin-left:auto; }
    }
    .source-card > summary::-webkit-details-marker { display: none; }
    .source-card > summary::after { content: '▾'; color: var(--green); margin-left: .25rem; }
    .source-card[open] > summary::after { content: '▴'; }
    .source-metadata > div[hidden], .source-details > [hidden] { display: none; }
    .source-metadata:not(:has(dd:not(:empty))) { display: none; }
    .source-expanded { padding: .8rem 1rem 1rem; border-top: 1px solid var(--line); }
    .source-card > summary .source-subtitle { font-weight: 400; font-size: .9rem; }
    .source-card > summary h3 { font-size: 1.05rem; }
    .source-card > summary .source-symbol { flex-shrink: 0; }
    .source-card > summary .badge { flex-shrink: 0; }
    .compact-publication { font-size: .8rem; color: var(--muted); }
    .source-card details { margin-top: 1rem; border-top: 1px solid var(--line); padding-top: .6rem; }
    .source-card summary { cursor: pointer; font-weight: 650; min-height: 44px; color: var(--green); }
    .source-card summary:focus-visible { outline: 3px solid #f1b84b; }
    .source-card [hidden] { display: none !important; }
    .source-live:not(:has(> :not([hidden]))) { display: none; }
    .source-live { margin-top: .4rem; }
    .source-expanded .source-actions { align-items: flex-start; gap: .4rem; margin-top: .45rem; }
    .source-expanded .source-actions .button { box-sizing: border-box; min-height: 36px; padding: .25rem .6rem; font-size: .9rem; line-height: 1.25; }
    @media (pointer: coarse) { .source-expanded .source-actions .button { min-height: 44px; } }
    .source-actions .danger-action { color: #a12820; border-color: #d7aaa5; }
    .source-expanded .source-note:empty, #source-form-feedback:empty, [data-pdf-feedback]:empty { display: none; }
    .source-metadata { display:flex; flex-wrap:wrap; gap:.3rem 1rem; margin:.6rem 0; font-size:.9rem; }
    .source-metadata div { display:flex; gap:.35rem; }
    .source-metadata dt { font-weight:650; }
    .source-metadata dd { margin:0; overflow-wrap:anywhere; }
    .source-card .source-more-actions { margin: 0; padding: 0; border: 0; }
    .source-more-actions[open] { flex-basis: 100%; }
    .source-more-actions > summary { gap: .35rem; }
    .source-more-actions > summary::-webkit-details-marker { display: none; }
    .source-more-actions > summary::before { content: '▸' / ''; }
    .source-more-actions[open] > summary::before { content: '▾' / ''; }
    .source-technical { margin-top:.6rem; font-size:.9rem; }
    .source-technical summary { cursor:pointer; color:var(--green); font-weight:650; }
    .source-technical .storage-status { gap:.25rem .6rem; margin:.5rem 0; }
    [data-field="acquisition-history"] { white-space:pre-line; }
    .busy-indicator { display:flex; align-items:center; gap:.6rem; margin:.6rem 0; }
    .busy-indicator[hidden] { display:none; }
    .busy-spinner { display:inline-block; flex:none; width:1rem; height:1rem; border:2px solid currentColor; border-right-color:transparent; border-radius:50%; animation: source-spin .8s linear infinite; }
    @keyframes source-spin { to { transform:rotate(360deg); } }
    @media (prefers-reduced-motion: reduce) { .busy-spinner { animation:none; } }
    .source-live p { margin: .4rem 0; }
    .source-details { overflow-wrap: anywhere; }
    .admin-nav { display:flex; flex-wrap:wrap; gap:.5rem; margin-bottom:1.5rem; }
    .admin-nav a[aria-current="page"] { background:var(--dark); color:white; }
    .source-filters { background:var(--paper); border:1px solid var(--line); border-radius:.8rem; padding:1rem; margin:1rem 0; }
    .source-filters > summary, .group-panel > summary, #source-editor-groups > summary, .membership-section > summary, #source-advanced > summary { display:list-item; list-style-position:inside; }
    .source-filters summary { cursor:pointer; font-weight:700; color:var(--green); }
    #filtered-action-feedback { position: fixed; z-index: 2; bottom: 1rem; right: 1rem;
      max-width: min(28rem, calc(100vw - 2rem)); margin: 0; padding: .65rem .85rem;
      background: var(--dark); color: white; border-radius: .45rem; }
    #catalog-feedback:empty { margin:0; padding:0; }
    .source-selection-bar { display:flex; align-items:center; gap:.75rem; padding:.35rem .8rem; margin:.35rem 0; color:var(--muted); flex-wrap:wrap; }
    .source-selection-bar label { display:flex; align-items:center; gap:.45rem; cursor:pointer; font-size:.9rem; }
    .source-selection-bar input { width:1.2rem; height:1.2rem; margin:0; accent-color:var(--green); }
    .source-filter-toggle { display:inline-flex; align-items:center; justify-content:center; gap:.35rem; min-height:44px; }
    .source-filter-toggle[aria-expanded="true"] { background:var(--dark); color:white; }
    .source-filter-toggle svg { width:1.2rem; height:1.2rem; flex:none; }
    .source-search-row { display:flex; align-items:center; gap:.5rem; flex-wrap:wrap; }
    .source-browse-tools { margin-left:auto; display:flex; align-items:center; flex-wrap:wrap; gap:.5rem; max-width:100%; }
    .source-browse-tools input { flex:1 1 12rem; min-width:0; width:20rem; min-height:44px; padding:.55rem .7rem; font:inherit; border:1px solid #aac5b7; border-radius:.4rem; background:white; color:var(--dark); }
    #source-selection-panel { margin:.5rem 0; padding:.65rem .8rem; }
    #source-selection-panel:not(.has-selection) { background:transparent; border-color:transparent; padding:0; }
    #source-selection-panel .source-selection-bar { padding:0; margin:0; }
    #source-selection-panel #source-filter-count { margin-left:auto; }
    #source-selection-panel #bulk-actions { margin-top:.65rem; }
    #source-selection-panel #group-panel { margin:.65rem 0 0; padding:.6rem .7rem; }
    #source-order-feedback:empty { display:none; }
    .sources-heading { margin-bottom:.75rem; }
    .source-search-row #source-add { background:var(--dark); color:white; }
    #source-selection-panel .source-actions { margin:0; }
    #source-selection-panel .primary-action { background:var(--dark); color:white; }
    #bulk-actions { align-items:flex-start; }
    #bulk-more-actions { position:relative; }
    #bulk-more-actions > summary { display:block; list-style:none; }
    #bulk-more-actions > div { position:absolute; z-index:1; min-width:min(15rem, 80vw); padding:.45rem;
      background:var(--paper); border:1px solid var(--line); border-radius:.5rem; box-shadow:0 .25rem .8rem #1232; }
    @media (max-width: 560px) {
      .source-browse-tools { margin-left:0; width:100%; }
      #bulk-more-actions > div { position:static; min-width:0; }
      #bulk-preview-row { align-items:flex-start; flex-direction:column; }
    }
    #bulk-more-actions button { display:block; width:100%; text-align:left; padding:.5rem; }
    #bulk-preview-result { border-top:1px solid var(--line); margin-top:.65rem; padding-top:.65rem; }
    #bulk-preview-result p { margin:.2rem 0; }
    #bulk-preview-row { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:.5rem; }
    #bulk-preview-details { margin-top:.5rem; }
    #bulk-action-note:not(:empty) { margin:.4rem 0 0; }
    #bulk-action-note:empty, #bulk-queue-feedback:empty { display:none; }
    .source-filters .editor-grid { grid-template-columns:repeat(auto-fit,minmax(145px,1fr)); margin:.5rem 0; }
    .source-card[hidden] { display:none !important; }
    .group-panel { background:var(--paper); border:1px solid var(--line); border-radius:.8rem; padding:1rem; margin:1rem 0; }
    .group-panel summary { cursor:pointer; font-weight:700; color:var(--green); }
    .group-membership { font-size:.8rem; color:var(--muted); overflow-wrap:anywhere; }
    .group-select { display:flex; align-items:center; gap:.35rem; font-size:.8rem; color:var(--muted); }
    .group-select[hidden], [hidden] { display:none !important; }
    .group-select input { width:1.2rem; height:1.2rem; accent-color:var(--green); }
    #source-dialog, #source-guide, #selection-file-dialog { width: min(42rem, calc(100% - 2rem)); max-height: calc(100% - 2rem); overflow: auto; border: 1px solid var(--line); border-radius: .85rem; padding: clamp(1rem, 4vw, 1.75rem); color: var(--dark); background: var(--paper); }
    #source-dialog::backdrop, #source-guide::backdrop, #selection-file-dialog::backdrop { background: rgba(18,60,50,.55); }
    #selection-file-matches { overflow-wrap: anywhere; }
    #selection-file { max-width: 100%; }
    #source-dialog h3 { margin: 0; font-size: 1.4rem; }
    .editor-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 1rem; margin: 1rem 0; }
    #source-form fieldset { min-inline-size: 0; border: 1px solid #aac5b7; border-radius: .4rem; }
    #source-form legend { font-weight: 650; }
    .editor-wide { grid-column: 1 / -1; }
    .editor-grid > div { min-width: 0; }
    .editor-grid label { display: block; font-weight: 650; margin-bottom: .35rem; }
    .editor-grid input, .editor-grid select, .editor-grid textarea { display: block; width: 100%; min-width: 0; min-height: 44px; padding: .65rem; font: inherit; border: 1px solid #aac5b7; border-radius: .4rem; color: var(--dark); background: white; }
    .editor-grid textarea { min-height: 5rem; resize: vertical; }
    .editor-grid small { display: block; margin-top: .3rem; color: var(--muted); }
    #source-dialog :focus-visible { outline: 3px solid #f1b84b; outline-offset: 2px; }
    #source-editor-groups { border:0; margin:1rem 0; padding:0; min-width:0; }
    #source-editor-groups > summary { cursor:pointer; font-weight:700; color:var(--green); padding:.6rem 0; border-top:1px solid var(--line); }
    .membership-section { border:1px solid var(--line); border-radius:.5rem; padding:.65rem; margin:.5rem 0; }
    .membership-section summary { cursor:pointer; font-weight:650; color:var(--green); }
    .membership-options { display:grid; grid-template-columns:repeat(auto-fit,minmax(145px,1fr)); gap:.35rem; max-height:12rem; overflow:auto; margin-top:.5rem; }
    .membership-option { display:flex; align-items:center; gap:.45rem; padding:.3rem; overflow-wrap:anywhere; }
    .membership-option input { flex:none; width:1.1rem; height:1.1rem; accent-color:var(--green); }
    #editor-new-tag { width:100%; min-height:44px; padding:.6rem; font:inherit; border:1px solid #aac5b7; border-radius:.4rem; }
    #source-advanced { border-top: 1px solid var(--line); padding-top: .8rem; }
    #source-advanced summary { cursor: pointer; color: var(--green); font-weight: 650; padding: .5rem 0; }
    .editor-actions { display: flex; justify-content: flex-end; flex-wrap: wrap; gap: .5rem; margin-top: 1rem; }
    .editor-save { background: var(--green); color: white; }
    #source-form-feedback { color: #a12820; overflow-wrap: anywhere; }
    #source-help { border-top: 1px solid var(--line); margin-top: 1rem; padding-top: .75rem; font-size: .9rem; }
    @media (max-width: 550px) { .editor-grid { grid-template-columns: minmax(0,1fr); } }

    .mobile-admin-toolbar, .mobile-selection, .mobile-sheet, .desktop-library-link { display:none; }
    @media (min-width: 641px) {
      .site-header, .admin-nav, .sources-admin .source-search-row { display:none; }
      .sources-admin .sources-heading, .sources-admin #update-availability {
        position:absolute; width:1px; height:1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap; }
      main { padding-top:0; }
      main:not(.sources-admin) > h1 { margin-top:.75rem; }
      .mobile-admin-toolbar { position:sticky; top:0; z-index:10; display:flex;
        align-items:center; flex-wrap:wrap; gap:.5rem; padding:.55rem .75rem;
        background:var(--paper); border-bottom:1px solid var(--line); }
      .desktop-library-link { display:block; margin:0 1rem 0 0; }
      .mobile-admin-toolbar > details:first-of-type { margin-right:auto; }
      .mobile-admin-toolbar svg { width:1.2rem; height:1.2rem; }
      .mobile-admin-toolbar .button { padding:.35rem .65rem; min-height:40px; }
      .mobile-admin-toolbar details { position:relative; }
      .mobile-admin-toolbar details > div { position:absolute; top:100%; left:0; display:grid;
        min-width:12rem; padding:.35rem; gap:.25rem; background:var(--paper); border:1px solid var(--line);
        border-radius:.5rem; box-shadow:0 4px 15px #123c3226; }
      #mobile-admin-menu > div { left:auto; right:0; }
      .sources-admin #mobile-source-search { flex-basis:100%; }
      .sources-admin #mobile-source-search input { width:100%; min-height:40px; font:inherit; padding:.5rem;
        border:1px solid #aac5b7; border-radius:.5rem; }
      .sources-admin #source-overview { display:flex; gap:.75rem; align-items:center; flex-wrap:wrap; padding:.35rem .75rem; }
      .sources-admin #update-notice { margin:0; }
      .sources-admin #update-notice .button { min-height:32px; padding:.25rem .65rem; }
      .sources-admin #mobile-selection:not([hidden]) { position:sticky; top:var(--sources-toolbar-height, 58px);
        z-index:9; display:flex; gap:.75rem; align-items:center;
        flex-wrap:wrap; background:var(--paper); padding:.5rem .75rem; border:1px solid var(--line); border-radius:.6rem; }
      .sources-admin #mobile-selection label { display:flex; align-items:center; gap:.4rem; order:-1; }
      .sources-admin #mobile-selection input { width:1.2rem; height:1.2rem; accent-color:var(--green); }
      .sources-admin #mobile-selection .primary-action { background:var(--dark); color:white; }
      .sources-admin #mobile-selection #group-count { flex:1; }
      .sources-admin #source-selection-panel { display:none; }
      .sources-admin .source-header > div { display:grid; grid-template-columns:minmax(0,1fr) auto; column-gap:1rem; }
      .sources-admin .source-header h3, .sources-admin .source-header .source-subtitle { grid-column:1; }
      .sources-admin .source-header .compact-publication { grid-column:2; grid-row:1 / span 2;
        align-self:center; text-align:right; max-width:12rem; }
      body:not(.reordering) .sources-admin .source-order-controls { display:none; }
      body:not(.reordering) .sources-admin .source-row > .group-select { top:.75rem; }
      body.reordering .sources-admin .source-order-controls:not([hidden]) { display:flex; }
      body.selection-actions-open .sources-admin #source-selection-panel { display:block; }
    }
    @media (max-width: 640px) {
      .compact-admin .site-header, .compact-admin .admin-nav, .compact-admin .sources-heading,
      .compact-admin .source-search-row, .compact-admin #source-selection-panel,
      .compact-admin > main > #group-panel { display:none; }
      .compact-admin main { width:calc(100% - 1rem); padding:0 0 3rem; }
      .compact-admin main > h1 { margin:.7rem 0; font-size:1.4rem; }
      .compact-admin .settings-panel { margin:.6rem 0 1rem; padding:.85rem; }
      .compact-admin .mobile-admin-toolbar { position:sticky; top:0; z-index:10; display:flex;
        flex-wrap:wrap; align-items:center; gap:.25rem; margin:0 -.5rem; padding:.35rem .5rem;
        border-bottom:1px solid var(--line); background:var(--paper); }
      .mobile-admin-toolbar > details:first-child { margin-right:auto; }
      .mobile-admin-toolbar .button, .mobile-selection .button { padding:.35rem .45rem; }
      .mobile-admin-toolbar button, #mobile-admin-menu > summary { min-width:44px; }
      #mobile-admin-menu > summary { font-size:1.25rem; }
      #mobile-filter-control #source-filter-toggle[aria-expanded="false"] { background:var(--accent); }
      .compact-admin:has(.mobile-selection:not([hidden])) main { padding-bottom:8rem; }
      .mobile-admin-toolbar svg { width:1.15rem; height:1.15rem; }
      .mobile-admin-toolbar details { position:relative; }
      .mobile-admin-toolbar details > div { position:absolute; top:100%; left:0; display:grid;
        min-width:10rem; padding:.35rem; gap:.25rem; border:1px solid var(--line);
        border-radius:.5rem; background:var(--paper); box-shadow:0 4px 15px #123c3226; }
      .mobile-admin-toolbar details:last-of-type > div { left:auto; right:0; }
      #mobile-source-search { flex-basis:100%; }
      #mobile-source-search input { width:100%; min-height:44px; font:inherit; padding:.5rem;
        border:1px solid #aac5b7; border-radius:.5rem; }
      .compact-admin #source-filter-count { display:block; margin:.4rem 0; }
      .compact-admin .source-row .source-card { margin:.4rem 0; }
      .compact-admin:not(.reordering) .source-order-controls { display:none; }
      .compact-admin:not(.reordering) .source-row > .group-select { top:.55rem; }
      .mobile-selection label { display:flex; align-items:center; gap:.25rem; min-height:44px; font-size:.85rem; }
      .mobile-selection input { width:1.2rem; height:1.2rem; accent-color:var(--green); }
      .mobile-selection .primary-action { background:var(--dark); color:white; }
      .compact-admin .mobile-selection { display:flex; position:fixed; z-index:11; bottom:0; inset-inline:0;
        align-items:center; flex-wrap:wrap; gap:.35rem; background:var(--paper); border-top:1px solid var(--line);
        padding:.35rem .5rem calc(.35rem + env(safe-area-inset-bottom)); }
      .mobile-selection #group-count { flex:1; min-width:4rem; }
      .compact-admin .mobile-sheet[open] { display:block; position:fixed; inset:auto 0 0;
        width:100%; max-width:none; max-height:85dvh; margin:0; overflow:auto;
        padding:1rem 1rem calc(1rem + env(safe-area-inset-bottom)); color:var(--dark);
        border:1px solid var(--line); border-radius:1rem 1rem 0 0; background:var(--paper); }
      .mobile-sheet::backdrop { background:#123c3266; }
      .mobile-sheet-header { display:flex; align-items:center; justify-content:space-between; gap:.5rem; }
      .mobile-sheet-header h2 { margin:0; }
      #mobile-filters-apply { width:100%; background:var(--dark); color:white; }
      #mobile-actions-sheet > .group-panel:not(:has(#bulk-group-fields:not([hidden]))) { display:none; }
      .mobile-sheet .source-filters, .mobile-sheet .group-panel { margin:.5rem 0; padding:.5rem; }
      .mobile-sheet #bulk-more-actions > div { position:static; }
    }
  </style>
</head>
<body>
  <a class="skip" href="#main-content">Skip to administration</a>
  <header class="site-header">
    <a class="brand" href="/">← The Axiom</a>
    <span class="brand">Admin</span>
    <button id="admin-logout" class="button" type="button"{% if not session_csrf_token %} hidden{% endif %}>Sign out</button>
  </header>
  <main id="main-content"{% if page == "sources" %} class="sources-admin"{% endif %}>
    <nav class="admin-nav" aria-label="Administration"><a class="button" href="/admin/sources"{% if page == "sources" %} aria-current="page"{% endif %}>Sources</a><a class="button" href="/admin/groupings"{% if page == "groupings" %} aria-current="page"{% endif %}>Groupings</a><a class="button" href="/admin/settings"{% if page == "settings" %} aria-current="page"{% endif %}>Settings</a></nav>
    <nav class="mobile-admin-toolbar" aria-label="Administration tools">
      <a href="/" class="brand desktop-library-link">The Axiom</a>
      <details><summary class="button">{{ page|capitalize }} ▾</summary><div>
        <a class="button" href="/">Back to library</a>
        {% for section in ['sources', 'groupings', 'settings'] %}
        <a class="button" href="/admin/{{ section }}"{% if section == page %} aria-current="page"{% endif %}>{{ section|capitalize }}</a>
        {% endfor %}
      </div></details>
      {% if page == "sources" %}
      <button type="button" class="button" id="mobile-search-toggle" aria-label="Search sources" aria-controls="mobile-source-search" aria-expanded="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="10" cy="10" r="6"/><path d="m15 15 6 6"/></svg></button>
      <span id="mobile-filter-control"></span>
      <span id="mobile-add-control"></span>
      {% endif %}
      <details id="mobile-admin-menu"{% if page != "sources" and not session_csrf_token %} hidden{% endif %}>
        <summary class="button" aria-label="More admin tools">⋯</summary>
        <div id="mobile-admin-tools">
          {% if page == "sources" %}
          <button type="button" class="button" id="mobile-reorder" aria-pressed="false">Reorder published sources</button>
          {% endif %}
        </div>
      </details>
      {% if page == "sources" %}<div id="mobile-source-search" hidden></div>{% endif %}
    </nav>
    {% if page == "settings" %}
    <h1>Settings</h1>
    <section class="settings-panel" aria-labelledby="library-overview-title">
      <h2 id="library-overview-title">Library overview</h2>
      <dl class="storage-status">
        <dt>Installed library size</dt><dd id="overview-size">—</dd>
        <dt>Total sources</dt><dd id="overview-total">—</dd>
        <dt>Installed sources</dt><dd id="overview-installed">—</dd>
        <dt>Publication enabled</dt><dd id="overview-enabled">—</dd>
        <dt>Publication disabled</dt><dd id="overview-disabled">—</dd>
        <dt>Running revision</dt><dd><code id="overview-revision">—</code></dd>
      </dl>
      <p id="overview-feedback" role="status"></p>
    </section>
    <section class="settings-panel" aria-labelledby="update-schedule-title">
      <h2 id="update-schedule-title">Update check schedule</h2>
      <form id="update-schedule-form">
        <fieldset disabled>
          <label for="update-interval">Check every (days)</label>
          <input id="update-interval" type="number" min="1" max="365" step="1" required>
          <label for="update-start">Preferred start time</label>
          <input id="update-start" type="time" required>
          <p>Time zone <strong id="update-time-zone"></strong></p>
          <p>Next scheduled run <strong id="update-next-run"></strong></p>
          <button class="button" type="submit">Save update schedule</button>
        </fieldset>
      </form>
      <p id="update-schedule-feedback" role="status"></p>
    </section>
    <section class="settings-panel" id="storage-settings" aria-labelledby="storage-title">
      <h2 id="storage-title">Storage preferences</h2>
      <p>Choose an existing directory on the server. For network or removable storage, require the expected mount so a missing drive cannot redirect downloads to the operating system disk.</p>
      <form id="storage-form">
        <fieldset id="storage-fields" disabled>
          <label for="storage-root">Storage root</label>
          <input id="storage-root" type="text" placeholder="/path/to/library" autocomplete="off" required>
          <label for="storage-mode">Storage type</label>
          <select id="storage-mode"><option value="local">Local directory (no required mount)</option><option value="mounted">Require a specific mounted filesystem</option></select>
          <div id="mount-fields" hidden>
            <label for="storage-mount">Expected mount target</label>
            <input id="storage-mount" type="text" placeholder="/path/to/mount" autocomplete="off">
            <label for="storage-source">Expected mount source</label>
            <input id="storage-source" type="text" placeholder="server:/export or device source" autocomplete="off">
          </div>
          <label for="minimum-free">Minimum available bytes (optional; 0 uses content size)</label>
          <input id="minimum-free" type="number" min="0" max="9007199254740991" step="1" value="0">
          <div class="settings-actions">
            <button class="button" type="submit">Save and validate</button>
            <button class="button" type="button" id="storage-refresh">Reload saved settings</button>
          </div>
        </fieldset>
      </form>
      <p id="storage-feedback" role="status" aria-live="polite">Loading storage preferences…</p>
      <h3>Saved storage status</h3>
      <dl id="storage-status" class="storage-status" aria-live="polite">
        <dt>Readiness</dt><dd id="status-ready">Not checked</dd>
        <dt>Configured root</dt><dd id="status-root">—</dd>
        <dt>Detected mount</dt><dd id="status-mount">—</dd>
        <dt>Filesystem / source</dt><dd id="status-source">—</dd>
        <dt>Total capacity</dt><dd id="status-total">—</dd>
        <dt>Available capacity</dt><dd id="status-free">—</dd>
        <dt>Failed check</dt><dd id="status-failure">—</dd>
        <dt>Write readiness (advisory)</dt><dd id="status-write">—</dd>
        <dt>Staging directory</dt><dd id="status-staging">—</dd>
        <dt>Verified library directory</dt><dd id="status-library">—</dd>
      </dl>
      <p>Readiness is advisory. Saving settings does not move or create content. Acquisitions remain disabled until safe download and recovery support is implemented.</p>
    </section>
    {% if password_change_enabled %}
    <section class="settings-panel" id="admin-password" aria-labelledby="password-title">
      <h2 id="password-title">Change administrator password</h2>
      <p>Choose a unique password of 8–256 printable non-space ASCII characters. Changing it immediately invalidates the old password. On this HTTP development site, credentials are not encrypted in transit.</p>
      <form id="password-form">
        <fieldset id="password-fields">
          <label for="current-password">Current password</label>
          <input id="current-password" type="password" autocomplete="current-password" required maxlength="256">
          <label for="new-password">New password</label>
          <input id="new-password" type="password" autocomplete="new-password" required minlength="8" maxlength="256">
          <label for="confirm-password">Confirm new password</label>
          <input id="confirm-password" type="password" autocomplete="new-password" required minlength="8" maxlength="256">
          <div class="settings-actions"><button class="button" type="submit">Change password</button></div>
        </fieldset>
      </form>
      <p id="password-feedback" role="status" aria-live="polite"></p>
    </section>
    {% endif %}
    {% elif page == "groupings" %}
    <h1>Manage groupings</h1>
    <p>Categories classify subjects, collections curate resources, and tags describe sources. Assign memberships from Sources. Deleting a grouping never deletes sources or installed content.</p>
    <section class="group-panel" id="grouping-management" aria-label="Grouping management">
      <label for="manage-kind">Grouping type</label>
      <select id="manage-kind"><option value="categories">Categories</option><option value="tags">Tags</option><option value="collections">Collections</option></select>
      <label for="manage-search">Search groupings</label><input id="manage-search" type="search">
      <label for="manage-new">New grouping name</label><input id="manage-new" maxlength="100">
      <button class="button" id="manage-create" type="button">Add grouping</button>
      <button class="button" id="manage-defaults" type="button">Add missing starter categories and tags</button>
      <p id="manage-feedback" role="status" aria-live="polite"></p>
      <div id="manage-list"></div>
    </section>
    <section class="group-panel" aria-labelledby="library-layout-title">
      <h2 id="library-layout-title">Public library layout</h2>
      <p>Move sources to set their order when published. New sources follow the saved order.</p>
      <form id="library-layout">
        <label for="layout-group-by">Group the homepage by</label>
        <select id="layout-group-by">
          <option value="none">No grouping</option>
          <option value="categories">Category</option>
          <option value="collections">Collection</option>
        </select>
        <p>For sources in several groups, the first group alphabetically is used. Other memberships stay available in filters.</p>
        <ol id="layout-sources">
          {% for source in catalog.sources %}
          <li data-layout-source="{{ source.source_id }}">
            <span>{{ source.profile.title }}</span>
            <div class="source-actions">
              <button class="button" type="button" data-layout-move="-1" aria-label="Move {{ source.profile.title }} up">Move up</button>
              <button class="button" type="button" data-layout-move="1" aria-label="Move {{ source.profile.title }} down">Move down</button>
            </div>
          </li>
          {% endfor %}
        </ol>
        <div class="source-actions">
          <button class="button" type="submit">Save library layout</button>
          <button class="button" id="layout-reset" type="button">Reset to default</button>
        </div>
        <p id="layout-feedback" role="status"></p>
      </form>
    </section>
    <script>
    (() => {
      const form = document.getElementById('library-layout');
      const list = document.getElementById('layout-sources');
      const groupBy = document.getElementById('layout-group-by');
      const feedback = document.getElementById('layout-feedback');
      const layout = {{ catalog.library_layout|default({})|tojson }};
      const revision = {{ catalog.revision|tojson }};
      let saving = false;
      const items = new Map(Array.from(list.children, row => [row.dataset.layoutSource, row]));
      for (const id of new Set([...(layout.source_order || []), ...items.keys()])) {
        if (items.has(id)) list.append(items.get(id));
      }
      groupBy.value = layout.group_by || 'none';
      function setBoundaries() {
        Array.from(list.children).forEach((row, index) => {
          row.querySelector('[data-layout-move="-1"]').disabled = index === 0;
          row.querySelector('[data-layout-move="1"]').disabled = index === list.children.length - 1;
        });
      }
      list.addEventListener('click', event => {
        const button = event.target.closest('[data-layout-move]');
        if (!button || saving) return;
        const row = button.closest('li');
        const up = button.dataset.layoutMove === '-1';
        const sibling = up ? row.previousElementSibling : row.nextElementSibling;
        if (!sibling) return;
        if (up) list.insertBefore(row, sibling);
        else list.insertBefore(sibling, row);
        setBoundaries();
        (button.disabled ? row.querySelector('[data-layout-move]:not(:disabled)') : button)?.focus();
        feedback.textContent = row.firstElementChild.textContent + ' moved to position ' +
          (Array.from(list.children).indexOf(row) + 1) + '. Save to apply.';
      });
      async function save(next) {
        if (saving) return;
        saving = true;
        try {
          const response = await fetch('/api/library-layout', {
            method: 'POST',
            headers: {...(window.axiomCsrfHeaders?.() || {}), 'Content-Type': 'application/json'},
            body: JSON.stringify({revision, layout: next})
          });
          const result = await response.json();
          if (!response.ok) throw new Error(result.error || 'Library layout could not be saved.');
          location.reload();
        } catch (error) {
          feedback.textContent = error.message;
          saving = false;
        }
      }
      form.addEventListener('submit', event => {
        event.preventDefault();
        save({group_by: groupBy.value, source_order: Array.from(list.children, row => row.dataset.layoutSource)});
      });
      document.getElementById('layout-reset').addEventListener('click', () => save(null));
      setBoundaries();
    })();
    </script>
    <script>
    (() => {
      const groups = {{ catalog.groups|default([])|tojson }};
      const revision = {{ catalog.revision|tojson }};
      const kind = document.getElementById('manage-kind');
      const search = document.getElementById('manage-search');
      const name = document.getElementById('manage-new');
      const list = document.getElementById('manage-list');
      const feedback = document.getElementById('manage-feedback');
      const panel = document.getElementById('grouping-management');
      let busy = false;
      try { kind.value = sessionStorage.getItem('axiom-group-kind') || 'categories'; } catch (_) {}
      if (!kind.value) kind.value = 'categories';
      async function mutate(payload) {
        if (busy) return;
        busy = true;
        panel.querySelectorAll('button,input,select').forEach(e => e.disabled = true);
        try {
          const response = await fetch('/api/groups',{method:'POST',headers:{...((typeof window !== 'undefined' && window.axiomCsrfHeaders?.()) || {}),'Content-Type':'application/json'},body:JSON.stringify({...payload,revision})});
          const result = await response.json();
          if (!response.ok) throw new Error(result.error || 'Grouping update failed');
          try { sessionStorage.setItem('axiom-group-kind',kind.value); } catch (_) {}
          location.reload();
        } catch (error) {
          feedback.textContent = error.message;
          busy = false;
          panel.querySelectorAll('button,input,select').forEach(e => e.disabled = false);
        }
      }
      function render() {
        list.replaceChildren();
        const matches = groups.filter(g => g.kind === kind.value && g.name.toLowerCase().includes(search.value.toLowerCase())).sort((a,b)=>a.name.localeCompare(b.name));
        if (!matches.length) list.textContent = 'No matching groupings.';
        for (const group of matches) {
          const row = document.createElement('div');
          row.className = 'source-actions';
          const label = document.createElement('label');
          const field = document.createElement('input');
          field.value = group.name; field.maxLength = 100;
          field.setAttribute('aria-label','Name of ' + group.name);
          label.append(field);
          const count = document.createElement('span');
          count.textContent = group.source_ids.length + ' sources';
          const rename = document.createElement('button');
          rename.className = 'button'; rename.type = 'button'; rename.textContent = 'Rename';
          rename.onclick = () => mutate({operation:'rename',kind:group.kind,group_id:group.group_id,name:field.value.trim()});
          const remove = document.createElement('button');
          remove.className = 'button'; remove.type = 'button'; remove.textContent = 'Delete';
          remove.onclick = () => {
            if (window.confirm('Delete ' + group.name + ' and its ' + group.source_ids.length + ' source assignments? Sources and files will remain.'))
              mutate({operation:'delete',kind:group.kind,group_id:group.group_id});
          };
          row.append(label,count,rename,remove); list.append(row);
        }
      }
      document.getElementById('manage-create').onclick = () => {
        const value = name.value.trim();
        if (!value) { feedback.textContent = 'Enter a name.'; return; }
        const base = value.normalize('NFKD').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'').slice(0,50).replace(/-$/,'') || 'group';
        const used = new Set(groups.filter(g => g.kind === kind.value).map(g => g.group_id));
        let id = base;
        for (let n=2;used.has(id);n++) id = base+'-'+n;
        mutate({operation:'create',kind:kind.value,group_id:id,name:value});
      };
      document.getElementById('manage-defaults').onclick = () => {
        if (window.confirm('Add missing starter categories and tags? Existing groups and memberships are preserved. Previously deleted defaults may be restored.'))
          mutate({operation:'merge-defaults',kind:'categories',group_id:'defaults'});
      };
      kind.addEventListener('change',render); search.addEventListener('input',render); render();
    })();
    </script>
    {% else %}
    <h1 class="sources-heading">Manage offline sources</h1>
    {% set available_updates = catalog.available_updates|default(0) %}
    <div id="source-overview">
    <div id="desktop-source-count"></div>
    <div class="source-actions" id="update-notice">
      <strong id="update-availability" role="status">{{ "An update is available" if available_updates == 1 else "Updates are available" if available_updates else "" }}</strong>
      <a class="button" id="review-updates-link" href="/admin/sources#update-review" aria-label="Review updates">Review updates</a>
    </div>
    </div>
    <section class="group-panel" id="update-review" aria-labelledby="update-review-title" hidden>
      <h2 id="update-review-title">Review updates</h2>
      <a href="/admin/sources#all-sources">Show all sources</a>
      <div class="source-actions">
        <button class="button" id="check-all-updates" type="button">Check for all updates</button>
        <button class="button" id="check-updates-again" type="button" hidden>Check for all updates</button>
      </div>
      <p id="update-sweep-feedback" role="status"></p>
      <details id="update-sweep-details" hidden>
        <summary>Inconclusive publisher checks</summary>
        <p>These checks could not determine whether a newer edition is available. Open a source’s Technical details for the evidence from its last check.</p>
        <ul id="update-sweep-failures"></ul>
      </details>
      <p><label><input type="checkbox" id="select-all-updates" disabled> Select all eligible updates</label></p>
      <ul id="update-review-list"></ul>
      <p id="update-selection-size" role="status"></p>
      <div class="source-actions">
        <button class="button" id="alternate-update-action" type="button" hidden></button>
      </div>
      <p id="update-batch-feedback" role="status"></p>
    </section>
    <div id="regular-sources">
    <div id="mobile-source-count"></div>
    <div class="mobile-selection" id="mobile-selection" hidden>
      <button class="button primary-action" type="button" id="mobile-actions-open" aria-expanded="false">Actions</button>
      <button class="button" type="button" id="mobile-selection-done">Done</button>
    </div>
    <dialog class="mobile-sheet" id="mobile-actions-sheet" aria-labelledby="mobile-actions-title">
      <div class="mobile-sheet-header"><h2 id="mobile-actions-title">Actions</h2><form method="dialog"><button class="button">Close</button></form></div>
    </dialog>
    <dialog class="mobile-sheet" id="mobile-filters-sheet" aria-labelledby="mobile-filters-title">
      <div class="mobile-sheet-header"><h2 id="mobile-filters-title">Filters</h2><form method="dialog"><button class="button">Close</button></form></div>
      <button class="button primary-action" type="button" id="mobile-filters-apply">Show sources</button>
    </dialog>
    {% set update_summary = catalog.update_summary|default("") %}
    <p class="source-note" id="source-update-summary" role="status"{% if not update_summary %} hidden{% endif %}>{{ update_summary }}</p>
    <div class="source-search-row">
      <button class="button" type="button" id="source-add">Add Source</button>
      <button class="button" type="button" id="source-guide-open">Content source guide</button>
      <div class="source-browse-tools">
        <input id="source-filter-search" type="search" aria-label="Search source names" placeholder="Search sources…" maxlength="512">
        <button class="button source-filter-toggle" type="button" id="source-filter-toggle" aria-label="Filter sources" title="Filter sources" aria-controls="source-filters-panel" aria-expanded="false"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4"/></svg> Filters<span id="source-filter-active" hidden></span></button>
      </div>
    </div>
    <p class="source-note" id="source-refresh-feedback" role="status" hidden>Source status refresh delayed. Showing the last available information.</p>
    <p id="catalog-feedback" role="status" aria-live="polite"></p>
    <dialog id="selection-file-dialog" aria-labelledby="selection-file-title">
      <h3 id="selection-file-title">Preview a library selection</h3>
      <p class="source-note">Review a starter preset, selection file or ZIM transfer manifest against your catalog.</p>
      <label for="selection-preset">Starter preset</label>
      <select id="selection-preset">
        <option value="">Choose a preset</option>
        {% for key, name in (selection_presets|default({})).items() %}<option value="{{ key }}">{{ name }}</option>{% endfor %}
      </select>
      <label for="selection-file">Selection or transfer manifest JSON</label>
      <input id="selection-file" type="file" accept=".json,application/json">
      <p id="selection-file-feedback" role="status"></p>
      <ul id="selection-file-matches"></ul>
      <p id="selection-storage-summary" role="status"></p>
      <p id="selection-storage-capacity"></p>
      <button class="button" type="button" id="selection-file-apply" disabled>Select matching sources</button>
      <form method="dialog"><button class="button">Close</button></form>
    </dialog>
    {% set groups = (catalog|default({})).groups|default([]) %}
    <dialog id="source-dialog" aria-labelledby="source-dialog-title">
      <form id="source-form">
        <h3 id="source-dialog-title">Add source metadata</h3>
        <p class="source-note">Choose content to add to your offline library. Choose a PDF or EPUB to install it now, or save a URL-based profile for later acquisition. Publication is separate. <a href="#source-help" id="source-guide-link">Content source help</a></p>
        <input id="catalog-id" name="source_id" type="hidden">
        <p id="catalog-id-display" class="source-note" hidden></p>
        <div class="editor-grid">
          <div class="editor-wide" id="source-upload-row"><label for="source-upload-file">Upload PDF or EPUB (optional)</label><input id="source-upload-file" type="file" accept=".pdf,.epub,application/pdf,application/epub+zip"><small>Choose a PDF or EPUB to populate its name and format automatically.</small></div>
          <div class="editor-wide">
            <label for="source-icon-file">Source icon</label>
            <span class="source-symbol" id="source-icon-preview" aria-hidden="true"></span>
            <input type="file" id="source-icon-file" accept="image/png,image/jpeg,image/webp">
            <button class="button" type="button" id="source-icon-remove">Remove icon</button>
          </div>
          <div class="editor-wide"><label for="catalog-title">Source name</label><input id="catalog-title" name="title" required maxlength="512"></div>
          <div class="editor-wide"><label for="catalog-url">Download URL</label><input id="catalog-url" name="source_url" type="url" maxlength="512">
            <small>Direct HTTP(S) download URL, if available.</small></div>
          <div><label for="catalog-format">Content format</label><select id="catalog-format" name="format"><option value="unspecified">Auto / not yet specified</option><option value="zim">Kiwix / ZIM</option><option value="pmtiles">PMTiles map</option><option value="pdf">PDF</option><option value="epub">EPUB</option></select></div>
          <div class="editor-wide"><label for="catalog-description">Description (optional)</label><textarea id="catalog-description" name="description" maxlength="512"></textarea></div>
