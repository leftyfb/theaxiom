<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {% set page = admin_page|default("sources") %}
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
<title>{{ page|capitalize }} · Administration · The Axiom</title>
  <style>
    :root { font-family: ui-sans-serif, system-ui, sans-serif; color:#17332b; background:#eef4f0; --green:#176b4d; --dark:#123c32; --line:#d4e4db; --muted:#587067; --paper:#fff; --accent:#e2f2e9; }
    * { box-sizing: border-box; }
    body { margin: 0; min-width: 280px; }
    a { color: var(--green); }
    a:focus-visible, button:focus-visible { outline: 3px solid #f1b84b; outline-offset: 3px; }
    .skip { position: fixed; left: 1rem; top: -5rem; z-index: 20; padding: .75rem 1rem; color: #fff; background: var(--dark); border-radius: .45rem; }
    .skip:focus { top: 1rem; }
    .site-header { position: sticky; top: 0; z-index: 10; display: flex; align-items: center; gap: .75rem; padding: .75rem 1rem; background: rgba(255,255,255,.97); border-bottom: 1px solid var(--line); }
    .brand { margin-right: auto; color: var(--dark); font-size: 1.05rem; font-weight: 800; text-decoration: none; }
    main { width: min(100% - 2rem, 70rem); margin: 0 auto; padding: 1.5rem 0 3rem; }
    h1 { margin: 0 0 1.5rem; font-size: clamp(1.6rem, 5vw, 2.4rem); }
    .admin-table td.actions { display: flex; flex-wrap: wrap; gap: .4rem; }
    .button { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: .5rem .85rem; border: 1px solid #aac5b7; border-radius: .6rem; background: #fff; color: var(--green); font: inherit; font-weight: 700; cursor: pointer; text-decoration: none; }
    .badge { display: inline-block; padding: .15rem .5rem; border-radius: .35rem; font-size: .75rem; font-weight: 700; }
    .badge.enabled { color: #176b4d; background: #e2f2e9; }
    .badge.disabled { color: #c0392b; background: #fceaea; }
    .empty { padding: 1.5rem; text-align: center; color: var(--muted); }
    @media print { .site-header { display: none; } }
    .settings-panel { background: var(--paper); border: 1px solid var(--line); border-radius: .8rem; padding: 1.25rem; margin: 1rem 0 2rem; }
    .settings-panel fieldset { border: 0; margin: 0; padding: 0; }
    .settings-panel label { display: block; font-weight: 650; margin: .8rem 0 .35rem; }
    .settings-panel input, .settings-panel select { font: inherit; width: min(100%, 40rem); padding: .65rem; border: 1px solid #aac5b7; border-radius: .4rem; background: #fff; color: var(--dark); }
    .settings-actions { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1rem; }
    .storage-status { display: grid; grid-template-columns: minmax(9rem, 1fr) 2fr; gap: .5rem 1rem; }
    .storage-status dt { font-weight: 650; }
    .storage-status dd { margin: 0; overflow-wrap: anywhere; }
    @media (max-width: 500px) { .storage-status { grid-template-columns: 1fr; } .storage-status dd { margin-bottom: .5rem; } }
    .source-card { background: var(--paper); border: 1px solid var(--line); border-radius: .8rem; padding: 1.25rem; margin: 1rem 0; }
    .source-header { display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; }
    .source-header h3 { margin: 0; overflow-wrap: anywhere; }
    .source-header > div { flex: 1; min-width: 0; }
    .source-symbol { background: var(--accent); border-radius: .6rem; padding: .65rem; font-weight: 800; }
    .source-subtitle, .source-note { color: var(--muted); margin: .35rem 0; }
    .source-actions { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: .75rem; }
    .button:disabled { opacity: .55; cursor: not-allowed; }
    .source-card progress { width: 100%; accent-color: var(--green); height: .9rem; }
    .source-card details { margin-top: 1rem; border-top: 1px solid var(--line); padding-top: .6rem; }
    .source-card summary { cursor: pointer; font-weight: 650; min-height: 44px; padding: .55rem 0; color: var(--green); }
    .source-card summary:focus-visible { outline: 3px solid #f1b84b; }
    .source-card [hidden] { display: none !important; }
    .source-live { margin-top: 1rem; }
    .source-live p { margin: .4rem 0; }
    .source-details { overflow-wrap: anywhere; }
    .admin-nav { display:flex; flex-wrap:wrap; gap:.5rem; margin-bottom:1.5rem; }
    .admin-nav a[aria-current="page"] { background:var(--dark); color:white; }
  </style>
</head>
<body>
  <a class="skip" href="#main-content">Skip to administration</a>
  <header class="site-header">
    <a class="brand" href="/">← The Axiom</a>
    <span class="brand">Admin</span>
  </header>
  <main id="main-content">
    <nav class="admin-nav" aria-label="Administration"><a class="button" href="/admin/sources"{% if page == "sources" %} aria-current="page"{% endif %}>Sources</a><a class="button" href="/admin/settings"{% if page == "settings" %} aria-current="page"{% endif %}>Settings</a></nav>
    {% if page == "settings" %}
    <h1>Settings</h1>
    <section class="settings-panel" id="storage-settings" aria-labelledby="storage-title">
      <h2 id="storage-title">Storage preferences</h2>
      <p>Choose an existing directory on the server. For network or removable storage, require the expected mount so a missing drive cannot redirect downloads to the operating system disk.</p>
      <form id="storage-form">
        <fieldset id="storage-fields" disabled>
          <label for="storage-root">Storage root</label>
          <input id="storage-root" type="text" placeholder="/path/to/library" autocomplete="off" required>
          <label for="storage-mode">Storage type</label>
          <select id="storage-mode"><option value="local">Local directory (no required mount)</option><option value="mounted">Require a specific mounted filesystem</option></select>
          <div id="mount-fields" hidden>
            <label for="storage-mount">Expected mount target</label>
            <input id="storage-mount" type="text" placeholder="/path/to/mount" autocomplete="off">
            <label for="storage-source">Expected mount source</label>
            <input id="storage-source" type="text" placeholder="server:/export or device source" autocomplete="off">
          </div>
          <label for="minimum-free">Minimum available bytes (optional; 0 uses content size)</label>
          <input id="minimum-free" type="number" min="0" max="9007199254740991" step="1" value="0">
          <div class="settings-actions">
            <button class="button" type="submit">Save and validate</button>
            <button class="button" type="button" id="storage-refresh">Reload saved settings</button>
          </div>
        </fieldset>
      </form>
      <p id="storage-feedback" role="status" aria-live="polite">Loading storage preferences…</p>
      <h3>Saved storage status</h3>
      <dl id="storage-status" class="storage-status" aria-live="polite">
        <dt>Readiness</dt><dd id="status-ready">Not checked</dd>
        <dt>Configured root</dt><dd id="status-root">—</dd>
        <dt>Detected mount</dt><dd id="status-mount">—</dd>
        <dt>Filesystem / source</dt><dd id="status-source">—</dd>
        <dt>Total capacity</dt><dd id="status-total">—</dd>
        <dt>Available capacity</dt><dd id="status-free">—</dd>
        <dt>Write readiness (advisory)</dt><dd id="status-write">—</dd>
        <dt>Staging directory</dt><dd id="status-staging">—</dd>
        <dt>Verified library directory</dt><dd id="status-library">—</dd>
      </dl>
      <p>Readiness is advisory. Saving settings does not move or create content. Acquisitions remain disabled until safe download and recovery support is implemented.</p>
    </section>
    {% if password_change_enabled %}
    <section class="settings-panel" id="admin-password" aria-labelledby="password-title">
      <h2 id="password-title">Change administrator password</h2>
      <p>Choose a unique password of 8–256 printable non-space ASCII characters. Changing it immediately invalidates the old password. On this HTTP development site, credentials are not encrypted in transit.</p>
      <form id="password-form">
        <fieldset id="password-fields">
          <label for="current-password">Current password</label>
          <input id="current-password" type="password" autocomplete="current-password" required maxlength="256">
          <label for="new-password">New password</label>
          <input id="new-password" type="password" autocomplete="new-password" required minlength="8" maxlength="256">
          <label for="confirm-password">Confirm new password</label>
          <input id="confirm-password" type="password" autocomplete="new-password" required minlength="8" maxlength="256">
          <div class="settings-actions"><button class="button" type="submit">Change password</button></div>
        </fieldset>
      </form>
      <p id="password-feedback" role="status" aria-live="polite"></p>
    </section>
    {% endif %}
    {% else %}
    <h1>Manage offline sources</h1>
    <h2 id="sources">Content sources</h2>
    <p class="source-note">Acquisition controls are disabled until safe download and recovery support is ready.</p>
    <div id="source-cards">
    {% if offline_library_kiwix_zim_enabled %}
      {% set source = offline_library_kiwix_zim %}
      <article class="source-card" data-source-id="wikipedia-en" aria-labelledby="wikipedia-title">
        <header class="source-header">
          <span class="source-symbol" aria-hidden="true">W</span>
          <div>
            <h3 id="wikipedia-title">{{ source.title }}</h3>
            <p class="source-subtitle">Kiwix ZIM · English · {{ (source.bytes / 1073741824)|round(2) }} GiB</p>
          </div>
          <span class="badge" data-field="status" role="status">Waiting for status…</span>
        </header>
        <div class="source-live">
          <p data-field="metrics" hidden></p>
          <progress data-field="transfer" max="100" value="0" aria-label="Archive download progress" hidden></progress>
          <p data-field="verification-label" hidden>Checksum verification in progress — percentage unavailable.</p>
          <progress data-field="verification" aria-label="Checksum verification in progress" hidden></progress>
          <p class="source-note" data-field="rate" hidden></p>
          <p data-field="detail" class="source-note" hidden></p>
        </div>
        <div class="source-actions" aria-label="Source actions">
          <button class="button" type="button" data-action="download-zim" disabled>Download</button>
          <button class="button" type="button" data-action="redownload-zim" disabled>Re-download</button>
          <button class="button" type="button" data-action="update-zim" disabled>Update</button>
        </div>
        <div class="source-actions" aria-label="Publication controls">
          <button class="button" type="button" id="publication-toggle" disabled>Publish</button>
          <a class="button" id="publication-browse" href="/read/wikipedia-en" hidden>Browse</a>
          <span id="publication-status" role="status">Checking publication…</span>
        </div>
        <details>
          <summary>Source details</summary>
          <dl class="storage-status source-details">
            <dt>Archive filename</dt><dd>{{ source.filename }}</dd>
            <dt>Catalog date</dt><dd>{{ source.catalog_date or '—' }}</dd>
            <dt>Publisher</dt><dd>{{ source.publisher or '—' }}</dd>
            <dt>Language</dt><dd>{{ source.language or '—' }}</dd>
            <dt>Source URL</dt><dd>{{ source.source_url }}</dd>
            <dt>Expected SHA-256</dt><dd>{{ source.sha256 }}</dd>
            <dt>License</dt><dd>{{ source.license or '—' }}</dd>
            <dt>Verification</dt><dd data-field="verified">Not confirmed</dd>
            <dt>Last sample</dt><dd data-field="sample">—</dd>
          </dl>
        </details>
      </article>
    {% endif %}
    {% for source in offline_library_content_manifest %}
      <article class="source-card">
        <header class="source-header">
          <div><h3>{{ source.title }}</h3><p class="source-subtitle">{{ source.kind }}</p></div>
          <span class="badge">Status unavailable</span>
        </header>
        <div class="source-actions">
          <button class="button" type="button" disabled>Download</button>
          <button class="button" type="button" disabled>Re-download</button>
          <button class="button" type="button" disabled>Update</button>
        </div>
        <details><summary>Source details</summary><dl class="storage-status"><dt>Retrieved (catalog)</dt><dd>{{ source.retrieved or '—' }}</dd></dl></details>
      </article>
    {% endfor %}
    {% if not offline_library_content_manifest and not offline_library_kiwix_zim_enabled %}
      <p class="empty">No managed sources configured.</p>
    {% endif %}
    </div>
    {% endif %}
  </main>
  {% if page == "sources" %}
  <script id="acquisition-monitor-script">
    (() => {
      const cards = Array.from(document.querySelectorAll('.source-card[data-source-id]'));
      if (!cards.length) return;
      const labels = {downloading: 'Downloading', verifying: 'Verifying checksum',
        publishing: 'Promoting / verifying final file', completed: 'Archive verified',
        retrying: 'Waiting to retry', failed: 'Failed', interrupted: 'Interrupted',
        not_started: 'Not started', unavailable: 'Service not installed', unknown: 'Status unknown'};
      const gib = bytes => (bytes / 1073741824).toFixed(2) + ' GiB';
      function render(card, job, stale, unavailable = false) {
        const field = name => card.querySelector('[data-field="' + name + '"]');
        const put = (name, value) => {
          const node = field(name);
          node.textContent = value;
          node.hidden = !value;
        };
        const status = unavailable ? 'Status unavailable' : !job ? 'Waiting for status' :
          stale ? 'Stale sample — status unknown' : (labels[job.state] || 'Status unknown');
        put('status', status);
        field('status').className = 'badge' + (!stale && job?.state === 'completed' && job.verified === true ?
          ' enabled' : !stale && job?.state === 'failed' ? ' disabled' : '');
        const progress = field('transfer');
        const valid = Number.isFinite(job?.downloaded_bytes) && job.downloaded_bytes >= 0 &&
          Number.isFinite(job.expected_bytes) && job.expected_bytes > 0 && job.downloaded_bytes <= job.expected_bytes;
        progress.hidden = !valid;
        progress.value = valid ? 100 * job.downloaded_bytes / job.expected_bytes : 0;
        put('metrics', valid ? (stale ? 'Last observed download: ' : 'Download: ') +
          progress.value.toFixed(2) + '% · ' + gib(job.downloaded_bytes) + ' / ' + gib(job.expected_bytes) : '');
        const checking = !stale && (job?.state === 'verifying' || job?.state === 'publishing');
        const verify = field('verification');
        verify.hidden = !checking;
        const measured = checking && job.state === 'verifying' &&
          Number.isFinite(job.checksum_bytes) && job.checksum_bytes >= 0 &&
          Number.isFinite(job.expected_bytes) && job.expected_bytes > 0 &&
          job.checksum_bytes <= job.expected_bytes;
        const pass = measured && Number.isInteger(job.checksum_pass) &&
          Number.isInteger(job.checksum_passes) && job.checksum_pass > 0 &&
          job.checksum_pass <= job.checksum_passes ?
          ' pass ' + job.checksum_pass + ' of ' + job.checksum_passes : '';
        if (measured) {
          verify.max = 100;
          verify.value = 100 * job.checksum_bytes / job.expected_bytes;
        } else {
          verify.removeAttribute('value');
        }
        put('verification-label', checking ? (measured ?
          'Checksum' + pass + ' verification in progress — ' + verify.value.toFixed(1) +
          '% read (estimated; digest not yet confirmed).' :
          'Checksum / publishing in progress — percentage unavailable.') : '');
        const rate = !stale && job?.state === 'downloading' && job.speed_bytes_per_second > 0 ?
          (job.speed_bytes_per_second / 1048576).toFixed(2) + ' MiB/s' +
          (Number.isFinite(job.eta_seconds) ? ' · ' + Math.ceil(job.eta_seconds / 60) + ' min remaining (transfer only)' : '') : '';
        put('rate', rate);
        put('detail', job?.detail || '');
        put('verified', !stale && job?.verified === true ? 'Confirmed by acquisition service' : 'Not confirmed');
        put('sample', Number.isFinite(job?.sampled_at) ? new Date(job.sampled_at * 1000).toLocaleString() : '—');
      }
      async function refresh() {
        const controller = new AbortController();
        const timer = window.setTimeout(() => controller.abort(), 5000);
        try {
          const response = await fetch('/api/acquisitions', {cache: 'no-store', signal: controller.signal});
          if (!response.ok) throw new Error('Status unavailable');
          const data = await response.json();
          const jobs = new Map((data.acquisitions || []).map(job => [job.source_id, job]));
          cards.forEach(card => render(card, jobs.get(card.dataset.sourceId), data.stale !== false));
        } catch (_) {
          cards.forEach(card => render(card, null, true, true));
        } finally {
          window.clearTimeout(timer);
          window.setTimeout(refresh, 2000);
        }
      }
      refresh();
    })();
  </script>
  {% if offline_library_kiwix_zim_enabled %}
  <script id="publication-script">
    (() => {
      const button = document.getElementById('publication-toggle');
      const browse = document.getElementById('publication-browse');
      const label = document.getElementById('publication-status');
      let state, busy = false;
      async function refresh() {
        if (busy) return;
        try {
          const response = await fetch('/api/publication', {cache:'no-store'});
          if (!response.ok) throw new Error();
          const next = (await response.json())['wikipedia-en'];
          if (busy) return;
          state = next;
          button.textContent = state.enabled ? 'Unpublish' : 'Publish';
          button.disabled = !state.enabled && !state.serving;
          browse.hidden = !state.published;
          label.textContent = state.published ? 'Published · available in library' :
            state.enabled ? 'Enabled · reader unavailable' :
            state.serving ? 'Unpublished · ready to publish' : 'Unpublished · reader not ready';
        } catch (_) {
          button.disabled = true;
          browse.hidden = true;
          label.textContent = 'Publication status unavailable';
        }
      }
      button.addEventListener('click', async () => {
        if (busy || !state) return;
        busy = true;
        button.disabled = true;
        try {
          const response = await fetch('/api/publication', {method:'POST',
            headers:{'Content-Type':'application/json'},
            body:JSON.stringify({source_id:'wikipedia-en', enabled:!state.enabled})});
          if (!response.ok) throw new Error((await response.json()).error || 'Publication failed');
        } catch (error) {
          label.textContent = error.message;
          window.alert(error.message);
        } finally {
          busy = false;
          await refresh();
        }
      });
      refresh();
      window.setInterval(refresh, 3000);
    })();
  </script>
  {% endif %}
  {% else %}
  <script id="storage-settings-script">
    (() => {
      const byId = (id) => document.getElementById(id);
      const form = byId('storage-form');
      const fields = byId('storage-fields');
      const feedback = byId('storage-feedback');
      const root = byId('storage-root');
      const mode = byId('storage-mode');
      const mount = byId('storage-mount');
      const source = byId('storage-source');
      const minimum = byId('minimum-free');
      const errors = {
        storage_not_configured: 'Choose and save a storage root first.',
        required_mount_missing_or_replaced: 'The expected filesystem is missing or has been replaced.',
        read_only_filesystem: 'The filesystem is read-only.',
        nested_or_replaced_mount: 'A managed directory is on an unexpected mount.',
        storage_root_missing: 'The storage root does not exist.',
        symlink_not_allowed: 'Symbolic links are not allowed in managed paths.',
        storage_path_not_directory: 'A storage path is not a directory.',
        storage_not_writable: 'The application cannot write to the selected directory.',
        insufficient_capacity: 'Not enough free space for the configured minimum or selected content.',
        mount_changed_during_inspection: 'The mount changed during validation. Check again.',
        storage_io_error: 'Storage is unavailable or could not be inspected.'
      };
      function syncMode() {
        const required = mode.value === 'mounted';
        byId('mount-fields').hidden = !required;
        mount.disabled = source.disabled = !required;
        mount.required = source.required = required;
      }
      function size(bytes) {
        if (typeof bytes !== 'number' || !Number.isFinite(bytes)) return '—';
        const units = ['B', 'KiB', 'MiB', 'GiB', 'TiB', 'PiB', 'EiB'];
        let value = bytes, unit = 0;
        while (value >= 1024 && unit < units.length - 1) { value /= 1024; unit++; }
        return value.toFixed(unit ? 2 : 0) + ' ' + units[unit];
      }
      function renderStatus(status) {
        const put = (id, value) => { byId(id).textContent = value || '—'; };
        put('status-ready', status.ready === true ? 'Ready (advisory)' :
          (status.error ? 'Not ready: ' + (errors[status.error] || status.error) : 'Not checked'));
        put('status-root', status.root);
        put('status-mount', status.mount?.target);
        put('status-source', status.mount ? status.mount.type + ' · ' + status.mount.source : '');
        put('status-total', size(status.total_bytes));
        put('status-free', size(status.free_bytes));
        put('status-write', status.ready === true && status.write_ready === true ? 'Writable (advisory)' : 'Not verified');
        put('status-staging', status.paths?.staging);
        put('status-library', status.paths?.library);
      }
      async function json(url, options) {
        const response = await fetch(url, {...options, cache: 'no-store'});
        const body = await response.json();
        if (!response.ok) throw new Error(body.error || 'Request failed (' + response.status + ')');
        return body;
      }
      async function statusCheck() {
        renderStatus({});
        try {
          const status = await json('/api/storage-status');
          renderStatus(status);
          return status.ready === true;
        } catch (error) {
          renderStatus({error: error.message});
          return false;
        }
      }
      function populate(settings) {
        root.value = settings.storage_root;
        mode.value = settings.storage_mount ? 'mounted' : 'local';
        mount.value = settings.storage_mount;
        source.value = settings.storage_source;
        minimum.value = String(settings.minimum_free_bytes);
        syncMode();
      }
      async function load() {
        fields.disabled = true;
        feedback.textContent = 'Loading saved preferences…';
        try {
          populate(await json('/api/storage-settings'));
          const ready = await statusCheck();
          feedback.textContent = ready ? 'Saved preferences loaded.' : 'Saved preferences loaded; storage is not ready.';
        } catch (error) {
          renderStatus({error: error.message});
          feedback.textContent = 'Could not load saved preferences: ' + error.message + '. Enter a new configuration and save explicitly to replace it.';
        } finally {
          fields.disabled = false;
        }
      }
      mode.addEventListener('change', syncMode);
      byId('storage-refresh').addEventListener('click', load);
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const bytes = Number(minimum.value || '0');
        if (!Number.isSafeInteger(bytes) || bytes < 0) {
          feedback.textContent = 'Minimum available bytes must be a non-negative whole number within the supported range.';
          return;
        }
        const settings = {storage_root: root.value.trim(),
          storage_mount: mode.value === 'mounted' ? mount.value.trim() : '',
          storage_source: mode.value === 'mounted' ? source.value.trim() : '',
          minimum_free_bytes: bytes, directories: ['staging', 'library']};
        fields.disabled = true;
        feedback.textContent = 'Saving preferences…';
        try {
          populate(await json('/api/storage-settings', {method: 'POST',
            headers: {'Content-Type': 'application/json'}, body: JSON.stringify(settings)}));
          const ready = await statusCheck();
          feedback.textContent = ready ? 'Preferences saved. Storage is ready (advisory).' :
            'Preferences saved, but storage is not ready. See the status below.';
        } catch (error) {
          feedback.textContent = 'Save failed: ' + error.message + '. Previously saved preferences were not confirmed changed.';
        } finally {
          fields.disabled = false;
        }
      });
      load();
    })();
  </script>
  {% if password_change_enabled %}
  <script id="admin-password-script">
    (() => {
      const byId = id => document.getElementById(id);
      const form = byId('password-form');
      const feedback = byId('password-feedback');
      const fields = byId('password-fields');
      form.addEventListener('submit', async event => {
        event.preventDefault();
        const current = byId('current-password'), next = byId('new-password'), confirm = byId('confirm-password');
        if (next.value !== confirm.value) {
          feedback.textContent = 'New passwords do not match.';
          return;
        }
        fields.disabled = true;
        feedback.textContent = 'Changing password…';
        try {
          const response = await fetch('/api/admin/password', {
            method: 'POST', headers: {'Content-Type': 'application/json'},
            cache: 'no-store', body: JSON.stringify({current_password: current.value,
              new_password: next.value, confirm_password: confirm.value})
          });
          const result = await response.json();
          if (!response.ok || result.changed !== true) throw new Error(result.error || 'Password change failed');
          feedback.textContent = 'Password changed. Reload the admin page and sign in with the new password. If your browser keeps the old credentials, close its session or use a private window.';
        } catch (error) {
          feedback.textContent = 'Could not confirm password change: ' + error.message;
        } finally {
          current.value = next.value = confirm.value = '';
          fields.disabled = false;
        }
      });
    })();
  </script>
  {% endif %}
  {% endif %}
</body>
</html>