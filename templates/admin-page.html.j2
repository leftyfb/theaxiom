          <button class="button" type="button" data-zim-control="resume" hidden>Resume</button>
          <button class="button" type="button" data-zim-control="revalidate" hidden>Recheck saved file (offline)</button>
          <button class="button" type="button" data-zim-control="retry" hidden>Retry (max 3)</button>
          <button class="button danger-action" type="button" data-zim-control="restart" hidden>Restart from beginning</button>
          <button class="button" type="button" data-zim-control="cancel-keep" hidden>Cancel · keep partial</button>
          <button class="button danger-action" type="button" data-zim-control="cancel" hidden>Cancel · discard partial</button>
          {% endif %}
          {% if document %}
          {% if source.pdf_download %}
          <button class="button" type="button" data-pdf-download{% if pub.enabled %} hidden{% endif %}{% if pub.enabled or source.mutation_blocked or pub.error %} disabled{% endif %}>{{ 'Re-download' if source.installed_verified else 'Download from URL' }}</button>
          {% elif not url_managed %}
          <button class="button" type="button" data-pdf-upload{% if pub.enabled %} hidden{% endif %}{% if pub.enabled or source.mutation_blocked or pub.error %} disabled{% endif %}>{{ 'Replace' if source.installed_verified else 'Upload' }} {{ source.adapter|upper }}</button>
          <input type="file" accept=".{{ source.adapter }},{{ 'application/epub+zip' if source.adapter == 'epub' else 'application/pdf' }}" data-pdf-file hidden aria-label="Choose {{ source.adapter|upper }} file">
          {% endif %}
          {% endif %}
          {% if pub %}
          <button class="button" type="button" data-field="publication-toggle" data-enabled="{{ 'true' if pub.enabled else 'false' }}" data-acknowledge-rights="{{ 'true' if pub.requires_rights_acknowledgement else 'false' }}"{% if not pub.enabled and ((not pub.serving and not pub.requires_rights_acknowledgement and not pub.ready_for_publication) or source.mutation_blocked) %} disabled{% endif %}>{{ 'Unpublish' if pub.enabled else 'Publish' }}</button>
          <a class="button" data-field="publication-browse" href="{{ pub.entry_path }}"{% if not pub.published %} hidden{% endif %}>Browse</a>
          {% endif %}
          <button class="button" type="button" data-catalog-edit="{{ source.source_id }}"{% if source.mutation_blocked or pub.error %} disabled{% endif %}>Edit</button>
          <details class="source-more-actions">
            <summary class="button">More actions</summary>
            <div class="source-actions">
              {% if document or source.zim_download %}
              <button class="button danger-action" type="button" data-delete-downloads{% if not document and not source.installed_verified %} hidden{% endif %}{% if source.mutation_blocked or pub.error or source.replacement %} disabled{% endif %}>Delete downloaded files</button>
              {% if source.zim_download %}
              <button class="button" type="button" data-zim-replacement="prepare" hidden>Prepare replacement from profile</button>
              <button class="button danger-action" type="button" data-delete-staged-update hidden>Delete staged update files</button>
              {% endif %}
              {% endif %}
              <button class="button danger-action" type="button" data-catalog-remove="{{ source.source_id }}"{% if source.mutation_blocked or pub.error %} disabled{% endif %}>Remove source</button>
            </div>
            {% if document or source.zim_download %}<p class="source-note" data-delete-feedback role="status"></p>{% endif %}
          </details>
        </div>
        {% if source.zim_download %}<p class="source-note" data-zim-feedback role="status" aria-live="polite"></p>{% endif %}
        {% if document %}
        <div class="busy-indicator" data-pdf-busy hidden><span class="busy-spinner" aria-hidden="true"></span><span role="status" data-pdf-busy-text></span></div>
        <p class="source-note" data-pdf-feedback role="status"></p>
        {% if url_managed and not source.pdf_download %}<p class="source-note">Configured download URL is unsupported. Edit the source URL.</p>{% endif %}
        {% elif source.acquisition_reason and source.acquisition_reason != 'acquisition disabled pending storage safety integration' %}<p class="source-note" data-field="acquisition-reason">{{ source.acquisition_reason }}</p>{% endif %}
        {% if pub %}<p class="source-note" data-publication-feedback role="status"></p>{% endif %}
        {% if pub %}<p class="source-note" data-field="publication-status" role="status"{% if pub.published %} hidden{% endif %}>{{ publication_label }}</p>{% endif %}
        <dl class="source-metadata">
          {% for name in ('author', 'publisher', 'edition', 'language') %}
          {% set installed_edition = source.installed_edition if name == 'edition' else none %}
          {% set value = installed_edition or source.profile.get(name, '') %}
          <div{% if not value %} hidden{% endif %}><dt>{{ 'Installed edition' if installed_edition else name|capitalize }}:</dt><dd data-source-profile="{{ name }}">{{ value }}</dd></div>
          {% endfor %}
        </dl>
        <details class="source-technical">
          <summary>Technical details</summary>
          {% if discovery %}
          <p class="source-note">Update discovery: {{ {'head': 'HTTPS / ETag', 'kiwix': 'Kiwix OPDS / Metalink', 'archive': 'Internet Archive editions', 'builds': 'Protomaps map builds', 'manual': 'Manual update discovery'}.get(discovery.method, 'Unknown') }} · Periodic checks {{ 'enabled' if discovery.periodic else 'disabled' }}</p>
          {% endif %}
          <p class="source-note" data-field="update-evidence">
            {% if source.update_check %}{{ source.update_check.evidence }}{% endif %}
          </p>
        {% if source.zim_download %}
        <p class="source-note" data-field="update-details"{% if not source.update_check or source.update_check.state != "update_available" %} hidden{% endif %}>
        {% if source.update_check and source.update_check.state == "update_available" %}
          Installed edition: {{ source.update_check.installed_edition }} · Publisher edition: {{ source.update_check.candidate_edition }}
          {% if source.update_check.candidate_bytes %}
            · Estimated transfer and staging: {{ source.update_check.candidate_bytes | filesizeformat }}
            · Installed and candidate archives together:
              {{ ((source.artifact.bytes + source.update_check.candidate_bytes) | filesizeformat)
                 if source.installed_verified and source.artifact and source.artifact.bytes else 'unknown' }}
          {% endif %}
          · Check recorded: {{ source.update_check.checked_at }}
          · Candidate: {{ source.update_check.candidate_url }}
          · The installed edition remains in service until you publish the verified update.
        {% endif %}
        </p>
        {% endif %}

          <dl class="storage-status source-details">
            {% if document %}
            {% for key, label in [('source_url','Source URL'),('expected_size_bytes','Expected size (bytes)'),('sha256','Expected SHA-256'),('provenance','Provenance'),('license','License')] %}
            {% set value = source.configuration.get(key, '') %}
            <dt{% if not value %} hidden{% endif %}>{{ label }}</dt><dd data-source-config="{{ key }}"{% if not value %} hidden{% endif %}>{{ value }}</dd>
            {% endfor %}
            {% for key, label in [('filename','Artifact filename'),('bytes','Artifact size (bytes)'),('sha256','Artifact SHA-256')] %}
            {% set value = (source.artifact|default({}, true)).get(key, '') %}
            <dt{% if value == '' %} hidden{% endif %}>{{ label if value != '' else '' }}</dt><dd data-source-artifact="{{ key }}"{% if value == '' %} hidden{% endif %}>{{ value }}</dd>
            {% endfor %}
            {% else %}
            {% for key, label in [('source_url','Source URL'),('expected_size_bytes','Expected size (bytes)'),('sha256','Expected SHA-256'),('provenance','Provenance'),('license','License')] if source.configuration.get(key) %}
            <dt>{{ label }}</dt><dd>{{ source.configuration.get(key) }}</dd>
            {% endfor %}
            {% if source.artifact %}
            {% if source.artifact.filename %}<dt>Artifact filename</dt><dd>{{ source.artifact.filename }}</dd>{% endif %}
            <dt>Artifact size (bytes)</dt><dd>{{ source.artifact.bytes }}</dd>
            <dt>Artifact SHA-256</dt><dd>{{ source.artifact.sha256 }}</dd>
            {% endif %}
            {% endif %}
            {% if not document and source.adapter %}<dt>Last sample</dt><dd data-field="sample">—</dd>{% endif %}
            {% if source.zim_download or (source.acquisition|default({}, true)).get("attempt_history") %}
            <dt>Last successful acquisition</dt><dd data-field="last-acquisition">—</dd>
            <dt>Recent download attempts</dt><dd data-field="acquisition-history">No attempts recorded.</dd>
            {% endif %}
          </dl>
        </details>
        </div>
      </details></div>
    {% else %}
      <p class="empty">No managed sources configured.</p>
    {% endfor %}
    </div>
    </div>
    {% endif %}
  </main>
  <script id="admin-session-script">
    window.axiomCsrfHeaders = () => {
      const token = document.querySelector('meta[name="theaxiom-csrf"]')?.content;
      return token ? {'X-Axiom-CSRF':token} : {};
    };
    document.getElementById('admin-logout')?.addEventListener('click', async () => {
      const response = await fetch('/api/admin/logout', {
        method:'POST',headers:{...((typeof window !== 'undefined' && window.axiomCsrfHeaders?.()) || {}),'Content-Type':'application/json',...window.axiomCsrfHeaders()},
        body:'{}',cache:'no-store'
      });
      if (response.ok) window.location.assign('/admin/login');
    });
  </script>
  <script id="mobile-admin-script">
    (() => {
      const media = matchMedia('(max-width: 640px)');
      const menu = document.getElementById('mobile-admin-menu');
      const logout = document.getElementById('admin-logout');
      document.getElementById('mobile-admin-tools').append(logout);
      function layout() {
        document.body.classList.toggle('compact-admin', media.matches);
        menu.open = false;
      }
      menu.querySelector('div').addEventListener('click', () => {
        menu.open = false;
        if (!document.querySelector('dialog[open]')) menu.querySelector('summary').focus({preventScroll:true});
      });
      const menus = [...document.querySelectorAll('.mobile-admin-toolbar > details')];
      document.addEventListener('click', event => {
        for (const item of menus) if (!item.contains(event.target)) item.open = false;
      });
      media.addEventListener('change', layout);
      layout();
    })();
  </script>
  {% if page == "sources" %}
  <script id="source-catalog-script">
    (() => {
      const feedback = document.getElementById('catalog-feedback');
      let revision = {{ (catalog|default({})).revision|default(none)|tojson }};
      window.axiomSourceRevision = () => revision;
      window.axiomSetSourceRevision = value => { revision = value; };
      const stateKey = 'theaxiom-source-view';
      try {
        const saved = JSON.parse(sessionStorage.getItem(stateKey) || 'null');
        sessionStorage.removeItem(stateKey);
        if (saved) {
          document.querySelectorAll('.source-card').forEach(card => {
            card.open = saved.open.includes(card.dataset.sourceId);
          });
          document.querySelectorAll("[data-group-select]").forEach(item => { item.checked = (saved.selected || []).includes(item.value); });
          document.getElementById("group-panel").open = !!saved.groupsOpen;
          document.body.classList.toggle('selection-actions-open', !!saved.selectionActionsOpen);
          document.getElementById('mobile-actions-open').setAttribute('aria-expanded', String(!!saved.selectionActionsOpen));
          document.getElementById("source-select-mode").setAttribute("aria-pressed", String(!!saved.selecting));
          requestAnimationFrame(() => window.scrollTo(0, saved.scroll));
        }
      } catch (_) { /* Storage may be disabled. */ }
      function reloadSources() {
        try {
          sessionStorage.setItem(stateKey, JSON.stringify({
            open: Array.from(document.querySelectorAll('.source-card[open]'), card => card.dataset.sourceId),
            scroll: window.scrollY,
            selected: Array.from(document.querySelectorAll("[data-group-select]:checked"), item => item.value),
            groupsOpen: document.getElementById("group-panel").open,
            selectionActionsOpen: document.body.classList.contains('selection-actions-open'),
            selecting: document.getElementById("source-select-mode").getAttribute("aria-pressed") === "true",
            filters: window.axiomSourceFilters?.values()
          }));
        } catch (_) { /* Reload remains available without session storage. */ }
        window.location.reload();
      }

      let lastSourceAction;
      let filteredActionTimer;
      function sourceAction(card, status) {
        window.clearTimeout(filteredActionTimer);
        lastSourceAction = {card, status};
        showFilteredAction();
        return lastSourceAction;
      }
      function finishSourceAction(action) {
        if (lastSourceAction !== action) return;
        action.completed = true;
        window.clearTimeout(filteredActionTimer);
        filteredActionTimer = window.setTimeout(() => {
          if (lastSourceAction !== action) return;
          lastSourceAction = undefined;
          showFilteredAction();
        }, 5000);
      }
      function showFilteredAction() {
        const notice = document.getElementById('filtered-action-feedback');
        const {card, status} = lastSourceAction || {};
        const message = card && (card.hidden || lastSourceAction.completed) && status();
        const text = message ? card.dataset.filterTitle + ' — ' + message : '';
        if (notice.textContent !== text) notice.textContent = text;
        notice.hidden = !text;
      }
      document.addEventListener('axiom-source-filters-changed', showFilteredAction);

      function restoreActionFocus(card, trigger, hadFocus) {
        if (!hadFocus || document.activeElement !== document.body || card.hidden || !card.open) return;
        (trigger.disabled || trigger.hidden ? card.querySelector('.source-header') : trigger).focus({preventScroll: true});
      }

      const groupKind = document.getElementById('group-kind');
      const groupExisting = document.getElementById('group-existing');
      const groupName = document.getElementById('group-name');
      const groupFeedback = document.getElementById('group-feedback');
      const groupChecks = Array.from(document.querySelectorAll('[data-group-select]'));
      const groupButtons = Array.from(document.querySelectorAll('#group-panel button, #source-selection-panel button:not(#source-select-mode)'));
      const selectMode = document.getElementById('source-select-mode');
      const selectAll = document.getElementById('group-select-all');
      const visibleChecks = () => groupChecks.filter(item => !item.closest('.source-row').querySelector('.source-card').hidden);
      let selecting = selectMode.getAttribute('aria-pressed') === 'true';
      let bulkBusy = false;
      const selectedIds = () => selecting ? groupChecks.filter(item => item.checked).map(item => item.value) : [];
      const selectionDialog = document.getElementById('selection-file-dialog');
      const selectionFile = document.getElementById('selection-file');
      const selectionPreset = document.getElementById('selection-preset');
      const selectionFeedback = document.getElementById('selection-file-feedback');
      const selectionMatches = document.getElementById('selection-file-matches');
      const selectionApply = document.getElementById('selection-file-apply');
      const selectionStorage = document.getElementById('selection-storage-summary');
      const selectionCapacity = document.getElementById('selection-storage-capacity');
      let matchedSelection = [];
      async function selectionRequest(payload) {
        const response = await fetch('/api/library-selection', {
          method: 'POST',
          headers: {...(window.axiomCsrfHeaders?.() || {}), 'Content-Type':'application/json'},
          body: JSON.stringify(payload)
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'Selection request failed.');
        return data;
      }
      for (const id of ['selection-file-open', 'selection-file-menu']) {
        document.getElementById(id).addEventListener('click', () => selectionDialog.showModal());
      }
      selectionFile.addEventListener('change', () => {
        const file = selectionFile.files[0];
        selectionFile.value = '';
        if (!file) return;
        selectionPreset.value = '';
        reviewSelection(async () => {
          if (file.size > 15000) throw new Error('Selection file is too large.');
          const manifest = JSON.parse(await file.text());
          return manifest?.kind === 'axiom-local-transfer' ? {transfer_preview: manifest} : {manifest};
        });
      });
      selectionPreset.addEventListener('change', () => {
        const preset = selectionPreset.value;
        reviewSelection(() => preset ? {preset} : null);
      });
      async function reviewSelection(getPayload) {
        selectionMatches.replaceChildren();
        selectionStorage.textContent = selectionCapacity.textContent = '';
        matchedSelection = [];
        selectionApply.disabled = true;
        selectionFile.disabled = selectionPreset.disabled = true;
        selectionFeedback.textContent = 'Checking this catalog…';
        try {
          const payload = await getPayload();
          if (!payload) {
            selectionFeedback.textContent = '';
            return;
          }
          let result = await selectionRequest(payload);
          if (result.transfer_artifacts) {
            const labels = {new_source: 'New source ID', source_exists: 'Local source ID already configured',
              matching_record: 'Matching local verification record',
              conflicting_record: 'Conflicting local verification record'};
            for (const artifact of result.transfer_artifacts) {
              const row = document.createElement('li');
              row.textContent = [artifact.title, labels[artifact.state], artifact.language, artifact.edition, artifact.filename,
                previewSize(artifact.bytes), 'SHA-256 ' + artifact.sha256,
                artifact.license ? 'License: ' + artifact.license : 'Rights not recorded',
                artifact.provenance ? 'Provenance: ' + artifact.provenance : ''].filter(Boolean).join(' · ');
              selectionMatches.append(row);
            }
            selectionFeedback.textContent = 'Transfer manifest reviewed. File verification and import require separate steps.';
            selectionStorage.textContent = 'Declared total size: ' +
              previewSize(result.transfer_artifacts.reduce((sum, artifact) => sum + artifact.bytes, 0));
            return;
          }
          if (result.storage.capacity.state === 'pending') {
            await new Promise(resolve => window.setTimeout(resolve, 600));
            result = await selectionRequest(payload);
          }
          const labels = {match: 'Matches this catalog', different: 'Edition, language, or format differs',
            missing: 'Source ID absent from this catalog', planned: 'No supported format configured'};
          if (payload.preset) labels.match = 'Configured source';
          const plans = new Map(result.storage.sources.map(source => [source.source_id, source]));
          for (const item of result.sources) {
            const row = document.createElement('li');
            const choice = [item.format?.toUpperCase(), item.language, item.edition].filter(Boolean).join(' / ');
            const local = item.local_choice;
            const localChoice = local ? [local.format.toUpperCase(), local.language, local.edition].filter(Boolean).join(' / ') : '';
            const plan = plans.get(item.source_id);
            row.textContent = [item.title || item.source_id, labels[item.state],
              local ? 'Requested ' + choice : choice, local ? 'Local ' + localChoice : '',
              item.license ? 'License: ' + item.license : 'Rights not recorded',
              plan && plan.state !== 'estimated' ? storagePlanNote(plan.state) : '',
              plan?.format === 'zim' && plan.state !== 'unsupported' ? 'Reading requires Kiwix' : ''
            ].filter(Boolean).join(' · ');
            selectionMatches.append(row);
          }
          selectionFeedback.textContent = result.sources.length ? 'Reviewed ' + result.sources.length + ' source choices.' :
            'No sources with a configured size within the lightweight limit.';
          if (result.revision !== revision) {
            selectionFeedback.textContent += ' The catalog changed. Reload before selecting matches.';
            return;
          }
          matchedSelection = result.sources.filter(item => item.state === 'match').map(item => item.source_id);
          selectionApply.disabled = !matchedSelection.length;
          if (matchedSelection.length) {
            selectionStorage.textContent = formatEstimates(result.storage.sources);
            selectionCapacity.textContent = capacitySummary(result.storage.capacity);
          }
        } catch (error) {
          selectionFeedback.textContent = error.message;
        } finally {
          selectionFile.disabled = selectionPreset.disabled = false;
        }
      }
      selectionApply.addEventListener('click', () => {
        if (bulkBusy || !matchedSelection.length) return;
        const matches = new Set(matchedSelection);
        for (const checkbox of groupChecks) checkbox.checked = matches.has(checkbox.value);
        selecting = true;
        selectionMode();
        selectionDialog.close();
        selectMode.focus();
        feedback.textContent = 'Selected ' + matchedSelection.length + ' matching sources. Review storage to plan an acquisition.';
      });
      async function exportSelection(transfer) {
        try {
          const payload = {revision, source_ids: selectedIds()};
          if (transfer) payload.transfer_manifest = true;
          const manifest = (await selectionRequest(payload)).manifest;
          const url = URL.createObjectURL(new Blob([JSON.stringify(manifest)], {type:'application/json'}));
          const link = document.createElement('a');
          link.href = url;
          link.download = transfer ? 'axiom-transfer-manifest.json' : 'axiom-library-selection.json';
          link.click();
          window.setTimeout(() => URL.revokeObjectURL(url), 1000);
        } catch (error) {
          feedback.textContent = error.message;
        }
      }
      document.getElementById('selection-export').addEventListener('click', () => exportSelection(false));
      document.getElementById('transfer-export').addEventListener('click', () => exportSelection(true));
      const previewButton = document.getElementById('bulk-preview');
      const preview = document.getElementById('bulk-preview-result');
      const previewDetails = document.getElementById('bulk-preview-details');
      const moreActions = document.getElementById('bulk-more-actions');
      function closePreview() {
        preview.hidden = true;
        previewButton.setAttribute('aria-expanded', 'false');
        previewIds = '';
      }
      const previewSummary = document.getElementById('bulk-preview-summary');
      const previewCapacity = document.getElementById('bulk-preview-capacity');
      const previewSources = document.getElementById('bulk-preview-sources');
      let previewIds = '', previewRequest = 0, previewRevision;
      function previewSize(bytes) {
        if (!Number.isSafeInteger(bytes) || bytes < 0) return 'unknown';
        const units = ['B', 'kB', 'MB', 'GB', 'TB', 'PB'];
        let unit = 0;
        while (bytes >= 1000 && unit < units.length - 1) {
          bytes /= 1000;
          unit++;
        }
        return bytes.toLocaleString(undefined, {maximumFractionDigits: 2}) + ' ' + units[unit];
      }
      const previewFields = [
        ['Transfer', 'transfer_bytes'], ['Installed', 'installed_bytes'],
        ['Staging', 'staging_bytes'], ['Peak', 'peak_bytes']
      ];
      function estimateSummary(estimates, fields = previewFields) {
        return fields.map(([label, field]) => {
          const known = estimates.map(source => source[field]).filter(Number.isSafeInteger);
          const unknown = estimates.length - known.length;
          if (!known.length) return label + ' unknown';
          return label + ' ' + previewSize(known.reduce((sum, bytes) => sum + bytes, 0)) +
            (unknown ? ' + ' + unknown + ' unknown' : '');
        }).join(' · ');
      }
      function formatEstimates(sources) {
        const zim = sources.filter(source => ['zim', 'pmtiles'].includes(source.format) && source.state !== 'unsupported');
        const documents = sources.filter(source => ['pdf', 'epub'].includes(source.format) && source.state !== 'unsupported');
        const estimates = [];
        if (zim.length) estimates.push('Map and ZIM archives · ' + estimateSummary(zim));
        if (documents.length) {
          const configured = documents.filter(source => source.state === 'estimated');
          if (configured.length) estimates.push('PDF and EPUB · ' + estimateSummary(configured));
          const unavailable = documents.length - configured.length;
          if (unavailable) estimates.push(unavailable + ' PDF or EPUB source(s) lack a usable download configuration');
        }
        return estimates.join(' · ') || 'No supported sources to estimate.';
      }
      function capacitySummary(capacity) {
        return {
          fits: 'Enough space to start.',
          fits_with_unknown_sizes: 'Enough space using the maximum sizes for unknown downloads.',
          insufficient: 'Insufficient space for the staging estimate and configured reserve.',
          uncertain: 'Some staging sizes are unknown.',
          pending: 'Storage capacity check still pending. Preview again to refresh.',
          unavailable: 'Current storage capacity is unavailable.'
        }[capacity.state] || '';
      }
      function capacityDetails(capacity) {
        const upperBound = Number.isSafeInteger(capacity.staging_upper_bound_bytes) ?
          ' Staging could use up to ' + previewSize(capacity.staging_upper_bound_bytes) + '.' : '';
        return Number.isSafeInteger(capacity.available_bytes) ?
          previewSize(capacity.available_bytes) + ' available for staging after the ' +
            previewSize(capacity.reserve_bytes) + ' reserve.' + upperBound : upperBound;
      }
      function storagePlanNote(state) {
        return {
          unsupported: 'Outside the storage preview',
          unavailable: 'Estimate unavailable',
          upload_required: 'Choose a local file to upload',
          invalid_download_url: 'Requires a direct HTTPS download URL',
          over_size_limit: 'Configured size exceeds the document download limit',
          review_replacement: 'Review the replacement before estimating',
          installed: 'Already recorded as installed'
        }[state] || '';
      }
      const queueButton = document.getElementById('bulk-queue');
      const queueFeedback = document.getElementById('bulk-queue-feedback');
      let batchJobIds = [];
      let completedBatch = false;
      window.axiomHandleStaleSources = () => {
        if (completedBatch && !bulkBusy && !formPosting && !document.querySelector('dialog[open]')) {
          reloadSources();
          return;
        }
        if (feedback.querySelector('[data-reload-sources]')) return;
        const reload = document.createElement('button');
        reload.type = 'button';
        reload.className = 'button';
        reload.dataset.reloadSources = 'true';
        reload.textContent = 'Reload sources';
        reload.addEventListener('click', reloadSources);
        feedback.replaceChildren('Source profiles changed. ', reload);
      };
      const queueStates = {
        queued: 'Waiting to download', running: 'Downloading', failed: 'Batch download failed',
        cancelled: 'Batch download cancelled', interrupted: 'Batch download interrupted'
      };
      async function batchRequest(payload) {
        const response = await fetch('/api/acquisition-batch', {
          method: 'POST',
          headers: {...(window.axiomCsrfHeaders?.() || {}), 'Content-Type':'application/json'},
          body: JSON.stringify(payload)
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || 'Batch request failed.');
        return result;
      }
      async function loadQueue() {
        try {
          const response = await fetch('/api/acquisition-batch', {cache: 'no-store'});
          if (!response.ok) return;
          const {jobs, document_retries: documentRetries} = await response.json();
          if (!Array.isArray(jobs)) return;
          if (batchJobIds.length) {
            const watchedJobs = jobs.filter(job => batchJobIds.includes(job.id));
            completedBatch = watchedJobs.length === batchJobIds.length &&
              watchedJobs.every(job => !['queued', 'running'].includes(job.state)) &&
              watchedJobs.some(job => job.state === 'completed');
          }
          const latest = new Map();
          for (const job of jobs) {
            if (!latest.has(job.source_id)) latest.set(job.source_id, job);
          }
          for (const card of document.querySelectorAll('.source-card')) {
            const job = latest.get(card.dataset.sourceId);
            const badge = card.querySelector('[data-batch-status]');
            const cancel = card.querySelector('[data-batch-cancel]');
            const detail = card.querySelector('[data-batch-feedback]');
            const retry = documentRetries?.[card.dataset.sourceId];
            const label = job?.stop && job.state === 'running' ? 'Stopping batch download' :
              retry ? (retry.state === 'retrying' ? 'Waiting to retry' : 'Downloading') +
                ' · automatic retry ' + retry.automatic_retry_count + ' of 3' : queueStates[job?.state] || '';
            if (badge.textContent !== label) badge.textContent = label;
            badge.hidden = !label;
            cancel.hidden = !job || !!job.stop || !['queued', 'running'].includes(job.state);
            cancel.dataset.jobId = job?.id || '';
            const message = detail.dataset.error || (label ? job?.detail || '' : '');
            detail.hidden = !message;
            if (detail.textContent !== message) detail.textContent = message;
          }
        } catch (_) { /* Keep the last queue status available on each card. */ }
      }
      document.querySelectorAll('[data-batch-cancel]').forEach(button => {
        button.addEventListener('click', async () => {
          const card = button.closest('.source-card');
          const detail = card.querySelector('[data-batch-feedback]');
          button.disabled = true;
          delete detail.dataset.error;
          try {
            await batchRequest({cancel: button.dataset.jobId});
            await loadQueue();
          } catch (error) {
            detail.dataset.error = detail.textContent = error.message;
            detail.hidden = false;
          } finally {
            button.disabled = false;
          }
        });
      });
      loadQueue();
      window.setInterval(loadQueue, 3000);
      queueButton.addEventListener('click', async () => {
        const ids = selectedIds();
        if (!ids.length || ids.join(',') !== previewIds || queueButton.disabled) return;
        queueButton.disabled = true;
        try {
          const result = await batchRequest({revision: previewRevision, source_ids: ids, confirm: true});
          batchJobIds = result.job_ids;
          completedBatch = false;
          if (previewIds === ids.join(',')) {
            closePreview();
            previewButton.focus();
          }
          queueFeedback.textContent = 'Downloads submitted. Follow progress on the source cards.';
          await loadQueue();
        } catch (error) {
          queueFeedback.textContent = error.message;
        } finally {
          queueButton.disabled = false;
        }
      });
      previewButton.addEventListener('click', async () => {
        if (!preview.hidden) {
          closePreview();
          return;
        }
        const ids = selectedIds();
        const selection = ids.join(',');
        const requestId = ++previewRequest;
        const requestedRevision = revision;
        const current = () => previewIds === selection && previewRequest === requestId;
        previewIds = selection;
        previewRevision = requestedRevision;
        preview.hidden = false;
        previewButton.setAttribute('aria-expanded', 'true');
        previewDetails.hidden = true;
        previewDetails.open = false;
        previewSummary.textContent = 'Calculating estimates…';
        queueButton.hidden = true;
        queueFeedback.textContent = '';
        previewCapacity.textContent = '';
        previewSources.replaceChildren();
        async function requestPreview() {
          const response = await fetch('/api/acquisition-preview', {
            method: 'POST',
            headers: {...(window.axiomCsrfHeaders?.() || {}), 'Content-Type':'application/json'},
            body: JSON.stringify({revision: requestedRevision, source_ids: ids})
          });
          const result = await response.json();
          if (!response.ok) throw new Error(result.error || 'Storage preview unavailable.');
          return result;
        }
        try {
          let result = await requestPreview();
          if (!current()) return;
          if (result.capacity?.state === 'pending') {
            await new Promise(resolve => window.setTimeout(resolve, 600));
            if (!current()) return;
