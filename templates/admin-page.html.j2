        card.dataset.acquiring = 'true';
        buttons.forEach(button => button.disabled = true);
        feedback.textContent = '';
        busy.hidden = false;
        const formatLabel = card.dataset.filterFormat.toUpperCase();
        busyText.textContent = (file ? 'Uploading and verifying ' : 'Downloading and verifying ') + formatLabel + '…';
        try {
          const response = file
            ? await acquisitionFetch('/api/pdf-upload', {method:'POST', headers:{...((typeof window !== 'undefined' && window.axiomCsrfHeaders?.()) || {}),'Content-Type':card.dataset.filterFormat === 'epub' ? 'application/epub+zip' : 'application/pdf',
                'X-Document-Format':card.dataset.filterFormat, 'X-Source-ID':card.dataset.sourceId, 'X-Catalog-Revision':String(revision)}, body:file})
            : await acquisitionFetch('/api/action', {method:'POST', headers:{...((typeof window !== 'undefined' && window.axiomCsrfHeaders?.()) || {}),'Content-Type':'application/json'},
                body:JSON.stringify({source_id:card.dataset.sourceId, action:card.dataset.filterFormat === 'epub' ? 'epub-download' : 'pdf-download', revision})});
          const result = await response.json().catch(() => ({}));
          if (!response.ok) throw acquisitionError(response, result, 'Document acquisition failed');
          if (!result.installed_verified) throw new Error('Document installation was not confirmed');
          reloadSources();
        } catch (error) {
          feedback.textContent = error.message;
        } finally {
          card.dataset.acquiring = 'false';
          busy.hidden = true;
          buttons.forEach(button => button.disabled = card.dataset.acquisitionBlocked === 'true' || button.hidden);
        }
      }
      document.querySelectorAll('[data-pdf-download]').forEach(button => button.addEventListener('click', () => {
        acquirePDF(button.closest('.source-card'));
      }));
      document.querySelectorAll('[data-pdf-upload]').forEach(button => button.addEventListener('click', () => {
        button.closest('.source-card').querySelector('[data-pdf-file]').click();
      }));
      document.querySelectorAll('[data-pdf-file]').forEach(input => input.addEventListener('change', () => {
        const file = input.files[0];
        input.value = '';
        if (file) acquirePDF(input.closest('.source-card'), file);
      }));
      {% endif %}
      document.querySelectorAll('[data-zim-download]').forEach(button => button.addEventListener('click', async () => {
        if (button.disabled) return;
        button.disabled = true;
        const card = button.closest('.source-card');
        const localFeedback = card.querySelector('[data-zim-feedback]');
        card.dataset.zimPosting = 'true';
        localFeedback.textContent = 'Starting download…';
        try {
          const response = await acquisitionFetch('/api/action', {method:'POST', headers:{...((typeof window !== 'undefined' && window.axiomCsrfHeaders?.()) || {}),'Content-Type':'application/json'},
            body:JSON.stringify({source_id:card.dataset.sourceId, action:'zim-download', revision})});
          const result = await response.json().catch(() => ({}));
          if (!response.ok || !result.accepted) {
            throw new Error(result.error || acquisitionError(response, result, 'ZIM acquisition failed').message);
          }
          localFeedback.textContent = 'Download accepted. Waiting for progress…';
          card.dataset.zimAccepted = 'true';
        } catch(error) {
          localFeedback.textContent = error.message;
        } finally {
          delete card.dataset.zimPosting;
          button.disabled = card.dataset.zimAccepted === 'true' || card.dataset.zimBlocked === 'true';
        }
      }));
      document.querySelectorAll('[data-document-update-check]').forEach(button => button.addEventListener('click', async () => {
        if (button.disabled) return;
        const card = button.closest('.source-card');
        const feedback = card.querySelector('[data-pdf-feedback]');
        button.disabled = true;
        feedback.textContent = 'Checking publisher headers…';
        try {
          const response = await fetch('/api/update-check', {
            method: 'POST',
            headers: {...((typeof window !== 'undefined' && window.axiomCsrfHeaders?.()) || {}), 'Content-Type': 'application/json'},
            body: JSON.stringify({source_id: card.dataset.sourceId, revision})
          });
          const result = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(result.error || 'Document metadata check failed');
          feedback.textContent = result.state === 'representation_changed'
            ? 'Publisher representation changed. A newer verified document edition is not established.'
            : result.state === 'representation_unchanged'
            ? 'Publisher representation matches the captured installed validator.'
            : 'Unable to determine whether the publisher document changed.';
        } catch (error) {
          feedback.textContent = error.message || 'Publisher metadata unavailable.';
        } finally {
          button.disabled = false;
        }
      }));
      document.querySelectorAll('[data-zim-update-check]').forEach(button => button.addEventListener('click', async () => {
        if (button.disabled) return;
        const card = button.closest('.source-card');
        const feedback = card.querySelector('[data-zim-feedback]');
        button.disabled = true;
        card.dataset.zimCheckPosting = 'true';
        feedback.textContent = 'Checking publisher metadata…';
        try {
          const response = await fetch('/api/update-check', {
            method: 'POST',
            headers: {...((typeof window !== 'undefined' && window.axiomCsrfHeaders?.()) || {}), 'Content-Type': 'application/json'},
            body: JSON.stringify({source_id: card.dataset.sourceId, revision})
          });
          const result = await response.json().catch(() => ({}));
          if (!response.ok) throw new Error(result.error || 'Update check failed');
          const badge = card.querySelector('[data-field="update-status"]');
          if (badge) badge.hidden = result.state !== 'update_available';
          feedback.textContent = result.state === 'update_available'
            ? 'Newer publisher edition detected. No download started.'
            : result.state === 'up_to_date'
            ? 'Installed edition matches verified publisher metadata.'
            : result.state === 'no_newer_edition_listed'
            ? 'No newer edition listed in the checked Kiwix catalog. This does not verify the installed archive is the latest everywhere.'
            : 'Unable to determine whether a newer edition is available from publisher metadata.';
          if (result.state === 'unable_to_determine' && typeof result.evidence === 'string' && result.evidence) {
            // The API returns bounded, nonsecret status evidence from the update
            // checker; textContent prevents interpretation as HTML.
            feedback.textContent += ' Reason: ' + result.evidence.slice(0, 180);
          }
        } catch (error) {
          feedback.textContent = error.message || 'Publisher update check unavailable.';
        } finally {
          delete card.dataset.zimCheckPosting;
          button.disabled = false;
        }
      }));
      document.querySelectorAll('[data-zim-delete]').forEach(button => button.addEventListener('click', async () => {
        if (button.disabled || !window.confirm('Permanently delete this installed ZIM archive? This cannot be undone. Unpublish and retire any replacement first.')) return;
        const card = button.closest('.source-card');
        card.dataset.zimDeletePosting = 'true';
        button.disabled = true;
        const feedback = card.querySelector('[data-zim-replacement-status]');
        try {
          const response = await acquisitionFetch('/api/action', {method:'POST',
            headers:{...((typeof window !== 'undefined' && window.axiomCsrfHeaders?.()) || {}),'Content-Type':'application/json'},
            body:JSON.stringify({source_id:card.dataset.sourceId, action:'zim-delete-installed', revision, confirm_restart:true})});
          const result = await response.json().catch(() => ({}));
          if (!response.ok) throw acquisitionError(response, result, 'Archive deletion failed');
          feedback.textContent = 'Installed archive deleted';
          await refresh();
        } catch(error) {
          feedback.textContent = error.message;
        } finally {
          delete card.dataset.zimDeletePosting;
          button.disabled = false;
        }
      }));
      document.querySelectorAll('[data-zim-replacement]').forEach(button => button.addEventListener('click', async () => {
        if (button.disabled) return;
        const card = button.closest('.source-card');
        const operation = button.dataset.zimReplacement;
        if (['activate','rollback'].includes(operation) &&
            !window.confirm(operation === 'activate' ? 'Activate the verified replacement archive?' : 'Restore the previous verified archive?')) return;
        const feedback = card.querySelector('[data-zim-replacement-status]');
        card.dataset.zimReplacementPosting = 'true';
        card.querySelectorAll('[data-zim-replacement]').forEach(b => b.disabled = true);
        try {
          const response = await acquisitionFetch('/api/action', {method:'POST',
            headers:{...((typeof window !== 'undefined' && window.axiomCsrfHeaders?.()) || {}),'Content-Type':'application/json'},
            body:JSON.stringify({source_id:card.dataset.sourceId, action:'zim-replacement-' + operation, revision,
              ...(['activate','rollback'].includes(operation) ? {confirm_restart:true} : {})})});
          const result = await response.json().catch(() => ({}));
          if (!response.ok) throw acquisitionError(response, result, 'Replacement operation failed');
          feedback.textContent = 'Replacement ' + operation + ' accepted; refreshing status…';
          await refresh();
        } catch(error) {
          feedback.textContent = error.message;
        } finally {
          delete card.dataset.zimReplacementPosting;
        }
      }));
      document.querySelectorAll('[data-zim-control]').forEach(button => button.addEventListener('click', async () => {
        if (button.disabled) return;
        const card = button.closest('.source-card');
        const operation = button.dataset.zimControl;
        if (operation === 'cancel' && !window.confirm('Cancel and permanently discard the partial download? Installed versions will be kept.')) return;
        if (operation === 'cancel-keep' && !window.confirm('Cancel this download but retain partial bytes for a possible resume?')) return;
        if (operation === 'restart' && !window.confirm('Restart this download from the beginning? Any retained partial must first be discarded explicitly.')) return;
        if (operation === 'revalidate' && !window.confirm('Recheck the complete retained ZIM using only saved local bytes? No network download will occur.')) return;
        const feedback = card.querySelector('[data-zim-feedback]');
        card.dataset.zimPosting = 'true';
        card.querySelectorAll('[data-zim-control],[data-zim-download]').forEach(b => b.disabled = true);
        try {
          const response = await acquisitionFetch('/api/action', {method:'POST', headers:{...((typeof window !== 'undefined' && window.axiomCsrfHeaders?.()) || {}),'Content-Type':'application/json'},
            body:JSON.stringify({source_id:card.dataset.sourceId, action:'zim-' + operation, revision,
              ...(operation === 'restart' ? {confirm_restart:true} : {})})});
          const result = await response.json().catch(() => ({}));
          if (!response.ok || !result.accepted) throw acquisitionError(response, result, 'ZIM control failed');
          feedback.textContent = operation === 'pause' ? 'Pausing download…' :
            operation === 'cancel' ? 'Cancelling and discarding partial…' :
            operation === 'cancel-keep' ? 'Cancelling and retaining partial…' :
            operation === 'restart' ? 'Restart requested…' :
            operation === 'retry' ? 'Retry requested…' :
            operation === 'revalidate' ? 'Rechecking retained file offline…' : 'Resuming from saved bytes…';
          card.dataset.zimAccepted = 'true';
        } catch(error) {
          feedback.textContent = error.message;
          delete card.dataset.zimAccepted;
        } finally {
          delete card.dataset.zimPosting;
        }
      }));
      document.querySelectorAll('[data-field="publication-toggle"]').forEach(button => button.addEventListener('click', async () => {
        const enabled = button.dataset.enabled !== 'true';
        const acknowledge = enabled && button.dataset.acknowledgeRights === 'true';
        if (acknowledge && !window.confirm("Publish this PDF to library users? Confirm that you have permission to make it available in this library.")) return;
        button.dataset.posting = 'true';
        button.disabled = true;
        try {
          const payload = {source_id:button.closest('.source-card').dataset.sourceId, enabled, revision};
          if (acknowledge) payload.acknowledge_rights = true;
          const response = await fetch('/api/publication', {method:'POST', headers:{...((typeof window !== 'undefined' && window.axiomCsrfHeaders?.()) || {}),'Content-Type':'application/json'},
            body:JSON.stringify(payload)});
          if (!response.ok) throw new Error((await response.json()).error || 'Publication failed');
          reloadSources();
        } catch (error) {
          window.alert(error.message);
          delete button.dataset.posting;
        }
      }));
    })();
  </script>

  <script id="source-filter-script">
    (() => {
      const fields = ['search','publication','download','format','categories','collections','tags','sort'];
      const nodes = Object.fromEntries(fields.map(key => [key, document.getElementById('source-filter-' + key)]));
      const root = document.getElementById('source-cards');
      const cards = Array.from(root.querySelectorAll('.source-card'));
      const groups = {{ ((catalog|default({})).groups|default([]))|tojson }};
      const values = () => Object.fromEntries(fields.map(key => [key,nodes[key].value]));
      const defaults = {sort:'status'};
      const filterToggle = document.getElementById('source-filter-toggle');
      const filterPanel = document.getElementById('source-filters-panel');
      filterToggle.addEventListener('click', () => {
        filterPanel.hidden = !filterPanel.hidden;
        filterToggle.setAttribute('aria-expanded', String(!filterPanel.hidden));
      });
      function rank(card) {
        return card.dataset.filterPublication === 'published' ? 0 : card.dataset.filterDownload === 'downloaded' ? 1 : 2;
      }
      function apply(reorder = false) {
        const v = values(), query = v.search.trim().toLocaleLowerCase();
        let visible = 0;
        for (const card of cards) {
          const data = card.dataset;
          const matches = (!query || data.filterTitle.toLocaleLowerCase().includes(query)) &&
            (!v.publication || data.filterPublication === v.publication) &&
            (!v.download || data.filterDownload === v.download) &&
            (!v.format || data.filterFormat === v.format) &&
            ['categories','collections','tags'].every(kind => !v[kind] ||
              groups.some(g => g.kind === kind && g.group_id === v[kind] && g.source_ids.includes(data.sourceId)));
          card.hidden = !matches;
          card.closest('.source-row').hidden = !matches;
          if (matches) visible++;
        }
        if (reorder) {
          cards.sort((a,b) => (v.sort === 'alpha' ? 0 : rank(a)-rank(b)) ||
            a.dataset.filterTitle.localeCompare(b.dataset.filterTitle, undefined, {sensitivity:'base'}) ||
            a.dataset.sourceId.localeCompare(b.dataset.sourceId));
          for (const card of cards) root.appendChild(card.closest('.source-row'));
        }
        const count = document.getElementById('source-filter-count');
        count.textContent = visible + ' of ' + cards.length + ' sources';
        const active = fields.filter(key => key !== 'search' && v[key] !== (defaults[key] || '')).length;
        const indicator = document.getElementById('source-filter-active');
        indicator.hidden = !active;
        indicator.textContent = String(active);
        document.getElementById('source-filter-empty').hidden = visible !== 0 || cards.length === 0;
        document.dispatchEvent(new Event('axiom-source-filters-changed'));
      }
      const storageKey = 'theaxiom-source-filters';
      try {
        const saved = JSON.parse(sessionStorage.getItem(storageKey) || '{}');
        for (const key of fields) if (typeof saved[key] === 'string') {
          nodes[key].value = saved[key];
          if (key === 'sort' && !nodes[key].value) nodes[key].value = 'status';
        }
      } catch (_) { /* Filtering still works without storage. */ }
      function save() {
        try { sessionStorage.setItem(storageKey, JSON.stringify(values())); } catch (_) {}
      }
      fields.forEach(key => nodes[key].addEventListener(key === 'search' ? 'input' : 'change', () => {
        save(); apply(key === 'sort');
      }));
      document.getElementById('source-filter-reset').addEventListener('click', () => {
        fields.forEach(key => { nodes[key].value = defaults[key] || ''; });
        save(); apply(true);
      });
      document.getElementById('source-filter-reorder').addEventListener('click', () => apply(true));
      window.axiomSourceFilters = {values, apply};
      apply(true);
    })();
  </script>
  <script id="acquisition-monitor-script">
    (() => {
      const cards = Array.from(document.querySelectorAll('.source-card[data-source-id]'));
      if (!cards.length) return;
      const revision = {{ (catalog|default({})).revision|default(none)|tojson }};
      const labels = {queued: 'Queued', downloading: 'Downloading', verifying: 'Verifying checksum',
        publishing: 'Promoting / verifying final file', completed: 'Acquisition completed',
        retrying: 'Waiting to retry', failed: 'Failed', interrupted: 'Interrupted',
        paused: 'Paused', pausing: 'Pausing', cancelling: 'Cancelling', cancelled: 'Cancelled',
        not_started: 'Not downloaded', unavailable: 'Service not installed', unknown: 'Status unknown'};
      const gib = bytes => (bytes / 1073741824).toFixed(2) + ' GiB';
      function size(bytes) {
        if (!Number.isFinite(bytes) || bytes < 0) return 'Installed';
        const units = ['B', 'KiB', 'MiB', 'GiB', 'TiB'];
        let i = 0;
        while (bytes >= 1024 && i < units.length - 1) { bytes /= 1024; i++; }
        return bytes.toFixed(i ? 1 : 0) + ' ' + units[i];
      }
      function render(card, job, stale, unavailable = false) {
        const field = name => card.querySelector('[data-field="' + name + '"]');
        const put = (name, value) => {
          const node = field(name);
          if (!node) return;
          node.textContent = value;
          node.hidden = !value;
        };
        const verified = !stale && job?.state === 'completed' && job.verified === true && job.active === false;
        const status = unavailable ? 'Status unavailable' : stale ? 'Stale sample — status unknown' :
          !job ? 'Waiting for status' : verified ? size(job.expected_bytes) : (labels[job.state] || 'Status unknown');
        put('status', status);
        field('status').className = 'badge' + (!stale && job?.state === 'completed' && job.verified === true ?
          ' enabled' : !stale && job?.state === 'failed' ? ' disabled' : '');
        const progress = field('transfer');
        const valid = job?.active === true && !stale && Number.isFinite(job?.downloaded_bytes) && job.downloaded_bytes >= 0 &&
          Number.isFinite(job.expected_bytes) && job.expected_bytes > 0 && job.downloaded_bytes <= job.expected_bytes;
        progress.hidden = !valid;
        progress.value = valid ? 100 * job.downloaded_bytes / job.expected_bytes : 0;
        const compact = field('summary-progress');
        compact.hidden = !valid;
        compact.value = progress.value;
        put('metrics', valid ? (stale ? 'Last observed download: ' : 'Download: ') +
          progress.value.toFixed(2) + '% · ' + gib(job.downloaded_bytes) + ' / ' + gib(job.expected_bytes) :
          !stale && job?.active && Number.isFinite(job.downloaded_bytes) ? size(job.downloaded_bytes) + ' downloaded' : '');
        const checking = !stale && (job?.state === 'verifying' || job?.state === 'publishing');
        const verify = field('verification');
        verify.hidden = !checking;
        const measured = checking && job.state === 'verifying' &&
          Number.isFinite(job.checksum_bytes) && job.checksum_bytes >= 0 &&
          Number.isFinite(job.expected_bytes) && job.expected_bytes > 0 &&
          job.checksum_bytes <= job.expected_bytes;
        const pass = measured && Number.isInteger(job.checksum_pass) &&
          Number.isInteger(job.checksum_passes) && job.checksum_pass > 0 &&
          job.checksum_pass <= job.checksum_passes ?
          ' pass ' + job.checksum_pass + ' of ' + job.checksum_passes : '';
        if (measured) {
          verify.max = 100;
          verify.value = 100 * job.checksum_bytes / job.expected_bytes;
        } else {
          verify.removeAttribute('value');
        }
        put('verification-label', checking ? (measured ?
          'Checksum' + pass + ' verification in progress — ' + verify.value.toFixed(1) +
          '% read (estimated; digest not yet confirmed).' :
          'Checksum / publishing in progress — percentage unavailable.') : '');
        const rate = !stale && job?.state === 'downloading' && job.speed_bytes_per_second > 0 ?
          (job.speed_bytes_per_second / 1048576).toFixed(2) + ' MiB/s' +
          (Number.isFinite(job.eta_seconds) ? ' · ' + Math.ceil(job.eta_seconds / 60) + ' min remaining (transfer only)' : '') : '';
        put('rate', rate);
        put('detail', verified ? '' : job?.detail || '');
        put('sample', Number.isFinite(job?.sampled_at) ? new Date(job.sampled_at * 1000).toLocaleString() : '—');
      }
      function controls(card, source) {
        const field = name => card.querySelector('[data-field="' + name + '"]');
        const pub = source?.publication;
        const blocked = source?.mutation_blocked !== false || !!pub?.error;
        card.querySelector('[data-catalog-edit]').disabled = blocked;
        card.querySelector('[data-catalog-remove]').disabled = blocked;
        field('mutation-note').textContent = blocked ? 'Acquisition or publication status unresolved; changes are blocked.' : '';
        if (['pdf','epub'].includes(card.dataset.filterFormat)) {
          card.dataset.acquisitionBlocked = String(blocked || !!pub?.enabled);
          for (const button of card.querySelectorAll('[data-pdf-download], [data-pdf-upload]')) {
            button.hidden = !!pub?.enabled;
            button.disabled = blocked || !!pub?.enabled || card.dataset.acquiring === 'true';
            button.textContent = button.hasAttribute('data-pdf-upload') ?
              (source?.installed_verified ? 'Replace ' : 'Upload ') + card.dataset.filterFormat.toUpperCase() :
              source?.installed_verified ? 'Re-download' : 'Download from URL';
          }
        }
        const updateCheckButton = card.querySelector('[data-zim-update-check]');
        if (updateCheckButton) {
          updateCheckButton.hidden = !source?.installed_verified;
          updateCheckButton.disabled = !source?.installed_verified || card.dataset.zimCheckPosting === 'true';
        }
        const zim = card.querySelector('[data-zim-download]');
        if (zim && card.dataset.filterFormat === 'zim') {
          zim.hidden = !!source?.installed_verified;
          card.dataset.zimBlocked = String(blocked || !!source?.installed_verified || !source?.zim_download);
          if (source?.acquisition && card.dataset.zimAccepted === 'true') {
            delete card.dataset.zimAccepted;
            const localFeedback = card.querySelector('[data-zim-feedback]');
            if (localFeedback) localFeedback.textContent = '';
          }
          const state = source?.acquisition?.state || '';
          const hasPartial = Number(source?.acquisition?.downloaded_bytes || 0) > 0;
          const running = ['queued','downloading','verifying','pausing','cancelling'].includes(state);
          const recoverable = ['paused','interrupted','failed'].includes(state) && hasPartial;
          const expected = Number(source?.acquisition?.expected_bytes);
          const complete = Number.isSafeInteger(expected) && expected >= 96 &&
            Number(source?.acquisition?.downloaded_bytes) === expected;
          const canRevalidate = recoverable && complete && source?.acquisition?.retained === true;
          const canResume = recoverable && !complete;
          const canCancel = running || recoverable;
          const canRestart = ['paused','interrupted','failed','cancelled'].includes(state) && !hasPartial;
          const retries = source?.acquisition?.retry_count ?? (source?.acquisition?.attempt_history || []).filter(a => a.operation === 'retry').length;
          const canRetry = state === 'failed' && retries < 3 &&
            (!hasPartial || !!(source?.acquisition?.etag || source?.acquisition?.last_modified));
          zim.hidden = !!source?.installed_verified || recoverable || running;
          zim.disabled = card.dataset.zimBlocked === 'true' || card.dataset.zimPosting === 'true' || card.dataset.zimAccepted === 'true';
          for (const control of card.querySelectorAll('[data-zim-control]')) {
            const op = control.dataset.zimControl;
            control.hidden = op === 'pause' ? !['queued','downloading','verifying'].includes(state) :
              op === 'resume' ? !canResume :
              op === 'revalidate' ? !canRevalidate :
              op === 'restart' ? !canRestart :
              op === 'retry' ? !canRetry :
              op === 'cancel-keep' ? !canCancel : !canCancel;
            control.disabled = card.dataset.zimPosting === 'true' || card.dataset.zimAccepted === 'true' ||
              (op === 'pause' && !['queued','downloading','verifying'].includes(state));
          }
        }
        const deleteButton = card.querySelector('[data-zim-delete]');
        if (deleteButton) {
          deleteButton.hidden = !source?.installed_verified || !!source?.publication?.enabled || !!source?.replacement;
          deleteButton.disabled = !!source?.mutation_blocked || card.dataset.zimDeletePosting === 'true';
        }
        const replacement = source?.replacement;
        const replacementState = replacement?.state || '';
        const replacementStatus = card.querySelector('[data-zim-replacement-status]');
        if (replacementStatus) {
          const bytes = Number(replacement?.downloaded_bytes);
          const total = Number(replacement?.expected_bytes);
          const percent = Number.isFinite(bytes) && Number.isFinite(total) && total > 0 ?
            ' · ' + (100 * bytes / total).toFixed(1) + '%' : '';
          replacementStatus.textContent = replacementState ?
            'Replacement: ' + replacementState + percent + (replacement.error ? ' · ' + replacement.error : '') : '';
          for (const button of (card.querySelectorAll?.('[data-zim-replacement]') || [])) {
            const op = button.dataset.zimReplacement;
            button.hidden = op === 'prepare' ? !source?.replacement_available || !!replacement :
              op === 'download' ? !['prepared','failed','interrupted','cancelled'].includes(replacementState) :
              op === 'cancel' ? !['downloading','verifying'].includes(replacementState) :
              op === 'activate' ? replacementState !== 'verified' :
              op === 'rollback' ? replacementState !== 'activated' :
              !['prepared','rolled_back','failed','cancelled','interrupted'].includes(replacementState) ||
                (['failed','cancelled','interrupted'].includes(replacementState) && replacement?.can_discard !== true);
            // Replacement controls use their own durable state and backend
            // preconditions. A changed catalog URL makes the old acquisition
            // appear unmatched; it must not disable a safe replacement action.
            button.disabled = card.dataset.zimReplacementPosting === 'true' ||
              (op === 'prepare' && !source?.replacement_available) ||
              (op === 'download' && !['prepared','failed','interrupted','cancelled'].includes(replacementState));
          }
        }
        const toggle = field('publication-toggle');
        if (!toggle || toggle.dataset.posting === 'true') return;
        toggle.dataset.enabled = String(!!pub?.enabled);
        toggle.textContent = pub?.enabled ? 'Unpublish' : 'Publish';
        toggle.dataset.acknowledgeRights = String(!!pub?.requires_rights_acknowledgement);
        toggle.disabled = !pub?.enabled && (blocked || !(pub?.serving || pub?.requires_rights_acknowledgement || pub?.ready_for_publication));
        field('publication-browse').hidden = !pub?.published;
        field('publication-summary').textContent = !pub || pub.error ? 'Publication status unavailable' : pub.published ? 'Published' : pub.enabled ? (pub.ready_for_publication ? 'Kiwix starting' : 'Reader unavailable') : '';
        field('publication-status').hidden = !!pub?.published;
        field('publication-status').textContent =
          !pub || pub.error ? 'Publication status unavailable' : pub.published ? 'Published · available in library' :
          pub.enabled ? (pub.ready_for_publication ? 'Verified · awaiting Kiwix reader activation' : 'Enabled · reader unavailable') : pub.serving ? 'Unpublished · ready to publish' : pub.ready_for_publication ? 'Verified · ready to publish' : pub.publication_reason ? 'Unpublished · ' + pub.publication_reason : 'Unpublished · reader not ready';
      }
      let sessionExpired = false;
      function redirectExpiredSession() {
        if (sessionExpired) return;
        sessionExpired = true;
        const feedback = document.getElementById('catalog-feedback');
        if (feedback) feedback.textContent = 'Your administrator session expired. Sign in again.';
        // Preserve only a same-origin return path; login itself remains the
        // sole place where credentials are collected.
        window.location.assign('/admin/login');
      }
      async function refresh() {
        if (sessionExpired) return;
        const controller = new AbortController();
        const timer = window.setTimeout(() => controller.abort(), 5000);
        try {
          const response = await fetch('/api/sources', {cache: 'no-store', signal: controller.signal});
          if (response.status === 401) {
            redirectExpiredSession();
            return;
          }
          if (!response.ok) throw new Error('Status unavailable');
          const data = await response.json();
          if (data.revision !== revision) {
            document.getElementById('catalog-feedback').textContent = 'Source profiles changed. Reload to see the latest catalog.';
            throw new Error('Catalog revision changed');
          }
          const sources = new Map(data.sources.map(source => [source.source_id, source]));
          cards.forEach(card => {
            const source = sources.get(card.dataset.sourceId);
            if (source && !source.adapter) {
              card.querySelector('[data-field="status"]').textContent = 'Not yet supported';
            } else if (['pdf','epub'].includes(source?.adapter)) {
              card.querySelector('[data-field="status"]').textContent = source.installed_verified ? size(source.artifact?.bytes) : (source.artifact ? 'Not installed or invalid' : 'Not downloaded');
              card.querySelector('[data-field="status"]').className = 'badge' + (source.installed_verified ? ' enabled' : '');
            } else if (source?.zim_download) {
              if (source.acquisition) render(card, source.acquisition, false);
              else card.querySelector('[data-field="status"]').textContent = 'Not downloaded';
            } else if (source?.artifact) render(card, source.acquisition, data.acquisition_stale !== false);
            else card.querySelector('[data-field="status"]').textContent = data.acquisition_stale ? 'Status unavailable' :
              source?.mutation_blocked !== false ? 'Acquisition unresolved' : 'Not downloaded';
            const documentStatus = card.querySelector('[data-field="document-origin-status"]');
            if (documentStatus) documentStatus.textContent =
              source?.update_check?.state === 'representation_changed'
                ? 'Publisher representation changed; a newer verified edition is not established.' : '';
            const updateBadge = card.querySelector('[data-field="update-status"]');
            const updateDetails = card.querySelector('[data-field="update-details"]');
            const update = source?.update_check;
            const hasUpdate = update?.state === "update_available";
            if (updateBadge) updateBadge.hidden = !hasUpdate;
            if (updateDetails) {
              updateDetails.hidden = !hasUpdate;
              updateDetails.textContent = hasUpdate
                ? 'Installed edition: ' + (update.installed_edition || 'unknown') +
                  ' · Publisher edition: ' + (update.candidate_edition || 'unknown') +
                  ' · Candidate: ' + (update.candidate_url || 'unavailable') +
                  ' · No download started; replacement requires separate explicit review.'
                : '';
            }
            const review = card.querySelector('[data-review-zim-update]');
            if (review) {
              review.hidden = !hasUpdate || !Number.isSafeInteger(update?.candidate_bytes);
              if (!review.hidden) {
                review.dataset.updateUrl = update.candidate_url || '';
                review.dataset.updateSha256 = update.candidate_sha256 || '';
                review.dataset.updateBytes = String(update.candidate_bytes);
                review.dataset.updateEdition = update.candidate_edition || '';
              }
            }
            controls(card, source);
            card.dataset.filterPublication = source?.publication_filter || "unknown";
            card.dataset.filterDownload = source?.download_filter || "unknown";
          });
          window.axiomSourceFilters?.apply(false);
        } catch (_) {
          cards.forEach(card => {
            if (card.querySelector('[data-action="download"]') || card.querySelector('[data-zim-download]')) render(card, null, true, true);
            else card.querySelector('[data-field="status"]').textContent = 'Status unavailable';
            card.querySelector('[data-field="summary-progress"]').hidden = true;
            controls(card, null);
            card.dataset.filterPublication = "unknown";
            card.dataset.filterDownload = "unknown";
          });
          window.axiomSourceFilters?.apply(false);
        } finally {
          window.clearTimeout(timer);
          if (!sessionExpired) window.setTimeout(refresh, 2000);
        }
      }
      refresh();
    })();
  </script>

  {% elif page == "settings" %}
  <script id="storage-settings-script">
    (() => {
      const byId = (id) => document.getElementById(id);
      const form = byId('storage-form');
      const fields = byId('storage-fields');
      const feedback = byId('storage-feedback');
      const root = byId('storage-root');
      const mode = byId('storage-mode');
      const mount = byId('storage-mount');
      const source = byId('storage-source');
      const minimum = byId('minimum-free');
      const errors = {
        storage_not_configured: 'Choose and save a storage root first.',
        required_mount_missing_or_replaced: 'The expected filesystem is missing or has been replaced.',
        read_only_filesystem: 'The filesystem is read-only.',
        nested_or_replaced_mount: 'A managed directory is on an unexpected mount.',
        storage_root_missing: 'The storage root does not exist.',
        symlink_not_allowed: 'Symbolic links are not allowed in managed paths.',
        storage_path_not_directory: 'A storage path is not a directory.',
        storage_not_writable: 'The application cannot write to the selected directory.',
        insufficient_capacity: 'Not enough free space for the configured minimum or selected content.',
        mount_changed_during_inspection: 'The mount changed during validation. Check again.',
        storage_io_error: 'Storage is unavailable or could not be inspected.'
      };
      function syncMode() {
        const required = mode.value === 'mounted';
        byId('mount-fields').hidden = !required;
        mount.disabled = source.disabled = !required;
        mount.required = source.required = required;
      }
      function size(bytes) {
        if (typeof bytes !== 'number' || !Number.isFinite(bytes)) return '—';
        const units = ['B', 'KiB', 'MiB', 'GiB', 'TiB', 'PiB', 'EiB'];
        let value = bytes, unit = 0;
        while (value >= 1024 && unit < units.length - 1) { value /= 1024; unit++; }
        return value.toFixed(unit ? 2 : 0) + ' ' + units[unit];
      }
      function renderStatus(status) {
        const put = (id, value) => { byId(id).textContent = value || '—'; };
        put('status-ready', status.ready === true ? 'Ready (advisory)' :
          (status.error ? 'Not ready: ' + (errors[status.error] || status.error) : 'Not checked'));
        put('status-root', status.root);
        put('status-mount', status.mount?.target);
        put('status-source', status.mount ? status.mount.type + ' · ' + status.mount.source : '');
        put('status-total', size(status.total_bytes));
        put('status-free', size(status.free_bytes));
        put('status-write', status.ready === true && status.write_ready === true ? 'Writable (advisory)' : 'Not verified');
        put('status-staging', status.paths?.staging);
        put('status-library', status.paths?.library);
      }
      async function json(url, options) {
        const response = await fetch(url, {...options, cache: 'no-store'});
        if (response.status === 401) {
          window.location.assign('/admin/login');
          throw new Error('Administrator session expired. Sign in again.');
        }
        const body = await response.json();
        if (!response.ok) throw new Error(body.error || 'Request failed (' + response.status + ')');
        return body;
      }
      async function statusCheck() {
        renderStatus({});
        try {
          const status = await json('/api/storage-status');
          renderStatus(status);
          return status.ready === true;
        } catch (error) {
          renderStatus({error: error.message});
          return false;
        }
      }
      function populate(settings) {
        root.value = settings.storage_root;
        mode.value = settings.storage_mount ? 'mounted' : 'local';
        mount.value = settings.storage_mount;
        source.value = settings.storage_source;
        minimum.value = String(settings.minimum_free_bytes);
        syncMode();
      }
      async function load() {
        fields.disabled = true;
        feedback.textContent = 'Loading saved preferences…';
        try {
          populate(await json('/api/storage-settings'));
          const ready = await statusCheck();
          feedback.textContent = ready ? 'Saved preferences loaded.' : 'Saved preferences loaded; storage is not ready.';
        } catch (error) {
          renderStatus({error: error.message});
          feedback.textContent = 'Could not load saved preferences: ' + error.message + '. Enter a new configuration and save explicitly to replace it.';
        } finally {
          fields.disabled = false;
        }
      }
      mode.addEventListener('change', syncMode);
      byId('storage-refresh').addEventListener('click', load);
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const bytes = Number(minimum.value || '0');
        if (!Number.isSafeInteger(bytes) || bytes < 0) {
          feedback.textContent = 'Minimum available bytes must be a non-negative whole number within the supported range.';
          return;
        }
        const settings = {storage_root: root.value.trim(),
          storage_mount: mode.value === 'mounted' ? mount.value.trim() : '',
          storage_source: mode.value === 'mounted' ? source.value.trim() : '',
          minimum_free_bytes: bytes, directories: ['staging', 'library']};
        fields.disabled = true;
        feedback.textContent = 'Saving preferences…';
        try {
          populate(await json('/api/storage-settings', {method: 'POST',
            headers: {...((typeof window !== 'undefined' && window.axiomCsrfHeaders?.()) || {}),'Content-Type': 'application/json'}, body: JSON.stringify(settings)}));
          const ready = await statusCheck();
          feedback.textContent = ready ? 'Preferences saved. Storage is ready (advisory).' :
            'Preferences saved, but storage is not ready. See the status below.';
        } catch (error) {
          feedback.textContent = 'Save failed: ' + error.message + '. Previously saved preferences were not confirmed changed.';
        } finally {
          fields.disabled = false;
        }
      });
      load();
    })();
  </script>
  {% if password_change_enabled %}
  <script id="admin-password-script">
    (() => {
      const byId = id => document.getElementById(id);
      const form = byId('password-form');
      const feedback = byId('password-feedback');
      const fields = byId('password-fields');
      form.addEventListener('submit', async event => {
        event.preventDefault();
        const current = byId('current-password'), next = byId('new-password'), confirm = byId('confirm-password');
        if (next.value !== confirm.value) {
          feedback.textContent = 'New passwords do not match.';
          return;
        }
        fields.disabled = true;
        feedback.textContent = 'Changing password…';
        try {
          const response = await fetch('/api/admin/password', {
            method: 'POST', headers: {...((typeof window !== 'undefined' && window.axiomCsrfHeaders?.()) || {}),'Content-Type': 'application/json'},
            cache: 'no-store', body: JSON.stringify({current_password: current.value,
              new_password: next.value, confirm_password: confirm.value})
          });
          const result = await response.json();
          if (!response.ok || result.changed !== true) throw new Error(result.error || 'Password change failed');
          feedback.textContent = 'Password changed. Reload the admin page and sign in with the new password. If your browser keeps the old credentials, close its session or use a private window.';
        } catch (error) {
          feedback.textContent = 'Could not confirm password change: ' + error.message;
        } finally {
          current.value = next.value = confirm.value = '';
          fields.disabled = false;
        }
      });
    })();
  </script>
  {% endif %}
  {% endif %}
</body>
</html>