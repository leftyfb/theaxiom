        drag?.target?.classList.remove('order-drop-target');
        drag = null;
      }
      root.addEventListener('pointermove', event => {
        if (drag?.id !== event.pointerId) return;
        drag.target?.classList.remove('order-drop-target');
        drag.target = dropRow(event);
        if (drag.target !== drag.row) drag.target?.classList.add('order-drop-target');
      });
      root.addEventListener('pointerup', event => {
        if (drag?.id !== event.pointerId) return;
        const card = drag.row.querySelector('.source-card');
        const target = dropRow(event)?.querySelector('.source-card');
