      const artifactLabels = {filename: 'Artifact filename', bytes: 'Artifact size (bytes)', sha256: 'Artifact SHA-256'};
      const refreshFeedback = document.getElementById('source-refresh-feedback');
      const updateSummary = document.getElementById('source-update-summary');
      const showUpdateSummary = text => {
        if (!updateSummary) return;
        if (updateSummary.textContent !== text) updateSummary.textContent = text;
        updateSummary.hidden = !text;
