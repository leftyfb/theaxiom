{
  "documents": [
{% for document in offline_library_catalog_resources | default(offline_library_poc_catalog_documents) %}
    {
      "title": {{ document.title | tojson }},
      "category": {{ document.category | tojson }},
      "description": {{ document.description | tojson }},
      "route": {{ document.route | tojson }},
      "asset_route": {{ document.asset_route | tojson }},
      "download_route": {{ document.download_route | tojson }},
      "bytes": {{ document.bytes | int }},
      "sha256": {{ document.sha256 | tojson }},
      "publisher": {{ document.publisher | tojson }},
      "source_url": {{ document.source_url | tojson }},
      "retrieved": {{ document.retrieved | tojson }},
      "original_filename": {{ document.original_filename | tojson }},
      "format": {{ document.format | tojson }},
      "redistribution_status": {{ document.redistribution_status | tojson }}
    }{{ ',' if not loop.last else '' }}
{% endfor %}
  ]
}
