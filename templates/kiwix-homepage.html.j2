<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#123c32">
  <title>Offline Emergency Library</title>
  <style>
    :root { color-scheme: light; font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: #17332b; background: #eef4f0; --green:#176b4d; --dark:#123c32; --line:#d4e4db; --muted:#587067; --paper:#fff; --accent:#e2f2e9; }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body { margin: 0; min-width: 280px; }
    a { color: var(--green); }
    a:focus-visible, button:focus-visible, input:focus-visible { outline: 3px solid #f1b84b; outline-offset: 3px; }
    .skip { position: fixed; left: 1rem; top: -5rem; z-index: 20; padding: .75rem 1rem; color: #fff; background: var(--dark); border-radius: .45rem; }
    .skip:focus { top: 1rem; }
    .site-header { position: sticky; top: 0; z-index: 10; display: flex; align-items: center; gap: .75rem; padding: .75rem 1rem; background: rgba(255,255,255,.97); border-bottom: 1px solid var(--line); box-shadow: 0 2px 12px #143c3220; }
    .brand { margin-right: auto; color: var(--dark); font-size: 1.05rem; font-weight: 800; line-height: 1.1; text-decoration: none; }
    .search { min-height: 44px; min-width: 0; width: min(17rem, 34vw); padding: .65rem .8rem; border: 1px solid #aac5b7; border-radius: .6rem; background: #fff; font: inherit; }
    .button { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: .6rem .85rem; border: 1px solid #aac5b7; border-radius: .6rem; background: #fff; color: var(--green); font: inherit; font-weight: 700; text-decoration: none; cursor: pointer; }
    .button.primary { border-color: var(--green); color: #fff; background: var(--green); }
    .hero { color: #fff; background: linear-gradient(135deg, #123c32, #176b4d); }
    .hero-inner, main { width: min(100% - 2rem, 70rem); margin: 0 auto; }
    .hero-inner { padding: 2.7rem 0 2.3rem; }
    .eyebrow { margin: 0 0 .45rem; color: #c7ead7; font-size: .78rem; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; }
    h1 { margin: 0; max-width: 13ch; font-size: clamp(2rem, 7vw, 3.6rem); line-height: 1.03; }
    .intro { max-width: 43rem; margin: .85rem 0 0; color: #e1eee8; font-size: 1.05rem; }
    main { padding: 1.4rem 0 3rem; }
    .offline-notice { display: flex; gap: .75rem; align-items: flex-start; margin: 0 0 1rem; padding: .9rem 1rem; border: 1px solid #abd0bd; border-radius: .7rem; background: #e5f5ec; }
    .offline-notice strong { display: block; }
    .offline-notice p { margin: .15rem 0 0; color: #3f5e52; }
    .categories { display: flex; gap: .5rem; overflow-x: auto; padding: .35rem 0 .8rem; scrollbar-width: thin; }
    .category-link { flex: 0 0 auto; display: inline-flex; align-items: center; min-height: 44px; padding: .55rem .8rem; border: 1px solid var(--line); border-radius: 999px; background: var(--paper); color: var(--green); font: inherit; font-weight: 700; cursor: pointer; }
    .category-link[aria-pressed="true"] { border-color: var(--green); color: #fff; background: var(--green); }
    .category-link span { margin-left: .45rem; padding: .1rem .45rem; border-radius: 999px; color: #fff; background: var(--green); font-size: .75rem; }
    .toolbar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin: .75rem 0; }
    .toolbar h2 { margin: 0; font-size: 1.25rem; }
    .filters { display: flex; flex-wrap: wrap; gap: .5rem; margin: .5rem 0 1rem; }
    .saved-toggle { margin-left: auto; }
    .filter { min-height: 44px; padding: .55rem .7rem; border: 1px solid #aac5b7; border-radius: .6rem; background: #fff; color: var(--green); font: inherit; }
    .results { color: var(--muted); font-size: .9rem; }
    .library-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
    .document { display: flex; flex-direction: column; min-width: 0; padding: 1.15rem; border: 1px solid var(--line); border-top: .32rem solid #4aab7e; border-radius: .8rem; background: var(--paper); box-shadow: 0 5px 18px #17332b0d; }
    .card-head { display: grid; grid-template-columns: 3rem minmax(0,1fr); gap: .8rem; align-items: start; }
    .icon { display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: .65rem; color: var(--green); background: var(--accent); font-weight: 900; }
    .document h3 { margin: .05rem 0 .35rem; font-size: 1.12rem; line-height: 1.25; }
    .document h3 a { text-decoration: none; }
    .description { margin: 0; color: var(--muted); line-height: 1.45; }
    .badges { display: flex; flex-wrap: wrap; gap: .35rem; margin: .9rem 0; }
    .badge { padding: .25rem .5rem; border-radius: .35rem; color: #37544a; background: #edf3f0; font-size: .72rem; font-weight: 750; }
    .actions { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: auto; padding-top: .2rem; }
    .empty { grid-column: 1/-1; padding: 1.5rem; border: 1px dashed #aac5b7; border-radius: .7rem; text-align: center; color: var(--muted); background: #fff; }
    .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
    .provenance { margin: .5rem 0; border: 1px solid var(--line); border-radius: .6rem; background: var(--paper); }
    .provenance summary { padding: .55rem .8rem; cursor: pointer; font-weight: 700; color: var(--green); }
    .provenance-grid { display: grid; grid-template-columns: auto 1fr; gap: .25rem .5rem; padding: .5rem .8rem .8rem; font-size: .85rem; }
    .provenance-label { color: var(--muted); }
    .provenance-value { word-break: break-word; }
    @media (max-width: 700px) { .library-list { grid-template-columns: 1fr; } .hero-inner { padding: 2rem 0 1.8rem; } }
    @media (max-width: 480px) { .site-header { flex-wrap: wrap; } .brand { width: calc(100% - 5rem); } .search { order: 3; width: 100%; } .hero-inner, main { width: min(100% - 1.25rem, 70rem); } .document { padding: 1rem; } }
    .active-criteria { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem; margin: .5rem 0 1rem; }
    .active-criterion { display: inline-flex; align-items: center; gap: .3rem; padding: .25rem .55rem; border: 1px solid var(--green); border-radius: 999px; color: var(--green); background: var(--accent); font-size: .8rem; font-weight: 700; }
    .active-criterion button { border: none; background: transparent; color: var(--green); cursor: pointer; font-size: .8rem; line-height: 1; padding: 0 .25rem; }
    .print-route { display: none; }
    .recent { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; margin: 0 0 1rem; padding: .8rem 1rem; border: 1px solid var(--line); border-radius: .7rem; background: var(--paper); }
    .recent-head { display: flex; align-items: center; gap: .5rem; margin-left: auto; }
    .recent-title { font-weight: 700; color: var(--green); }
    .recent-route { color: var(--muted); font-size: .85rem; }
    @media print { .site-header, .categories, .offline-notice, .recent, .actions, #reset-search, #print-collection, .filters, #clear-recent { display: none !important; } body { background: #fff; } .hero { color: #000; background: #fff; } .intro, .eyebrow { color: #333; } .library-list { display: block; } .document { break-inside: avoid; box-shadow: none; margin-bottom: 1rem; } .print-route { display: block; color: #333; font-size: .85rem; overflow-wrap: anywhere; } }
  </style>
</head>
<body>
  <a class="skip" href="#main-content">Skip to collection</a>
  <header class="site-header">
    <a class="brand" href="/" aria-label="Offline Emergency Library home">Offline Emergency Library</a>
    <label class="sr-only" for="library-search">Search documents by title or category</label>
    <input class="search" id="library-search" type="search" placeholder="Search title or category" autocomplete="off">
    <button class="button" id="reset-search" type="button">Reset</button>
  </header>
  <section class="hero" aria-labelledby="page-title"><div class="hero-inner">
    <p class="eyebrow">Locally stored · Official sources</p>
    <h1 id="page-title">Emergency reference library</h1>
    <p class="intro">Essential public guidance preserved on this local server for use when internet or DNS service is unavailable.</p>
  </div></section>
  <main id="main-content">
    <aside class="offline-notice" aria-label="Offline availability"><span aria-hidden="true">●</span><div><strong>Available without internet access</strong><p>Every listed document is stored locally. Original publisher files remain unchanged.</p></div></aside>
{% if offline_library_kiwix_server_enabled and offline_library_kiwix_zim_enabled %}
    <aside class="offline-notice" aria-label="Offline encyclopedia"><span aria-hidden="true">W</span><div><strong>Climate change by Wikipedia</strong><p>20,144 English Wikipedia articles in a locally served Kiwix collection. <a href="/kiwix/">Open the offline encyclopedia</a>.</p></div></aside>
{% endif %}
{% set resources = offline_library_catalog_resources | default(offline_library_poc_catalog_documents) %}
    <nav class="categories" aria-label="Document categories">
      <button class="category-link" type="button" data-category="" aria-pressed="true">All <span>{{ resources | length }}</span></button>
{% for category in resources | map(attribute='category') | unique %}
      <button class="category-link" type="button" data-category="{{ category | lower }}" aria-pressed="false">{{ category }} <span>{{ resources | selectattr('category', 'equalto', category) | list | length }}</span></button>
{% endfor %}
    </nav>
    <div class="filters" aria-label="Additional catalog filters">
      <label>Publisher <select class="filter" id="publisher-filter"><option value="">All publishers</option>{% for publisher in resources | map(attribute='publisher') | unique %}<option value="{{ publisher | lower }}">{{ publisher }}</option>{% endfor %}</select></label>
      <label>Format <select class="filter" id="format-filter"><option value="">All formats</option>{% for format in resources | map(attribute='format') | unique %}<option value="{{ format | lower }}">{{ format }}</option>{% endfor %}</select></label>
      <button class="button saved-toggle" id="saved-toggle" type="button" aria-pressed="false">Saved <span id="saved-count">0</span></button>
    </div>
    <div class="toolbar"><h2>Offline collection</h2><span class="results" id="result-count">{{ resources | length }} resources</span><label class="sr-only" for="catalog-sort">Sort by</label><select class="filter" id="catalog-sort"><option value="">Sort by</option><option value="title">Title</option><option value="category">Category</option><option value="publisher">Publisher</option></select><button class="button" id="print-collection" type="button">Print index</button><button class="button" id="clear-recent" type="button" hidden>Clear recent</button></div>
    <div class="active-criteria" id="active-criteria" hidden></div>
    <div class="recent" id="recent-bar" hidden><span class="recent-title">Recent</span><span class="recent-route" id="recent-route"></span><span class="recent-head"><button class="button" id="open-recent" type="button">Open</button><button class="button" id="clear-recent-bar" type="button">Clear</button></span></div>
    <section class="library-list" aria-label="Library documents">
{% for document in resources %}
      <article class="document" data-title="{{ document.title | lower }}" data-category="{{ document.category | lower }}" data-publisher="{{ document.publisher | lower }}" data-format="{{ document.format | lower }}" data-document="{{ document.title | lower }} {{ document.category | lower }} {{ document.description | lower }} {{ document.publisher | lower }} {{ document.format | lower }}">
        <div class="card-head"><div class="icon" aria-hidden="true">{{ 'W' if document.resource_type | default('document') == 'encyclopedia' else 'PDF' }}</div><div><h3><a href="{{ document.route }}">{{ document.title }}</a></h3><p class="description">{{ document.description }}</p><span class="print-route">Local route: {{ document.route }}</span></div></div>
        <div class="badges"><span class="badge">{{ document.format }}</span><span class="badge">{{ document.publisher }}</span><span class="badge">Source preserved</span><span class="badge">{{ document.category }}</span></div>
        <details class="provenance"><summary>Source provenance</summary><div class="provenance-grid"><span class="provenance-label">Publisher</span><span class="provenance-value">{{ document.publisher }}</span><span class="provenance-label">Original URL</span><span class="provenance-value"><a href="{{ document.source_url }}" target="_blank" rel="noopener">{{ document.source_url }}</a></span><span class="provenance-label">Retrieved</span><span class="provenance-value">{{ document.retrieved }}</span><span class="provenance-label">Original filename</span><span class="provenance-value">{{ document.original_filename }}</span><span class="provenance-label">File size</span><span class="provenance-value">{{ document.bytes }} bytes</span><span class="provenance-label">SHA-256</span><span class="provenance-value">{{ document.sha256 }}</span><span class="provenance-label">Redistribution</span><span class="provenance-value">{{ document.redistribution_status }}</span></div></details>
        <div class="actions"><button class="button save-resource" type="button" data-resource-id="{{ document.route }}" aria-pressed="false">Save</button><button class="button copy-link" type="button" data-local-url="{{ document.route }}" aria-label="Copy local address for {{ document.title }}">Copy link</button><a class="button primary" href="{{ document.route }}">Open resource</a>{% if document.resource_type | default('document') == 'encyclopedia' %}<a class="button" href="{{ document.route }}">Open Wikipedia</a>{% else %}<a class="button" href="{{ document.route }}">Details</a><a class="button" href="{{ document.asset_route }}">View PDF</a><a class="button" href="{{ document.download_route }}" download>Download</a>{% endif %}<span class="copy-fallback" data-local-url="{{ document.route }}" hidden></span></div>
      </article>
{% endfor %}
      <p class="empty" id="no-results" hidden><strong>No documents found.</strong><br>Try another title, publisher, or category.</p>
    </section>
    <footer style="margin-top:1.5rem;color:var(--muted);font-size:.9rem"><a href="/catalog.json">Machine-readable catalog</a> · Local collection metadata and checksums</footer>
  </main>
  <script>(() => { const input=document.querySelector('#library-search'); const reset=document.querySelector('#reset-search'); const publisher=document.querySelector('#publisher-filter'); const format=document.querySelector('#format-filter'); const savedToggle=document.querySelector('#saved-toggle'); const savedCount=document.querySelector('#saved-count'); const chips=[...document.querySelectorAll('.category-link')]; const cards=[...document.querySelectorAll('.document')]; const saves=[...document.querySelectorAll('.save-resource')]; const empty=document.querySelector('#no-results'); const count=document.querySelector('#result-count'); const sortSelect=document.querySelector('#catalog-sort'); const libraryList=document.querySelector('.library-list'); let category=''; let savedOnly=false; const activeCriteria=document.querySelector('#active-criteria'); function renderActiveCriteria(){ const items=[]; if(category){items.push({label:'Category: '+category,kind:'category'});} if(publisher.value){items.push({label:'Publisher: '+publisher.options[publisher.selectedIndex].text,kind:'publisher'});} if(format.value){items.push({label:'Format: '+format.options[format.selectedIndex].text,kind:'format'});} if(savedOnly){items.push({label:'Saved only',kind:'saved'});} if(input.value.trim()){items.push({label:'Search: '+input.value.trim(),kind:'search'});} if(items.length){activeCriteria.hidden=false;activeCriteria.innerHTML='';items.forEach(item=>{const chip=document.createElement('span');chip.className='active-criterion';chip.textContent=item.label;const x=document.createElement('button');x.type='button';x.textContent='×';x.setAttribute('aria-label','Remove '+item.kind+' filter');x.addEventListener('click',()=>{if(item.kind==='category'){category='';chips.forEach(c=>c.setAttribute('aria-pressed',String(c===chips[0])));}else if(item.kind==='publisher'){publisher.value='';}else if(item.kind==='format'){format.value='';}else if(item.kind==='saved'){savedOnly=false;savedToggle.setAttribute('aria-pressed','false');}else if(item.kind==='search'){input.value='';}filter();});chip.appendChild(x);activeCriteria.appendChild(chip);});}else{activeCriteria.hidden=true;activeCriteria.innerHTML='';} } function sortCards(){ const v=sortSelect.value; if(!v) return; const cs=[...libraryList.children]; const vis=cs.filter(c=>!c.hidden); vis.sort((a,b)=>((a.dataset[v]||'').localeCompare((b.dataset[v]||'')))); vis.forEach(c=>libraryList.appendChild(c)); } let saved=new Set(JSON.parse(localStorage.getItem('offline-library-saved')||'[]')); function syncSaved(){saves.forEach(button=>{const on=saved.has(button.dataset.resourceId);button.textContent=on?'Remove':'Save';button.setAttribute('aria-pressed',String(on));});savedCount.textContent=saved.size;} function filter(){ const q=input.value.trim().toLowerCase(); let shown=0; cards.forEach(card=>{const match=(!q||card.dataset.document.includes(q))&&(!category||card.dataset.category===category)&&(!publisher.value||card.dataset.publisher===publisher.value)&&(!format.value||card.dataset.format===format.value)&&(!savedOnly||saved.has(card.querySelector('.save-resource').dataset.resourceId)); card.hidden=!match; if(match)shown++;}); empty.hidden=shown!==0; count.textContent=shown+' resource'+(shown===1?'':'s'); sortCards(); renderActiveCriteria(); } sortSelect.addEventListener('change',sortCards); saves.forEach(button=>button.addEventListener('click',()=>{const id=button.dataset.resourceId;saved.has(id)?saved.delete(id):saved.add(id);localStorage.setItem('offline-library-saved',JSON.stringify([...saved]));syncSaved();filter();})); savedToggle.addEventListener('click',()=>{savedOnly=!savedOnly;savedToggle.setAttribute('aria-pressed',String(savedOnly));filter();}); chips.forEach(chip=>chip.addEventListener('click',()=>{category=chip.dataset.category;chips.forEach(item=>item.setAttribute('aria-pressed',String(item===chip)));filter();})); input.addEventListener('input',filter); publisher.addEventListener('change',filter); format.addEventListener('change',filter); reset.addEventListener('click',()=>{input.value='';publisher.value='';format.value='';category='';savedOnly=false;savedToggle.setAttribute('aria-pressed','false');chips.forEach((item,index)=>item.setAttribute('aria-pressed',String(index===0)));filter();input.focus();}); syncSaved();filter(); const recentBar=document.querySelector('#recent-bar'); const recentRoute=document.querySelector('#recent-route'); const openRecent=document.querySelector('#open-recent'); const clearRecentBar=document.querySelector('#clear-recent-bar'); const clearRecentToolbar=document.querySelector('#clear-recent'); let recent=JSON.parse(localStorage.getItem('offline-library-recent')||'[]'); function renderRecent(){ if(recent.length){recentBar.hidden=false;recentRoute.textContent=recent[recent.length-1];clearRecentToolbar.hidden=false;}else{recentBar.hidden=true;clearRecentToolbar.hidden=true;} } function trackRecent(route){ recent=[route,...recent.filter(r=>r!==route)].slice(0,5); localStorage.setItem('offline-library-recent',JSON.stringify(recent)); renderRecent(); } libraryList.addEventListener('click',e=>{const a=e.target.closest('a'); if(a&&a.href&&a.href.indexOf('/documents/')!==-1)trackRecent(a.href); }); openRecent.addEventListener('click',()=>{if(recent.length)window.location.href=recent[recent.length-1];}); clearRecentBar.addEventListener('click',()=>{recent=[];localStorage.removeItem('offline-library-recent');renderRecent();}); clearRecentToolbar.addEventListener('click',()=>{recent=[];localStorage.removeItem('offline-library-recent');renderRecent();}); renderRecent(); })();</script>
  <script>document.querySelector('#print-collection').addEventListener('click', () => window.print());</script>
  <script>function copyLink(button){const url=new URL(button.dataset.localUrl,location.origin).href;const fallback=button.parentElement.querySelector('.copy-fallback');function show(text){if(fallback){fallback.textContent=text;fallback.hidden=false;setTimeout(()=>{fallback.hidden=true;},1500);}else{navigator.clipboard.writeText(url).catch(()=>{});}}if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(url).then(()=>show('Copied: '+url),()=>show(url));}else{show(url);}}document.querySelectorAll('.copy-link').forEach(b=>b.addEventListener('click',()=>copyLink(b)));</script>
</body>
</html>
