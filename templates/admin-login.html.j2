<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="application-name" content="The Axiom"><meta name="robots" content="noindex,nofollow">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png">
<link rel="shortcut icon" href="/favicon.ico" sizes="any">
<title>Administrator sign in · The Axiom</title>
<style>
:root{font-family:system-ui,sans-serif;color:#18362d;background:#eef4f0}*{box-sizing:border-box}
body{margin:0;padding:1.25rem}main{max-width:27rem;margin:clamp(2rem,10vh,6rem) auto;background:white;padding:clamp(1.5rem,4vw,2.3rem);border:1px solid #cddfd4;border-radius:1rem;box-shadow:0 8px 24px #18362d0c}
h1{font-size:1.8rem;margin:.3rem 0 .4rem}p{line-height:1.5;color:#587067}label{display:block;font-weight:650;margin:1rem 0 .4rem}input{width:100%;font:inherit;padding:.75rem;border:1px solid #9fb9ac;border-radius:.5rem;min-height:44px}input:focus-visible,button:focus-visible,a:focus-visible{outline:3px solid #c28b1a;outline-offset:3px}button{width:100%;min-height:44px;margin-top:1.5rem;background:#176b4d;color:white;border:0;border-radius:.5rem;font:700 1rem system-ui;cursor:pointer}button:disabled{opacity:.6;cursor:wait}#feedback{min-height:1.5rem;color:#9d2929}a{color:#176b4d}.brand{font-weight:800;color:#18362d}
</style>
</head>
<body>
<main>
<div class="brand">The Axiom</div>
<h1>Administrator sign in</h1>
<p>Sign in to manage your offline library.</p>
<form id="login-form" autocomplete="on">
<label for="username">Username</label>
<input id="username" name="username" type="text" autocomplete="username" required maxlength="64" autofocus>
<label for="password">Password</label>
<input id="password" name="password" type="password" autocomplete="current-password" required maxlength="256">
<button id="submit" type="submit">Sign in</button>
<p id="feedback" role="status" aria-live="polite"></p>
</form>
<p><a href="/">Back to library</a></p>
<p>HTTP does not encrypt passwords. Use HTTPS outside a trusted LAN.</p>
</main>
<script>
(() => {
 const form = document.getElementById('login-form');
 const button = document.getElementById('submit');
 const feedback = document.getElementById('feedback');
 form.addEventListener('submit', async event => {
  event.preventDefault();
  button.disabled = true;
  feedback.textContent = '';
  try {
   const response = await fetch('/api/admin/login', {
    method: 'POST', headers: {'Content-Type': 'application/json'},
    credentials: 'same-origin', cache: 'no-store',
    body: JSON.stringify({username: form.elements.username.value, password: form.elements.password.value})
   });
   if (!response.ok) {
    feedback.textContent = response.status === 429 ? 'Too many attempts. Try again later.' : 'Invalid username or password.';
    return;
   }
   window.location.assign('/admin');
  } catch (_) {
   feedback.textContent = 'Could not connect to the library. Try again.';
  } finally {
   button.disabled = false;
  }
 });
})();
</script>
</body></html>
