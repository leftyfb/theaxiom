<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Search · The Axiom</title><style>
*{box-sizing:border-box}body{margin:0;background:#edf3ef;color:#18362d;font:16px/1.55 system-ui,sans-serif}main{max-width:900px;margin:auto;padding:24px 16px}a{color:#176b4d}a:focus-visible,input:focus-visible,button:focus-visible{outline:3px solid #c38d32;outline-offset:3px}form{display:flex;flex-wrap:wrap;gap:8px}label{width:100%;font-weight:650}input{flex:1;min-width:0;padding:12px;font:inherit;border:1px solid #aac5b7;border-radius:8px}button{font:inherit;background:#176b4d;color:white;border:0;border-radius:8px;padding:10px 16px;min-height:44px}section{background:white;border:1px solid #cfdfd6;border-radius:12px;margin:16px 0;padding:16px;overflow-wrap:anywhere}h2{margin-top:0}li{margin:14px 0}p{margin:6px 0}.muted{color:#536e61}
</style></head><body><main><a href="/">← Back to library</a><h1>Search library</h1>
<form action="/search" method="get" role="search"><label for="q">Search all library content</label><input id="q" name="q" type="search" maxlength="160" value="{{ query }}" required><button>Search</button></form>
{% if error %}<p role="alert">{{ error }}</p>{% elif query %}
<p>Results for “{{ query }}”</p>
{% if not groups %}<p>No published collections are available to search.</p>{% endif %}
{% for group in groups %}<section><h2>{{ group.name }}</h2>
{% if group.status == "unsupported" %}<p>Search is not yet supported for this collection.</p>
{% elif group.status == "unavailable" %}<p>Search is temporarily unavailable for this collection.</p>
{% else %}<p class="muted">{{ group.capability }} · Up to 20 results</p>
{% if group.results %}<ol>{% for result in group.results %}<li><a href="{{ result.href }}">{{ result.title }}</a>{% if result.snippet %}<p>{{ result.snippet }}</p>{% endif %}</li>{% endfor %}</ol>{% else %}<p>No matching results.</p>{% endif %}
{% endif %}</section>{% endfor %}{% endif %}
</main></body></html>