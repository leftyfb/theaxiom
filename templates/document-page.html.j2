<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ document.title }} · Offline Emergency Library</title>
  <style>
    :root { font-family: ui-sans-serif, system-ui, sans-serif; color:#17332b; background:#eef4f0; --green:#176b4d; --line:#d4e4db; }
    * { box-sizing:border-box; } body { margin:0; } a { color:var(--green); } a:focus-visible { outline:3px solid #f1b84b; outline-offset:3px; }
    header, main { width:min(100% - 2rem, 62rem); margin:auto; } header { padding:1rem 0; } header a { display:inline-flex; min-height:44px; align-items:center; font-weight:750; text-decoration:none; }
    main { padding:1rem 0 3rem; } .paper { padding:clamp(1.1rem,4vw,2.2rem); border:1px solid var(--line); border-radius:.9rem; background:#fff; box-shadow:0 8px 30px #17332b12; }
    .eyebrow { color:var(--green); font-size:.78rem; font-weight:800; letter-spacing:.1em; text-transform:uppercase; } h1 { margin:.25rem 0 .7rem; font-size:clamp(1.8rem,6vw,3rem); line-height:1.08; } .summary { color:#526b62; font-size:1.08rem; }
    .actions { display:flex; flex-wrap:wrap; gap:.65rem; margin:1.3rem 0; } .button { display:inline-flex; align-items:center; justify-content:center; min-height:44px; padding:.65rem .95rem; border:1px solid var(--green); border-radius:.55rem; font-weight:750; text-decoration:none; } .primary { color:#fff; background:var(--green); }
    .provenance { margin-top:1.5rem; padding:1rem; border-radius:.7rem; background:#edf5f1; } .provenance h2 { margin-top:0; } dl { display:grid; grid-template-columns:minmax(8rem, 12rem) 1fr; gap:.65rem 1rem; } dt { font-weight:750; } dd { margin:0; overflow-wrap:anywhere; } code { font-size:.78rem; }
    @media(max-width:560px){ dl{grid-template-columns:1fr;gap:.15rem} dd{margin-bottom:.65rem} }
    @media print { body{background:#fff} .actions, header{display:none}.paper{border:0;box-shadow:none;padding:0} }
  </style>
</head>
<body>
<header><a href="/">← Return to catalog</a></header>
<main><article class="paper">
  <p class="eyebrow">{{ document.category }} · Locally available</p>
  <h1>{{ document.title }}</h1>
  <p class="summary">{{ document.description }}</p>
  <div class="actions"><a class="button primary" href="{{ document.asset_route }}">View publisher PDF</a><a class="button" href="{{ document.download_route }}" download>Download PDF</a></div>
  <section class="provenance" aria-labelledby="provenance-title"><h2 id="provenance-title">Source and provenance</h2><dl>
    <dt>Publisher</dt><dd>{{ document.publisher }}</dd>
    <dt>Original source</dt><dd><a href="{{ document.source_url }}">{{ document.source_url }}</a></dd>
    <dt>Retrieved</dt><dd>{{ document.retrieved }}</dd>
    <dt>Original file</dt><dd>{{ document.original_filename }} ({{ document.format }})</dd>
    <dt>File size</dt><dd>{{ document.bytes }} bytes</dd>
    <dt>SHA-256</dt><dd><code>{{ document.sha256 }}</code></dd>
    <dt>Review status</dt><dd>{{ document.redistribution_status }}</dd>
  </dl></section>
</article></main>
</body>
</html>
