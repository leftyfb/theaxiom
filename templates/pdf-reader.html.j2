<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png">
<link rel="shortcut icon" href="/favicon.ico" sizes="any">
<meta name="application-name" content="The Axiom">
<title>{{ record.profile.title }} · The Axiom</title>

<style>
*{box-sizing:border-box}body{margin:0;font:16px system-ui,sans-serif;background:#e8ece9;color:#172a23}header{position:sticky;top:0;z-index:2;background:#fff;padding:10px;border-bottom:1px solid #bbc9c0}nav,.tools{display:flex;gap:8px;align-items:center;flex-wrap:wrap}nav a{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:6px 12px;border:1px solid #176b4d;border-radius:5px;font:600 14px/24px system-ui,sans-serif;color:#176b4d;background:#fff;text-decoration:none;white-space:nowrap}nav a.library-return{background:#18362d;color:#fff;margin-right:auto}nav a:focus-visible,button:focus-visible,input:focus-visible{outline:3px solid #c78912;outline-offset:2px}nav a.library-return:hover{background:#176b4d}h1{font-size:1rem;margin:6px 0}button,input,a{font:inherit}button,input{padding:7px;max-width:100%}#page{width:3.5em;text-align:center;min-height:44px;border:1px solid #bbc9c0;border-radius:5px;background:#fff;color:inherit}
#find{flex:1;min-width:90px;max-width:24em;min-height:44px;border:1px solid #bbc9c0;border-radius:5px;background:#fff;color:inherit}
.tools{gap:8px}.tool-group{display:flex;align-items:center;gap:3px;white-space:nowrap}.tool-icon{display:inline-flex;align-items:center;justify-content:center;flex:none;width:44px;height:44px;padding:8px;border:1px solid #c5d4cb;border-radius:5px;background:#fff;color:#176b4d;cursor:pointer;appearance:none;-webkit-appearance:none}.tool-icon svg{width:21px;height:21px}.tool-icon:disabled{opacity:.4;cursor:default}.tool-icon[aria-expanded="true"]{background:#e2efe8;color:#18362d}.tool-icon:not(:disabled):hover{background:#e2efe8}#total{font-size:.85rem;white-space:nowrap}#search-tools{display:flex;gap:4px;align-items:center;flex-wrap:wrap;margin-top:5px}#search-tools[hidden]{display:none}#search-tools #matches{flex-basis:100%;min-height:1em}#thumbs[hidden]{display:none}h1{overflow-wrap:anywhere}main{display:flex;align-items:flex-start;gap:12px;padding:12px}#thumbs{width:140px;flex:none;max-height:75vh;overflow:auto}#thumbs button{display:block;width:100%;margin-bottom:8px}#thumbs canvas{max-width:100%;height:auto}#document{flex:1;min-width:0;overflow:auto;text-align:center}#paper-frame{position:relative;width:max-content;margin:auto;isolation:isolate}
#paper{display:block;position:relative;z-index:0;background:white;box-shadow:0 2px 8px #0003;max-width:none}
#text-layer{position:absolute;inset:0;z-index:1;opacity:0;pointer-events:none;overflow:hidden;text-align:initial;line-height:1;text-size-adjust:none;-webkit-text-size-adjust:none;transform-origin:0 0;--min-font-size:1;--text-scale-factor:calc(var(--total-scale-factor)*var(--min-font-size));--min-font-size-inv:calc(1 / var(--min-font-size))}
#text-layer :is(span,br){color:transparent;position:absolute;white-space:pre;cursor:text;transform-origin:0 0}
#text-layer > :not(.markedContent),#text-layer .markedContent span:not(.markedContent){z-index:1;--font-height:0;--scale-x:1;--rotate:0deg;font-size:calc(var(--text-scale-factor)*var(--font-height));transform:rotate(var(--rotate)) scaleX(var(--scale-x)) scale(var(--min-font-size-inv))}
#text-layer .markedContent{display:contents}
#highlights{position:absolute;inset:0;z-index:2;pointer-events:none;overflow:hidden}#highlights span{position:absolute;background:#ffdf0070;scroll-margin-top:180px}#highlights .active-match{background:#ff910099;outline:1px solid #bc5200}#message{padding:8px}#matches{font-size:.85rem}#print-pages{display:none}@media(max-width:650px){main{padding:4px;gap:4px}#thumbs{width:90px}button,input{font-size:16px}header{padding:6px}.tools{gap:4px 8px}.tool-group{gap:2px}.tool-icon{width:44px;height:44px;padding:7px}#page{width:3em}h1{font-size:.95rem;margin:5px 0}nav a{padding:5px 8px;font-size:13px}#search-tools #matches{font-size:.8rem}}@media(max-width:650px){header{padding:5px 6px}header nav{gap:5px}header nav a{min-height:44px}header h1{font-size:.85rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin:3px 0}.tools{flex-wrap:nowrap;overflow-x:auto;overscroll-behavior-x:contain;scrollbar-width:thin;padding-bottom:3px;scroll-padding-inline:8px}.tools:focus-visible{outline:3px solid #c78912;outline-offset:-3px}.tool-group{flex:none}#search-tools{display:grid;grid-template-columns:minmax(0,1fr) repeat(3,44px);gap:4px;align-items:center}#search-tools #find{min-width:0;width:100%}#search-tools #matches{grid-column:1/-1}#search-tools .tool-icon{width:44px}#thumbs{width:84px}#document{min-width:0}#search-tools #find{font-size:16px}}@media(max-width:650px) and (orientation:landscape){header{position:relative}#thumbs{max-height:55vh}main{padding:4px}}@media print{header,main,#message{display:none!important}#print-pages{display:block}#print-pages canvas{display:block;max-width:100%;height:auto;break-after:page}body{background:white}}
</style>
</head>
<body data-document="{{ path }}">
<header>
<nav aria-label="Library navigation"><a class="library-return" href="/">← Back to library</a><a href="{{ path }}" download>Download PDF</a></nav>
<h1>{{ record.profile.title }}</h1>
<div class="tools" role="region" tabindex="0" aria-label="Scrollable PDF controls">
<div class="tool-group" role="group" aria-label="Page navigation">
<button type="button" class="tool-icon" id="toggle" aria-label="Thumbnails" title="Thumbnails" aria-expanded="false" aria-controls="thumbs"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 3v18M5.5 7h1M5.5 11h1M5.5 15h1"/></svg></button>
<button type="button" class="tool-icon" id="prev" aria-label="Previous page" title="Previous page"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m15 6-6 6 6 6"/></svg></button>
<input id="page" type="number" inputmode="numeric" min="1" value="1" aria-label="Page number"><span id="total"></span>
<button type="button" class="tool-icon" id="next" aria-label="Next page" title="Next page"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m9 6 6 6-6 6"/></svg></button>
</div>
<div class="tool-group" role="group" aria-label="Zoom">
<button type="button" class="tool-icon" id="out" aria-label="Zoom out" title="Zoom out"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14"/></svg></button>
<button type="button" class="tool-icon" id="fit" aria-label="Fit width" title="Fit width"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 5v14M21 5v14M6 12h12m-8-4-4 4 4 4m4-8 4 4-4 4"/></svg></button>
<button type="button" class="tool-icon" id="in" aria-label="Zoom in" title="Zoom in"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M12 5v14"/></svg></button>
</div>
<div class="tool-group" role="group" aria-label="Document tools">
<button type="button" class="tool-icon" id="search-toggle" aria-label="Search document" title="Search document" aria-expanded="false" aria-controls="search-tools"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></button>
<button type="button" class="tool-icon" id="print" aria-label="Print" title="Print"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 8V3h12v5M6 17H3V8h18v9h-3M6 14h12v7H6z"/></svg></button>
</div>
</div>
<div id="search-tools" role="group" aria-label="Search PDF" hidden>
<input id="find" type="search" placeholder="Search document" aria-label="Find in PDF">
<button type="button" class="tool-icon" id="find-prev" aria-label="Previous match" title="Previous match" disabled><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 15 6-6 6 6"/></svg></button>
<button type="button" class="tool-icon" id="find-next" aria-label="Next match" title="Next match" disabled><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 9 6 6 6-6"/></svg></button>
<button type="button" class="tool-icon" id="search-close" aria-label="Close search" title="Close search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="m6 6 12 12M18 6 6 18"/></svg></button>
<span id="matches" role="status" aria-live="polite"></span>
</div></header>
<div id="message" role="status">Loading offline PDF viewer…</div>
<main><aside id="thumbs" hidden aria-label="Page thumbnails"></aside><section id="document" aria-label="PDF page"><div id="paper-frame"><canvas id="paper" aria-label="Rendered PDF page"></canvas><div id="text-layer" class="textLayer" aria-hidden="true"></div><div id="highlights" aria-hidden="true"></div></div></section></main>
<div id="print-pages"></div>
<noscript>JavaScript is required for this viewer. Use the Download PDF link above.</noscript>
<script type="module" src="/api/pdf-reader.mjs"></script>
<script src="/api/update-notifications.js"></script></body></html>
