<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png">
<link rel="shortcut icon" href="/favicon.ico" sizes="any">
<meta name="application-name" content="The Axiom">
<title>The Axiom · Offline library</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#edf3ef;color:#18362d;font:16px/1.55 system-ui,sans-serif}
header{background:#fff;border-bottom:1px solid #d5e2db;padding:18px max(24px,calc((100% - 1100px)/2));display:flex;justify-content:space-between;align-items:center;gap:20px}header h1{font-size:1.25rem;margin:0}a{color:#176b4d}a:focus-visible{outline:3px solid #c38d32;outline-offset:4px}
main{max-width:1148px;padding:12px 24px;margin:auto}.eyebrow{letter-spacing:.13em;text-transform:uppercase;font-size:.74rem;font-weight:700;color:#536e61}.collection{margin-top:12px}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),350px));gap:24px}.card{display:flex;flex-direction:column;background:white;border:1px solid #cfdfd6;border-radius:16px;text-decoration:none;color:inherit;overflow:hidden;box-shadow:0 4px 14px #18362d0b}.card:hover{border-color:#176b4d;box-shadow:0 5px 20px #18362d18}.card{flex-direction:row;align-items:flex-start;padding:16px;gap:12px}.art{width:56px;height:56px;flex:0 0 56px;display:grid;place-items:center;background:#dbe9e0;border-radius:8px;font-size:20px;font-weight:800}.art img{width:100%;height:100%;object-fit:contain}.body{min-width:0;overflow-wrap:anywhere;flex:1;display:flex;flex-direction:column}.body h3{margin:7px 0;font-size:1.45rem}.body p{color:#536e61;margin:0 0 20px}.action{margin-top:auto;color:#176b4d;font-weight:700;border-top:1px solid #dce7df;padding-top:14px}.empty{padding:24px;background:white;border:1px solid #cfdfd6;border-radius:12px}footer{margin-top:48px;color:#536e61;font-size:.85rem}

/* Compact list presentation on narrow screens; retain the desktop grid. */
.help{max-width:720px;background:white;border:1px solid #cfdfd6;border-radius:12px;padding:24px;overflow-wrap:anywhere}
@media(max-width:767px){
header{padding:12px 16px;gap:12px;flex-wrap:wrap}header a{display:inline-flex;align-items:center;min-height:44px}
main{padding:8px 16px}
.collection{margin-top:8px}.grid{grid-template-columns:minmax(0,1fr);gap:10px}
.card{flex-direction:row;align-items:center;padding:12px;gap:12px;border-radius:10px}
.art{width:56px;height:56px;flex:0 0 56px;border-radius:8px}
.body{padding:0;min-width:0;overflow-wrap:anywhere}.body .eyebrow{font-size:.68rem;letter-spacing:.06em}
.body h3{font-size:1.1rem;line-height:1.25;margin:3px 0;color:#176b4d}.body p{font-size:.9rem;line-height:1.4;margin:0}
.action{border:0;padding:0;margin:5px 0 0;font-size:.78rem}.help{padding:16px}footer{margin-top:24px}
}
.search-form{display:flex;flex-wrap:wrap;gap:8px;max-width:720px;margin:20px 0}.search-form label{width:100%;font-weight:650}.search-form input{flex:1;min-width:0;padding:12px;font:inherit;border:1px solid #aac5b7;border-radius:8px}.search-form button{font:inherit;font-weight:700;background:#176b4d;color:white;border:0;border-radius:8px;padding:10px 16px;min-height:44px;cursor:pointer}
 .filter-form{display:flex;gap:10px;flex-wrap:wrap;align-items:end;margin:12px 0}.filter-label{display:flex;flex-direction:column;gap:4px;flex:1;min-width:130px}.filter-label select{font:inherit;padding:10px;border:1px solid #aac5b7;border-radius:8px;background:white}.filter-form button{font:inherit;padding:10px;min-height:44px}.memberships{font-size:.8rem;color:#536e61}
.library-tools{display:grid;grid-template-columns:1fr auto;align-items:start}
.library-tools>a,.library-search summary{display:inline-flex;align-items:center;min-height:44px}
.library-tools>a{grid-area:1/1;justify-self:start}
.library-search{grid-area:1/1/2/3;pointer-events:none}
.library-search summary{width:44px;justify-content:center;margin-left:auto;list-style:none;display:flex;color:#176b4d;cursor:pointer;pointer-events:auto}
.library-search summary::-webkit-details-marker{display:none}
.library-search summary:focus-visible{outline:3px solid #c38d32;outline-offset:-3px}
.library-search .search-form{margin:4px 0 8px;pointer-events:auto}
.search-icon{position:relative;width:15px;height:15px;border:2px solid currentColor;border-radius:50%;margin:-3px 3px 0 0}
.search-icon::after{content:"";position:absolute;width:8px;height:2px;background:currentColor;left:9px;top:11px;transform:rotate(45deg);transform-origin:left}
</style></head><body><header><h1>The Axiom</h1><a href="/admin">Administration</a></header>
<main>
<div class="library-tools">
  <a href="#getting-started">Getting Started</a>
  <details class="library-search">
    <summary aria-label="Search library" title="Search library"><span class="search-icon" aria-hidden="true"></span></summary>
    <form class="search-form" action="/search" method="get" role="search"><label for="library-search">Search all library content</label><input type="search" id="library-search" name="q" maxlength="160" placeholder="Search articles, guides and more" required>{% for key,value in (selected|default({})).items() %}<input type="hidden" name="{{ key }}" value="{{ value }}">{% endfor %}<button type="submit">Search</button></form>
  </details>
</div>
<section class="collection" id="collection-title" aria-label="Library sources">
{% if filter_groups|default([]) or selected|default({}) %}<form class="filter-form" action="/" method="get">{% for kind, plural, label in [("category","categories","Category"),("collection","collections","Collection"),("tag","tags","Tag")] %}{% set options = filter_groups|default([])|selectattr("kind","equalto",plural)|list %}{% if options or (selected|default({})).get(kind) %}<label class="filter-label">{{ label }}<select name="{{ kind }}"><option value="">All</option>{% for group in options %}<option value="{{ group.group_id }}"{% if (selected|default({})).get(kind) == group.group_id %} selected{% endif %}>{{ group.name }}</option>{% endfor %}{% if (selected|default({})).get(kind) and (selected|default({})).get(kind) not in options|map(attribute="group_id")|list %}<option selected value="{{ selected[kind] }}">Unavailable group</option>{% endif %}</select></label>{% endif %}{% endfor %}<button type="submit">Filter</button><a href="/">Clear filters</a></form>{% endif %}
{% if error %}<p role="alert">{{ error }}</p>{% endif %}
{% if sources %}{% for section, cards in (sections|default({none: sources})).items() %}
{% if section %}<h2>{{ section[1] }}</h2>{% elif sections|default({})|length > 1 %}<h2>Other sources</h2>{% endif %}
<div class="grid">{% for source in cards %}
<a class="card" href="{{ source.entry_path }}"><span class="art">{% from 'source-icon.html.j2' import source_icon %}{{ source_icon(source.name, source.icon_png|default(''), source.source_id|default('')) }}</span><div class="body"><span class="eyebrow">{{ source.category }} · {{ source.language }}</span><h3>{{ source.name }}</h3><p>{{ source.description }}</p>{% if source.memberships %}<p class="memberships">{{ source.memberships|join(" · ") }}</p>{% endif %}<span class="action">{{ "Open PDF" if source.category == "PDF" else "Open EPUB" if source.category == "EPUB" else "Explore collection" }} →</span></div></a>
{% endfor %}</div>{% endfor %}{% else %}<div class="empty">{% if selected|default({}) %}No published sources match these filters.{% else %}No collections are currently available. Published collections will appear here when their readers are ready.{% endif %}</div>{% endif %}</section>
<section class="collection help" id="getting-started" aria-labelledby="help-title" tabindex="-1"><h2 id="help-title">Getting Started</h2><p>This library stores reference material on your local network so you can read it without an internet connection.</p><h3>Explore collections</h3><p>Choose a collection above to open its reader. Use its library navigation to return here. Search within a collection when its reader supports search.</p><h3>What if the library is empty?</h3><p>Collections appear when their content has been downloaded, verified and made available by the library administrator. Reading installed collections does not require internet access; acquiring new content generally does.</p><p><a href="#collection-title">Return to collections</a></p></section>
<footer>The Axiom · Offline reference library</footer></main></body></html>
