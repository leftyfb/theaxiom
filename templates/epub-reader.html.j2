<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png">
<link rel="shortcut icon" href="/favicon.ico" sizes="any">
<meta name="application-name" content="The Axiom">
<title>{{ record.profile.title }} · The Axiom</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#f4f7f4;color:#20342c;font:1rem system-ui,sans-serif}header{background:#18362d;color:white;padding:14px 20px;display:flex;flex-wrap:wrap;gap:16px;align-items:center}header a{color:white}main{max-width:900px;margin:auto;padding:20px}h1{overflow-wrap:anywhere}nav{display:flex;flex-wrap:wrap;gap:10px;align-items:center;margin:12px 0}nav a,.button{display:inline-block;padding:9px 12px;border:1px solid #acc3b5;border-radius:8px;background:white;color:#176b4d;text-decoration:none}nav a[aria-current]{background:#176b4d;color:white}article.book{background:white;padding:clamp(16px,4vw,40px);border:1px solid #cfdfd6;border-radius:12px;font-family:Georgia,serif;line-height:1.7;overflow-wrap:anywhere;overflow-x:auto}article.small{font-size:1rem}article.medium{font-size:1.2rem}article.large{font-size:1.5rem}article.book img{display:block;max-width:100%;height:auto;margin:1em auto}pre{white-space:pre-wrap}table{border-collapse:collapse}td,th{border:1px solid #ccc;padding:6px}details{margin:14px 0}summary{cursor:pointer;font-weight:bold}li{margin:5px 0}a:focus-visible{outline:3px solid #cc7c00}
</style></head><body>
<header><a href="/">← Library</a><strong>The Axiom · EPUB reader</strong></header>
<main><h1>{{ record.profile.title }}</h1>{% if record.profile.author %}<p>{{ record.profile.author }}</p>{% endif %}
<nav aria-label="Reading controls"><a href="{{ base }}/document.epub" download>Download EPUB</a><span>Text size:</span>{% for option in ('small','medium','large') %}<a href="{{ base }}/chapter/{{ chapter }}?size={{ option }}"{% if size == option %} aria-current="true"{% endif %}>{{ option|capitalize }}</a>{% endfor %}</nav>
<details><summary>Table of contents</summary><ol>{% for label in labels %}<li><a href="{{ base }}/chapter/{{ loop.index0 }}?size={{ size }}"{% if loop.index0 == chapter %} aria-current="page"{% endif %}>{{ label }}</a></li>{% endfor %}</ol></details>
<nav aria-label="Chapter navigation">{% if chapter > 0 %}<a href="{{ base }}/chapter/{{ chapter-1 }}?size={{ size }}" data-chapter-nav="previous">← Previous</a>{% endif %}<span>Chapter {{ chapter+1 }} of {{ labels|length }}</span>{% if chapter+1 < labels|length %}<a href="{{ base }}/chapter/{{ chapter+1 }}?size={{ size }}" data-chapter-nav="next">Next →</a>{% endif %}</nav>
<article class="book {{ size }}">{{ content|safe }}</article>
<nav aria-label="Continue reading">{% if chapter > 0 %}<a href="{{ base }}/chapter/{{ chapter-1 }}?size={{ size }}" data-chapter-nav="previous">← Previous</a>{% endif %}{% if chapter+1 < labels|length %}<a href="{{ base }}/chapter/{{ chapter+1 }}?size={{ size }}" data-chapter-nav="next">Next →</a>{% endif %}<a href="/">Return to library</a></nav>
</main><script>
// Chapter shortcuts apply only while reading, never while editing or using shortcuts.
document.addEventListener('keydown', (event) => {
  if (event.defaultPrevented || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey || event.repeat) return;
  if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
  const target = event.target;
  if (target instanceof Element && (target.closest('input, textarea, select, button, [contenteditable], [role="textbox"], [role="combobox"]') || target.isContentEditable)) return;
  const direction = event.key === 'ArrowLeft' ? 'previous' : 'next';
  const link = document.querySelector('nav[aria-label="Chapter navigation"] a[data-chapter-nav="' + direction + '"]');
  if (!link) return;
  event.preventDefault();
  window.location.assign(link.href);
});
</script>
</body></html>
