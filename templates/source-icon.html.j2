{% macro source_icon(title, icon_png, source_id="") -%}
{% set builtins = {
  "fema-ready": "",
  "cdc": "",
  "food-reference": "",
  "hesperian": "iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAYAAAAf8/9hAAAAe0lEQVR42tWTQQrAIAwEJ+JjfINX3+3VN/ib9FBbRKy2lh4aCBEhy+4mEVUFIAW3PwAfs6TgGIWPGQDTNj8NU6qUXAbgLYNTU6vzSKAr085Mav3xMVMbPJTQMVfbPzsZlQzAnplYg91iMFukFQYf78F/AaR3zp2T1quxbuxRNLqRYIWvAAAAAElFTkSuQmCC",
  "ifixit": "",
  "internet-archive": "",
  "openstax": "",
  "openstreetmap": "",
  "practical-action": "",
  "red-cross": "",
  "usda-extension": "",
  "usda-preservation": "",
  "wikibooks": "",
  "wikimedia-commons": "",
  "wikipedia-en": "",
  "wikiquote": "",
  "wikisource": "",
  "wikiversity": "",
  "wikivoyage": "",
  "wiktionary": "",
} %}
{% set symbols = {
  "epa-water": "💧", "cdc": "🧼", "noaa": "🌦️",
  "amateur-radio": "📻", "openstreetmap": "🗺️", "gutenberg": "📚",
  "internet-archive": "🏛️", "linux-docs": "🐧", "ifixit": "🔧",
  "hesperian": "🩺", "red-cross": "🩹", "standard-ebooks": "📖",
  "usda-preservation": "🫙", "usda-extension": "🌱", "food-reference": "🍎",
  "kolibri": "🎓", "openstax": "📘", "stack-exchange": "💬", "practical-action": "⚙️"
} %}
{% set subjects = [
  ("fallout shelter", "🏠"), ("survival kit checklist", "📋"),
  ("phonetic alphabet", "🔤"), ("railroad signals", "🚦"),
  ("edibility test", "🌿"), ("crocheting", "🧶"), ("guia de preparacion", "🎒"),
  ("wikipedia", "🌐")
] %}
{% set match = namespace(symbol="") %}
{% for keyword, symbol in subjects if keyword in title|lower %}
  {% set match.symbol = symbol %}
{% endfor %}
{% set icon_png = icon_png or builtins.get(source_id) or (builtins.get("wikipedia-en") if match.symbol == "🌐" else "") %}
{% if icon_png %}<img src="data:image/png;base64,{{ icon_png }}" alt="">
{% else %}<span aria-hidden="true">{{ symbols.get(source_id) or match.symbol or title.split()[:2]|map('first')|join|upper or '·' }}</span>{% endif %}
{%- endmacro %}
